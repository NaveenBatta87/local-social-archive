<Application x:Class="LocalSocialArchive.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LocalSocialArchive.Converters">
    <Application.Resources>
        <!-- Global Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:FileSizeFormatterConverter x:Key="FileSizeFormatter"/>
        <converters:BoolToLockToggleTextConverter x:Key="BoolToLockToggleTextConverter"/>

        <!-- Global Dark Theme Color Palette -->
        <SolidColorBrush x:Key="AppBgBrush" Color="#0C1017"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2F3336"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#3F464E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1D9BF0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7E9EA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>

        <!-- Default UI Font Family (system fonts for icons and chrome) -->
        <FontFamily x:Key="DefaultAppFontFamily">Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif</FontFamily>

        <!-- Twemoji Font Family for tweet/post content text rendering -->
        <FontFamily x:Key="TweetContentFontFamily">pack://application:,,,/Resources/Fonts/#Twemoji Mozilla, Segoe UI Variable Text, Segoe UI Emoji, Segoe UI, sans-serif</FontFamily>

        <!-- Universal Dark ComboBox Item Style -->
        <Style x:Key="UniversalDarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#212836"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A3B5C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Universal Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="UniversalDarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="⌵" FontSize="11" Foreground="#8B949E"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#1D9BF0"/>
                    <Setter TargetName="border" Property="Background" Value="#1C232E"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Universal Dark ComboBox Style -->
        <Style x:Key="UniversalDarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource UniversalDarkComboBoxItem}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource UniversalDarkComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="true"
                                   Focusable="false"
                                   PopupAnimation="Slide">
                                <Border Background="#161B22"
                                        BorderBrush="#2F3336"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer CanContentScroll="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default ComboBox Target Type Style -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource UniversalDarkComboBoxStyle}"/>
    </Application.Resources>
</Application>
