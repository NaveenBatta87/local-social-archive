<UserControl x:Class="LocalSocialArchive.Views.StoryCardCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:models="clr-namespace:LocalSocialArchive.Models"
             mc:Ignorable="d" 
             Width="1080" Height="1920"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             RenderOptions.BitmapScalingMode="HighQuality">

    <!-- 1080 x 1920 Canvas Root Container with Dynamic Story Theme -->
    <Border x:Name="CanvasRoot" Width="1080" Height="1920" ClipToBounds="True" Background="{Binding Theme.BackgroundHex, Converter={StaticResource HexToBrush}}">
        <Grid Margin="75,120,75,150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 1. Story Header & Author Profile -->
                <RowDefinition Height="*"/>    <!-- 2. Story Tweet Content Stream -->
                <RowDefinition Height="Auto"/> <!-- 3. Story Footer & Brand Watermark -->
            </Grid.RowDefinitions>

            <!-- ================= 1. STORY HEADER ================= -->
            <Border Grid.Row="0" Margin="0,0,0,36" Padding="0,0,0,24" BorderBrush="{Binding Theme.BorderHex, Converter={StaticResource HexToBrush}}" BorderThickness="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Author Avatar Circle -->
                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="44"
                            Background="{Binding Theme.CardBackgroundHex, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"
                            BorderThickness="3" Margin="0,0,22,0">
                        <TextBlock Text="{Binding AvatarInitial}" FontSize="38" FontWeight="Bold"
                                   Foreground="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>

                    <!-- Author Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AuthorName}" FontSize="32" FontWeight="Bold"
                                       Foreground="{Binding Theme.ForegroundHex, Converter={StaticResource HexToBrush}}"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="✓" FontSize="26" FontWeight="Bold"
                                       Foreground="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding AuthorHandle}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{Binding Theme.SecondaryForegroundHex, Converter={StaticResource HexToBrush}}"
                                       Margin="0,0,16,0"/>
                            <TextBlock Text="•" FontSize="20"
                                       Foreground="{Binding Theme.SecondaryForegroundHex, Converter={StaticResource HexToBrush}}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PostDateText}" FontSize="22"
                                       Foreground="{Binding Theme.SecondaryForegroundHex, Converter={StaticResource HexToBrush}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Story Card Sequence Badge (e.g. "1 / 3") -->
                    <Border Grid.Column="2" CornerRadius="22" Padding="20,10" VerticalAlignment="Center"
                            Background="{Binding Theme.CardBackgroundHex, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"
                            BorderThickness="2">
                        <TextBlock Text="{Binding CardIndexBadge}" FontSize="26" FontWeight="Bold"
                                   Foreground="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= 2. CONTENT STREAM ================= -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StoryItem}">
                        <Border Margin="0,0,0,28" CornerRadius="22" Padding="36,32"
                                Background="{Binding DataContext.Theme.CardBackgroundHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{Binding DataContext.Theme.BorderHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                BorderThickness="2">
                            <StackPanel>
                                <!-- Tweet Index Badge Row -->
                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="14,4" Margin="0,0,0,18"
                                        Background="{Binding DataContext.Theme.BackgroundHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                        BorderBrush="{Binding DataContext.Theme.AccentHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                        BorderThickness="1.5">
                                    <TextBlock Text="{Binding SegmentIndex, StringFormat='Part {0}'}" FontSize="20" FontWeight="Bold"
                                               Foreground="{Binding DataContext.Theme.AccentHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"/>
                                </Border>

                                <!-- Tweet Content Text with Full-Color Unicode/Emoji Support -->
                                <emoji:TextBlock Text="{Binding Content}"
                                                 FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Foreground="{Binding DataContext.Theme.ForegroundHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                                 TextWrapping="Wrap"
                                                 LineHeight="52"
                                                 Margin="0,0,0,8"/>

                                <!-- Attached Image (Optional) -->
                                <Border Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="16" ClipToBounds="True" Margin="0,18,0,4"
                                        BorderBrush="{Binding DataContext.Theme.BorderHex, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource HexToBrush}}"
                                        BorderThickness="1" MaxHeight="520">
                                    <Image Source="{Binding MediaPath, Converter={StaticResource ThumbImageConverter}, ConverterParameter=1080}"
                                           Stretch="Uniform" MaxHeight="520"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= 3. STORY FOOTER & WATERMARK ================= -->
            <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,16,0,0" BorderBrush="{Binding Theme.BorderHex, Converter={StaticResource HexToBrush}}" BorderThickness="0,1.5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ " FontSize="22" Foreground="{Binding Theme.AccentHex, Converter={StaticResource HexToBrush}}"/>
                        <TextBlock Text="Local Social Archive" FontSize="22" FontWeight="Bold"
                                   Foreground="{Binding Theme.ForegroundHex, Converter={StaticResource HexToBrush}}" Margin="0,0,10,0"/>
                        <TextBlock Text="• Offline Private Archive" FontSize="20"
                                   Foreground="{Binding Theme.SecondaryForegroundHex, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding CardIndexBadge, StringFormat='Story {0}'}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding Theme.SecondaryForegroundHex, Converter={StaticResource HexToBrush}}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
