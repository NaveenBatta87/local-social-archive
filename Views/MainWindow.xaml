                                                        <DataTrigger Binding="{Binding ActiveRailView}" Value="Tags">
                                                            <Setter Property="Foreground" Value="#4CC2FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
