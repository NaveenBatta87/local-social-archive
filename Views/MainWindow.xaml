                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Icon -->
                                        <TextBlock Grid.Column="1" Text="&#xEA84;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
