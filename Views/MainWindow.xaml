                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="&#xEAF8;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" Foreground="#8D96A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Settings" FontSize="13.5" Foreground="#C8D1DC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- Database status indicator pill -->
                                <Border Margin="4,8,4,2" Padding="8,4" Background="#161B23" CornerRadius="6" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatabaseSizeText}" FontSize="11" Foreground="#8D96A6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= CENTER MAIN STAGE (POSTS FEED OR FOLDERS HUB) ================= -->
                <Border Grid.Column="1" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,1,0">
                    <Grid>
                        <!-- ================================================================= -->
                        <!-- VIEW 1: WINDOWS 11 HOME DASHBOARD (FLUENT CARDS & HERO BANNER) === -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeDashboardActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,32">
                                <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">
                                    <!-- Page Header -->
                                    <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,20"/>

                                    <!-- Top Hero Card (Inspired by Device Card in Windows 11 Settings) -->
                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,18" Margin="0,0,0,20">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Glowing Vault Icon Badge -->
                                            <Border Grid.Column="0" Width="82" Height="62" CornerRadius="8" Background="#161B24" BorderBrush="#2A3546" BorderThickness="1" Margin="0,0,18,0">
                                                <Grid>
                                                    <Border Width="50" Height="38" CornerRadius="6" Background="#1A3B5C" Opacity="0.6"/>
                                                    <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <!-- Vault Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Local Social Archive" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Posts.Count, StringFormat='Microsoft ESE Engine • {0:N0} Archived Posts'}" FontSize="12.5" Foreground="#9DA5B4" Margin="0,3,0,6"/>
                                                <Button Command="{Binding NavigateFeedCommand}" Content="Browse Full Timeline Feed →" Background="Transparent" Foreground="#60CDFF" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="0"/>
                                            </StackPanel>

                                            <!-- Status Badges (Right side) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Offline Engine Status Badge -->
                                                <Border Background="#162320" BorderBrush="#1C4436" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0"/>
                                                        <TextBlock Text="Offline Engine: Active" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sync Status Badge -->
                                                <Border Background="#1A2736" BorderBrush="#243C54" BorderThickness="1" CornerRadius="16" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEA77;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#60CDFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Sync: Ready" FontSize="11.5" FontWeight="SemiBold" Foreground="#60CDFF"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Two-Column Fluent Card Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT COLUMN -->
                                        <StackPanel Grid.Column="0">
                                            <!-- Card 1: Quick Capture (Matching Fluent Concept Mockup) -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,16">
                                                        <TextBlock Text="Quick Capture" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <TextBlock Text="•••" FontSize="14" Foreground="#8D96A6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>

                                                    <!-- 4 Social Platform Tiles -->
                                                    <UniformGrid Columns="4" Margin="0,0,0,18">
                                                        <!-- 1. X / Twitter -->
                                                        <Border Background="Transparent" Cursor="Hand" HorizontalAlignment="Center">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="52" Height="52" CornerRadius="10" Background="#161B23" BorderBrush="#2C3444" BorderThickness="1">
                                                                    <TextBlock Text="𝕏" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="X" FontSize="11.5" Foreground="#8D96A6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 2. Threads -->
                                                        <Border Background="Transparent" Cursor="Hand" HorizontalAlignment="Center">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="52" Height="52" CornerRadius="10" Background="#161B23" BorderBrush="#2C3444" BorderThickness="1">
                                                                    <TextBlock Text="@" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Threads" FontSize="11.5" Foreground="#8D96A6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 3. Bluesky -->
                                                        <Border Background="Transparent" Cursor="Hand" HorizontalAlignment="Center">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="52" Height="52" CornerRadius="10" Background="#1185FE" BorderBrush="#38BDF8" BorderThickness="1">
                                                                    <TextBlock Text="🦋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Bluesky" FontSize="11.5" Foreground="#8D96A6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 4. Clipboard -->
                                                        <Border Background="Transparent" Cursor="Hand" HorizontalAlignment="Center">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border Width="52" Height="52" CornerRadius="10" Background="#161B23" BorderBrush="#2C3444" BorderThickness="1">
                                                                    <TextBlock Text="&#xEAC2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="Clipboard" FontSize="11.5" Foreground="#8D96A6" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </UniformGrid>

                                                    <!-- Dual Action Buttons: Quick Paste & Create Post -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Paste from Clipboard -->
                                                        <Button Grid.Column="0" Command="{Binding PasteFromClipboardCommand}" Height="40" Background="#232731" BorderBrush="#333946" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xEAC2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Paste" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Create Post Button -->
                                                        <Button Grid.Column="2" Command="{Binding CreateNewPostCommand}" Height="40" Background="#38BDF8" Foreground="#041224" BorderThickness="0" FontWeight="Bold" FontSize="12.5" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Create Post" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: Active Collections (2x2 Grid Matching Fluent Concept Mockup) -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <TextBlock Text="Active Collections" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Command="{Binding ShowFoldersHubCommand}" Content="View All →" Background="Transparent" Foreground="#60CDFF" FontSize="11.5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                                                            <TextBlock Text="•••" FontSize="14" Foreground="#8D96A6" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- 2x2 Grid of Folder Tiles -->
                                                    <ItemsControl ItemsSource="{Binding TopDashboardFolders}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#161B23" BorderBrush="#282F3C" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="4,4" Cursor="Hand">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                    </Border.InputBindings>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="28"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="📁" FontSize="16" VerticalAlignment="Center"/>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Text="{Binding Count, StringFormat='{}{0} posts'}" FontSize="11.5" Foreground="#8D96A6" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- RIGHT COLUMN -->
                                        <StackPanel Grid.Column="2">
                                            <!-- Card 3: Quick Access (Inspired by Recommended Settings Card) -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                                                <StackPanel>
                                                    <TextBlock Text="Quick Access" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Recent and commonly used archive sections" FontSize="12" Foreground="#9DA5B4" Margin="0,3,0,14"/>

                                                    <!-- Row 1: Browse Feed -->
                                                    <Border Background="#191D26" BorderBrush="#282F3C" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateFeedCommand}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="&#xEB18;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="15" Foreground="#60CDFF" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock Text="Browse Timeline Feed" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="View full chronological posts in list or card mode" FontSize="11" Foreground="#9DA5B4"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Row 2: Collections Hub -->
                                                    <Border Background="#191D26" BorderBrush="#282F3C" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding ShowFoldersHubCommand}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="&#xEA83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock Text="Collections Hub" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="Visual grid of collections and organized folders" FontSize="11" Foreground="#9DA5B4"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Row 3: Settings & Diagnostics -->
                                                    <Border Background="#191D26" BorderBrush="#282F3C" BorderThickness="1" CornerRadius="6" Padding="14,12" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="&#xEAF8;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="15" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                <TextBlock Text="Archive Settings &amp; Diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                                <TextBlock Text="Database compaction, vault security, and preferences" FontSize="11" Foreground="#9DA5B4"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 4: Personalize Workspace (Inspired by Personalize Your Device Card) -->
                                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                                <StackPanel>
                                                    <TextBlock Text="Personalize Workspace" FontSize="15.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Customize appearance &amp; layout options" FontSize="12" Foreground="#9DA5B4" Margin="0,3,0,14"/>

                                                    <!-- Theme Presets Grid (6 Tiles matching screenshot) -->
                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="50"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="50"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Tile 1: Windows Dark -->
                                                        <Border Grid.Row="0" Grid.Column="0" CornerRadius="6" Background="#232834" Cursor="Hand" ToolTip="Windows Dark">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="Windows Dark">
                                                                            <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Windows Dark"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#4CC2FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#4CC2FF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Windows Dark">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Tile 2: Deep Slate -->
                                                        <Border Grid.Row="0" Grid.Column="2" CornerRadius="6" Background="#161B22" Cursor="Hand" ToolTip="Deep Slate">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="Deep Slate">
                                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Deep Slate"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#1D9BF0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#1D9BF0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Deep Slate">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Tile 3: OLED Black -->
                                                        <Border Grid.Row="0" Grid.Column="4" CornerRadius="6" Background="#0C0D0E" Cursor="Hand" ToolTip="OLED Black">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="OLED Black">
                                                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="OLED Black"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="OLED Black">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Tile 4: Azure Glow -->
                                                        <Border Grid.Row="2" Grid.Column="0" CornerRadius="6" Background="#112233" Cursor="Hand" ToolTip="Azure Glow">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="Azure Glow">
                                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Azure Glow"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Azure Glow">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Tile 5: Emerald Forest -->
                                                        <Border Grid.Row="2" Grid.Column="2" CornerRadius="6" Background="#10251E" Cursor="Hand" ToolTip="Emerald Forest">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="Emerald Forest">
                                                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Emerald Forest"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#10B981" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Emerald Forest">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Tile 6: Amethyst Violet -->
                                                        <Border Grid.Row="2" Grid.Column="4" CornerRadius="6" Background="#22182D" Cursor="Hand" ToolTip="Amethyst Violet">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#282F3C"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedThemeName}" Value="Amethyst Violet">
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                            <Setter Property="BorderThickness" Value="2"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding SetThemeCommand}" CommandParameter="Amethyst Violet"/>
                                                            </Border.InputBindings>
                                                            <Grid>
                                                                <Border Width="12" Height="12" CornerRadius="2" Background="#A855F7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"/>
                                                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#A855F7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,3,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding SelectedThemeName}" Value="Amethyst Violet">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>

                                                    <!-- View Mode Switcher -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Feed Display Mode" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#161B24" BorderBrush="#2B3342" BorderThickness="1" CornerRadius="6" Padding="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Command="{Binding SetListViewCommand}" Padding="10,4" BorderThickness="0" Cursor="Hand">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                                                    <Setter Property="Background" Value="#252F3E"/>
                                                                                    <Setter Property="Foreground" Value="#60CDFF"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="☰ List" FontSize="11.5" FontWeight="SemiBold"/>
                                                                </Button>
                                                                <Button Command="{Binding SetGridViewCommand}" Padding="10,4" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                                                    <Setter Property="Background" Value="#252F3E"/>
                                                                                    <Setter Property="Foreground" Value="#60CDFF"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="⊞ Grid" FontSize="11.5" FontWeight="SemiBold"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW A: REGULAR POSTS FEED (List View / Grid View) =============== -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHomeDashboardActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Feed Toolbar (Title, View Switcher, Inspector Toggle) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Multi-Selection Bulk Action Bar -->
                                <RowDefinition Height="*"/>
                                <!-- Feed Items (List or Grid View) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- FEED TOOLBAR / VIEW MODE SWITCHER & INSPECTOR TOGGLE (Spacious) -->
                            <Border Grid.Row="0" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="22,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active Filter & Count -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedFolder.Name, FallbackValue='All Posts'}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Border Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='{}{0} archived posts'}" FontSize="12" FontWeight="SemiBold" Foreground="#9DA5B4" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Quick-Filter Chips Row (All, Threads, Media, Notes) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <!-- All Chip -->
                                            <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="All" Cursor="Hand" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" CornerRadius="12" Padding="10,4" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="All" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuickFilterAllCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickFilterAll}" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#1A2D42"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#4CC2FF"/>
                                                                <Setter Property="Foreground" Value="#60CDFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuickFilterAll}" Value="False">
                                                                <Setter TargetName="chip" Property="Background" Value="#202530"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="Foreground" Value="#9DA5B4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#4CC2FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Threads Chip -->
                                            <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Threads" Cursor="Hand" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" CornerRadius="12" Padding="10,4" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🧵 Threads" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuickFilterThreadsCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickFilterThreads}" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#1A2D42"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#38BDF8"/>
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuickFilterThreads}" Value="False">
                                                                <Setter TargetName="chip" Property="Background" Value="#202530"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="Foreground" Value="#9DA5B4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Media Chip -->
                                            <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Media" Cursor="Hand" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" CornerRadius="12" Padding="10,4" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📷 Media" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuickFilterMediaCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickFilterMedia}" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#1A2D42"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#10B981"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuickFilterMedia}" Value="False">
                                                                <Setter TargetName="chip" Property="Background" Value="#202530"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="Foreground" Value="#9DA5B4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#10B981"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Notes Chip -->
                                            <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Notes" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" CornerRadius="12" Padding="10,4" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📝 Notes" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuickFilterNotesCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickFilterNotes}" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#1A2D42"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#F59E0B"/>
                                                                <Setter Property="Foreground" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuickFilterNotes}" Value="False">
                                                                <Setter TargetName="chip" Property="Background" Value="#202530"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="Foreground" Value="#9DA5B4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#F59E0B"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Comments Chip -->
                                            <Button Command="{Binding SetQuickFilterCommand}" CommandParameter="Comments" Cursor="Hand" Margin="6,0,0,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="chip" CornerRadius="12" Padding="10,4" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="💬 Comments" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding QuickFilterCommentsCount, StringFormat=' ({0})'}" FontSize="10.5" Opacity="0.8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickFilterComments}" Value="True">
                                                                <Setter TargetName="chip" Property="Background" Value="#1A2D42"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#38BDF8"/>
                                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsQuickFilterComments}" Value="False">
                                                                <Setter TargetName="chip" Property="Background" Value="#202530"/>
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="Foreground" Value="#9DA5B4"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="chip" Property="BorderBrush" Value="#38BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <!-- Matching Folders Jump Row (Visible when search matches folders) -->
                                        <ItemsControl ItemsSource="{Binding MatchedFolders}" Visibility="{Binding HasMatchedFolders, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" Margin="0,0,6,4" Background="#1A2D42" BorderBrush="#4CC2FF" BorderThickness="1" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" FontSize="10.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Right Actions: [ ☰ List | ⊞ Grid ], and [ ◨ Inspector ] -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- View Mode Switcher [ ☰ List | ⊞ Grid ] -->
                                        <Border Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- List View Button -->
                                                <Button Command="{Binding SetListViewCommand}" ToolTip="List View (Full Timeline)" Padding="14,6" BorderThickness="0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                                    <Setter Property="Background" Value="#1A2D42"/>
                                                                    <Setter Property="Foreground" Value="#4CC2FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEB17;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="List" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Grid View Button -->
                                                <Button Command="{Binding SetGridViewCommand}" ToolTip="Grid View (Tile Cards)" Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                                    <Setter Property="Background" Value="#1A2D42"/>
                                                                    <Setter Property="Foreground" Value="#4CC2FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEBEB;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Grid" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- File Pilot Style Grid Column Resizer Bar -->
                                        <Border Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="6,3" Margin="0,0,10,0" ToolTip="Adjust Grid Columns / Card Size (Ctrl + / -)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- More Columns (Zoom Out) -->
                                                <Button Command="{Binding ZoomOutGridCommand}" ToolTip="More Columns (Smaller Cards)" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,3">
                                                    <TextBlock Text="&#xEBEB;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Resizer Slider Bar -->
                                                <Slider Minimum="180" Maximum="520" Value="{Binding GridCardWidth, Mode=TwoWay}" Width="85" VerticalAlignment="Center" Margin="5,0" Cursor="Hand" SmallChange="20" LargeChange="50">
                                                    <Slider.Template>
                                                        <ControlTemplate TargetType="Slider">
                                                            <Grid VerticalAlignment="Center">
                                                                <Border Height="4" Background="#12161F" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="2"/>
                                                                <Track x:Name="PART_Track">
                                                                    <Track.Thumb>
                                                                        <Thumb Width="13" Height="13" Cursor="Hand">
                                                                            <Thumb.Template>
                                                                                <ControlTemplate TargetType="Thumb">
                                                                                    <Ellipse Fill="#38BDF8" Stroke="#0C1017" StrokeThickness="1.5">
                                                                                        <Ellipse.Style>
                                                                                            <Style TargetType="Ellipse">
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                                        <Setter Property="Fill" Value="#60CDFF"/>
                                                                                                    </Trigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Ellipse.Style>
                                                                                    </Ellipse>
                                                                                </ControlTemplate>
                                                                            </Thumb.Template>
                                                                        </Thumb>
                                                                    </Track.Thumb>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Slider.Template>
                                                </Slider>

                                                <!-- Fewer Columns (Zoom In) -->
                                                <Button Command="{Binding ZoomInGridCommand}" ToolTip="Fewer Columns (Larger Cards)" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5,3">
                                                    <TextBlock Text="&#xEA54;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Live Column Count Pill -->
                                                <Border Background="#161B24" BorderBrush="#2B3342" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="4,0,2,0">
                                                    <TextBlock Text="{Binding GridColumnLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Inspector Panel Toggle Button -->
                                        <Button Command="{Binding ToggleInspectorCommand}" ToolTip="Toggle Inspector Panel (Ctrl+I)" Padding="12,6" BorderThickness="1" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#202530"/>
                                                    <Setter Property="BorderBrush" Value="#2F3644"/>
                                                    <Setter Property="Foreground" Value="#8B949E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInspectorVisible}" Value="True">
                                                            <Setter Property="Background" Value="#1A2D42"/>
                                                            <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEBF4;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Inspector" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= MULTI-SELECTION BULK ACTION BAR ================= -->
                            <Border Grid.Row="1" Background="#202530" BorderBrush="#2F3644" BorderThickness="0,0,0,1" Padding="22,10" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Count Badge & Keyboard Shortcuts Tip -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1D9BF0" CornerRadius="12" Padding="12,4" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEAB2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}{0} Selected'}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Ctrl+Click to toggle • Shift+Click to range • Press Del to remove" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right Actions: [ ☑ Select All ] [ ✕ Clear ] [ 📁 Move Selected ⌵ ] [ 🔗 Link Story ] [ 🗑️ Delete Selected (N) ] -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Select All Button -->
                                        <Button Command="{Binding SelectAllPostsCommand}" Margin="0,0,8,0" Padding="12,6" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" ToolTip="Select All Posts (Ctrl+A)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEBB1;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Select All" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Clear Selection Button -->
                                        <Button Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" Padding="12,6" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" ToolTip="Deselect All (Esc)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Move Selected Dropdown Menu Button -->
                                        <Menu Background="Transparent" Margin="0,0,8,0">
                                            <MenuItem SubmenuOpened="MoveSelectedMenu_Opened" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" Padding="12,6">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEA83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Move ({0})'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" &#xEAB4;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#8B949E"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </Menu>

                                        <!-- Link Selected Posts as Multi-Part Story Button -->
                                        <Button Command="{Binding LinkSelectedPostsAsStoryCommand}" Margin="0,0,8,0" Padding="12,6" Background="#1A3B5C" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#38BDF8" Cursor="Hand" ToolTip="Link all selected posts into a multi-part story sequence">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEB15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Link Story" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Selected Button (Prominent Crimson Warning) -->
                                        <Button Command="{Binding DeleteSelectedPostsCommand}" Padding="16,6" Background="#DA3633" BorderBrush="#F85149" BorderThickness="1" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Permanently delete all selected posts from database (Delete key)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Delete Selected ({0})'}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= 1. LIST VIEW (Full Width Timeline Cards) ================= -->
                            <ListView Grid.Row="2" x:Name="FeedListControl" PreviewMouseLeftButtonDown="FeedList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="FeedList_PreviewMouseRightButtonDown" PreviewMouseMove="FeedList_PreviewMouseMove" ItemsSource="{Binding FilteredPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="FeedListView_SelectionChanged" KeyDown="FeedListView_KeyDown" Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}" Background="Transparent" BorderThickness="0" Padding="24,18" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="FeedListView_MouseDoubleClick">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,16"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <Border CornerRadius="14" Background="{DynamicResource CardBgBrush}" BorderThickness="1" Padding="20" Cursor="Hand">
                                            <Border.ContextMenu>
                                                <ContextMenu Opened="CardContextMenu_Opened" Background="#161B22" BorderBrush="#2F3336" Foreground="#E7E9EA">
                                                    <MenuItem Click="ContextOpenTheater_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open Theater View" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextEditPost_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#E7E9EA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Edit Post Content" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextPasteComments_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="💬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Paste &amp; Store Comments..." FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextQuickPasteComments_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Quick Paste Clipboard Comments" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Multi-Part Story Linking Options -->
                                                    <MenuItem Click="ContextOpenThreadReader_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📖" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Thread Reader" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextViewFullStory_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="View Full Story in Feed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextUnlinkStory_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Unlink from Story" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextLinkStory_Click" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Link Selected as Multi-Part Story" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <!-- Move Entire Thread Menu (Visible when part of thread) -->
                                                    <MenuItem Tag="MoveThread" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🧵" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move Entire Thread to Folder..." FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Move Post to Folder Menu -->
                                                    <MenuItem Tag="MovePost">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move Post to Folder..." VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextOpenExplorer_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Explorer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextCopyTweet_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <MenuItem Click="ContextDeleteSelected_Click" Foreground="#F87171" FontWeight="Bold" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.SelectedPostsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Delete {0} Selected Posts'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextDeletePost_Click" Foreground="#F87171">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Delete Entry" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- 0: Header -->
                                                    <RowDefinition Height="Auto"/> <!-- 1: Body Text -->
                                                    <RowDefinition Height="Auto"/> <!-- 2: Comment Note -->
                                                    <RowDefinition Height="Auto"/> <!-- 3: Media Previews Grid -->
                                                    <RowDefinition Height="Auto"/> <!-- 4: Action Bar -->
                                                    <RowDefinition Height="Auto"/> <!-- 5: Inline Comments Section -->
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/> <!-- Avatar & Timeline -->
                                                        <ColumnDefinition Width="*"/>  <!-- Names & Date -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Hover Quick Actions -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar Circle & Connected Thread Timeline -->
                                                    <Grid Grid.Column="0" VerticalAlignment="Top">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="40"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Avatar Circle -->
                                                        <Border Grid.Row="0" Width="40" Height="40" CornerRadius="20" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AvatarInitial}" FontSize="15" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Connected Thread Timeline Guide Line -->
                                                        <Border Grid.Row="1" Width="2.5" Height="14" Background="#333C4D" Margin="0,4,0,0" HorizontalAlignment="Center" CornerRadius="1.25" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>

                                                    <!-- Name, Handle, Timestamp, Folder & Story Badges -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AuthorName}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <Border Width="16" Height="16" CornerRadius="8" Background="#1D9BF0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Archived Account">
                                                                <TextBlock Text="✓" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AuthorHandle}" FontSize="12" Foreground="#8B949E"/>
                                                            <TextBlock Text=" · " FontSize="12" Foreground="#6E7681"/>
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="12" Foreground="#8B949E"/>

                                                            <!-- Folder Badge -->
                                                            <Border Background="#21262D" CornerRadius="6" Padding="7,2" BorderBrush="#30363D" BorderThickness="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                            </Border>

                                                            <!-- Connected Story Part Badge (Click to open Thread Reader App) -->
                                                            <Border Background="#1A2D42" CornerRadius="6" Padding="7,2" BorderBrush="#38BDF8" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Cursor="Hand" ToolTip="Multi-part thread. Click to open in Thread Reader App">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenThreadReaderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="🧵" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Inline Action Buttons (Edit, Delete, Theater) — reveal on card hover -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <!-- Edit Button -->
                                                        <Button Command="{Binding DataContext.EditPostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Edit Post" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Delete Button -->
                                                        <Button Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete Post (Del)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Theater View Button -->
                                                        <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Split Theater View" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28">
                                                            <Button.Resources>
                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tweet Content Text -->
                                                <emoji:TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="14.5" LineHeight="21" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,12,0,10" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                <!-- Optional Note / Comment Bubble -->
                                                <Border Grid.Row="2" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F0883E" VerticalAlignment="Top" Margin="0,2,6,0"/>
                                                        <emoji:TextBlock Text="{Binding Comment}" FontSize="12.5" Foreground="#F0883E" TextWrapping="Wrap" LineHeight="18"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Attached Media Previews — Responsive Dynamic Twitter Collage Grids -->
                                                <Grid Grid.Row="3" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                    <!-- 1 Image / Video Preview -->
                                                    <Border Visibility="{Binding HasSingleMedia, Converter={StaticResource BoolToVis}}" CornerRadius="14" Background="#0C1017" ClipToBounds="True" MaxHeight="320" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Image Source="{Binding PrimaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                            <!-- Video Play Overlay Badge -->
                                                            <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}" Background="#CC000000" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" Foreground="#FFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 2 Images Layout (Side-by-side Columns) -->
                                                    <Grid Visibility="{Binding HasTwoMedia, Converter={StaticResource BoolToVis}}" Height="210" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,3,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Margin="3,0,0,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 3 Images Layout (1 Big Left, 2 Stacked Right — Twitter/X Signature) -->
                                                    <Grid Visibility="{Binding HasThreeMedia, Converter={StaticResource BoolToVis}}" Height="240" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Large Left Image spanning full height -->
                                                        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,3,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <!-- Top Right -->
                                                        <Border Grid.Column="1" Grid.Row="0" Margin="3,0,0,2" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <!-- Bottom Right -->
                                                        <Border Grid.Column="1" Grid.Row="1" Margin="3,2,0,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding ThirdImage, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 4+ Images Layout (Clean 2x2 Mosaic Grid) -->
                                                    <Grid Visibility="{Binding HasFourOrMoreMedia, Converter={StaticResource BoolToVis}}" Height="240" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,2.5,2.5" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Margin="2.5,0,0,2.5" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,2.5,2.5,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding ThirdImage, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Margin="2.5,2.5,0,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding FourthImage, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <!-- 4. Clean Minimalist Action Bar -->
                                                <Border Grid.Row="4" Margin="0,12,0,0" Padding="0,6,0,0" BorderBrush="#222731" BorderThickness="0,1,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- 1. Note / Comment Button -->
                                                        <Button Command="{Binding DataContext.TogglePostCommentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="View &amp; Paste Comments" Background="Transparent" BorderThickness="0" Cursor="Hand" Height="30" Margin="0,0,16,0" Padding="4,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15" Padding="6,3">
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock x:Name="btnIcon" Text="💬" FontSize="13" Opacity="0.75" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding CommentCountBadge}" Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#132338"/>
                                                                            <Setter TargetName="btnIcon" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 2. Thread Reader / Story Button (Only for threads) -->
                                                        <Button Command="{Binding DataContext.OpenThreadReaderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" ToolTip="Read Thread in Story Reader" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="30" Margin="0,0,16,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                                                        <TextBlock x:Name="btnIcon" Text="🧵" FontSize="13" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#102E24"/>
                                                                            <Setter TargetName="btnIcon" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 3. Media / Theater Button -->
                                                        <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" ToolTip="View Fullscreen in Theater View" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="30" Margin="0,0,16,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                                                        <TextBlock x:Name="btnIcon" Text="🖼️" FontSize="12.5" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#2D1722"/>
                                                                            <Setter TargetName="btnIcon" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 4. Copy Post Content -->
                                                        <Button Command="{Binding DataContext.CopyPostTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Copy Post Content" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="30" Margin="0,0,16,0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                                                        <TextBlock x:Name="btnIcon" Text="📋" FontSize="12.5" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#2E2413"/>
                                                                            <Setter TargetName="btnIcon" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- 5. Open Folder in Explorer -->
                                                        <Button Command="{Binding DataContext.OpenLocalFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Post Folder in Windows Explorer" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="32" Height="30">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="15">
                                                                        <TextBlock x:Name="btnIcon" Text="📁" FontSize="12.5" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="btnBorder" Property="Background" Value="#172738"/>
                                                                            <Setter TargetName="btnIcon" Property="Opacity" Value="1.0"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                 </Border>

                                                <!-- 5. INLINE YOUTUBE-STYLE COMMENTS SECTION -->
                                                <Border Grid.Row="5" Visibility="{Binding IsCommentsExpanded, Converter={StaticResource BoolToVis}}" Background="#12161E" BorderBrush="#252C38" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <!-- Comments Section Header -->
                                                        <Grid Margin="0,0,0,12">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Archived Comments" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                <Border Background="#1D2E42" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" BorderBrush="#38BDF8" BorderThickness="1">
                                                                    <TextBlock Text="{Binding CommentCount}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Quick Action Buttons -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <!-- Paste Comments Dialog Button -->
                                                                <Button Command="{Binding DataContext.OpenPasteCommentsWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open full Paste &amp; Review dialog" Background="#1D2E42" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#38BDF8" Cursor="Hand" Padding="8,4" Margin="0,0,6,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                                    </Button.Resources>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="📋 " FontSize="11" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="Paste Comments" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Quick Clipboard Paste Button -->
                                                                <Button Command="{Binding DataContext.QuickPasteClipboardCommentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Instantly import comments from Clipboard" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#E7E9EA" Cursor="Hand" Padding="8,4" Margin="0,0,6,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                                    </Button.Resources>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="⚡ Quick Paste" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <!-- Collapse comments button -->
                                                                <Button Command="{Binding DataContext.TogglePostCommentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Close comments" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Cursor="Hand" Width="22" Height="22">
                                                                    <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Inline Quick-Add Input (YouTube Style: Avatar + "Add a comment...") -->
                                                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                    <TextBlock Text="💬" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBox Grid.Column="1"
                                                                         Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                                         FontSize="12.5" CaretBrush="#1D9BF0" VerticalAlignment="Center"
                                                                         KeyDown="InlineCommentBox_KeyDown"
                                                                         Tag="{Binding}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="Text" Value="">
                                                                                    <Setter Property="Background">
                                                                                        <Setter.Value>
                                                                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                                                                <VisualBrush.Visual>
                                                                                                    <TextBlock Text="Add a comment or paste copied text (press Enter to post)..." Foreground="#6E7681" FontSize="12.5"/>
                                                                                                </VisualBrush.Visual>
                                                                                            </VisualBrush>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <Button Grid.Column="2" Click="PostInlineComment_Click" ToolTip="Post Comment"
                                                                        Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0"
                                                                        Cursor="Hand" Padding="10,4" Margin="6,0,0,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="Post" FontSize="11.5" FontWeight="Bold"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <!-- YouTube Comments List (when comments exist) -->
                                                        <ItemsControl ItemsSource="{Binding Comments}" Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#1C212B" BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="38"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Avatar Circle (with deterministic vibrant color matching YouTube) -->
                                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                                                    Background="{Binding AvatarBackground, Converter={StaticResource HexToBrush}}"
                                                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding AvatarInitial}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>

                                                                            <!-- Comment Content -->
                                                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                                <!-- Top Row: Author Handle & Time -->
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                                                    <TextBlock Text="{Binding DisplayHandle}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                                    <TextBlock Text=" · " FontSize="12" Foreground="#6E7681" Margin="3,0"/>
                                                                                    <TextBlock Text="{Binding DisplayTime}" FontSize="11.5" Foreground="#8B949E"/>
                                                                                </StackPanel>

                                                                                <!-- Comment Text Body -->
                                                                                <emoji:TextBlock Text="{Binding Content}" FontSize="13" LineHeight="19" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,0,0,6" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                                                <!-- YouTube Reactions Row (Likes, Reply, Reply count badge) -->
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock Text="👍" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding LikeCount}" Visibility="{Binding HasLikes, Converter={StaticResource BoolToVis}}" FontSize="11.5" Foreground="#8B949E" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                                    
                                                                                    <TextBlock Text="👎" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.6"/>
                                                                                    <TextBlock Text="Reply" FontSize="11" Foreground="#8B949E" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                                                                    <Border Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}" Background="#0E2436" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="9" Padding="7,2">
                                                                                        <StackPanel Orientation="Horizontal">
                                                                                            <TextBlock Text="⌵ " FontSize="9" Foreground="#38BDF8" FontWeight="Bold"/>
                                                                                            <TextBlock Text="{Binding ReplyCount}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- Hover Action: Delete Comment Button -->
                                                                            <Button Grid.Column="2"
                                                                                    Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    ToolTip="Delete comment"
                                                                                    Background="Transparent" BorderThickness="0"
                                                                                    Foreground="#6E7681" Cursor="Hand" Width="24" Height="24" VerticalAlignment="Top" Opacity="0.5">
                                                                                <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Empty state when no comments -->
                                                        <Border Visibility="{Binding HasComments, Converter={StaticResource InverseBoolToVis}}" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,4,0,0">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="No archived comments yet." FontSize="12.5" FontWeight="SemiBold" Foreground="#8B949E" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="Click 'Paste Comments' or '⚡ Quick Paste' to import comments copied from YouTube." FontSize="11" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- ================= 2. GRID VIEW (Card Tiles Multi-Column Layout - Spacious & Rounded) ================= -->
                            <ListView Grid.Row="2" x:Name="FeedGridControl" PreviewMouseLeftButtonDown="FeedList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="FeedList_PreviewMouseRightButtonDown" PreviewMouseMove="FeedList_PreviewMouseMove" ItemsSource="{Binding FilteredPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="FeedListView_SelectionChanged" KeyDown="FeedListView_KeyDown" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" Padding="24,20" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="FeedListView_MouseDoubleClick">

                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" StretchItems="False"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,22,22"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <!-- Clean Tile Card with dynamic resizer width -->
                                        <Border Width="{Binding DataContext.GridCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="{Binding DataContext.GridCardMinHeight, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="14" Background="{DynamicResource CardBgBrush}" BorderThickness="1" Cursor="Hand" ClipToBounds="False">
                                            <Border.ContextMenu>
                                                <ContextMenu Opened="CardContextMenu_Opened" Background="#161B22" BorderBrush="#2F3336" Foreground="#E7E9EA">
                                                    <MenuItem Click="ContextOpenTheater_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open Theater View" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextEditPost_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#E7E9EA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Edit Post Content" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextPasteComments_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="💬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Paste &amp; Store Comments..." FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextQuickPasteComments_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Quick Paste Clipboard Comments" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Multi-Part Story Linking Options -->
                                                    <MenuItem Click="ContextOpenThreadReader_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📖" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Thread Reader" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Click="ContextViewFullStory_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="View Full Story in Feed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextUnlinkStory_Click" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Unlink from Story" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextLinkStory_Click" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Link Selected as Multi-Part Story" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <!-- Move Entire Thread Menu (Visible when part of thread) -->
                                                    <MenuItem Tag="MoveThread" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="🧵" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move Entire Thread to Folder..." FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Move Post to Folder Menu -->
                                                    <MenuItem Tag="MovePost">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move Post to Folder..." VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextOpenExplorer_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Explorer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextCopyTweet_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <MenuItem Click="ContextDeleteSelected_Click" Foreground="#F87171" FontWeight="Bold" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.SelectedPostsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Delete {0} Selected Posts'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Click="ContextDeletePost_Click" Foreground="#F87171">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Delete Entry" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="#45BAEA"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- 0. Media Capsule or Top Pill Header -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 1. Text Content -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- 2. Comment Preview if present -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 3. Minimal Footer (Timestamp) -->
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- 1A. Floating Rounded Media Capsule (When Post HAS Media) -->
                                                <Border Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Height="{Binding DataContext.GridMediaHeight, RelativeSource={RelativeSource AncestorType=Window}}" Margin="10,10,10,6" CornerRadius="10" Background="#0A0D13" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Image / Video Preview using PrimaryThumbnail -->
                                                        <Image Source="{Binding PrimaryThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>

                                                        <!-- Video Play Overlay Badge -->
                                                        <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}" Background="#CC000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="18" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </Border>

                                                        <!-- Folder Pill Badge (Top-Right) -->
                                                        <Border Background="#CC0A0D13" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="10" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                        </Border>

                                                        <!-- Story Badge Pill (Top-Center if part of thread) -->
                                                        <Border Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#E61A3B5C" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6" Cursor="Hand" ToolTip="Multi-part story. Click to read in Thread Reader App format.">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenThreadReaderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📖" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ThreadPartBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Media Counter Pill Badge (Top-Left if > 1) -->
                                                        <Border Visibility="{Binding HasMultipleMedia, Converter={StaticResource BoolToVis}}" Background="#CC0A0D13" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea72;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9.5" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding MediaCount}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 1B. Top Folder & Story Header (When Post has NO Media) -->
                                                <Grid Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}" Margin="12,10,12,4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <!-- Story Pill -->
                                                        <Border Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#1A3B5C" CornerRadius="6" Padding="6,2" Margin="0,0,6,0" Cursor="Hand" ToolTip="Multi-part story. Click to read in Thread Reader App format.">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenThreadReaderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📖" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ThreadPartBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Folder Pill -->
                                                        <Border Background="#1C2430" CornerRadius="6" Padding="6,2">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="10" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 2. Text Content (Clean & legible) -->
                                                <emoji:TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="12" LineHeight="17" Foreground="#C9D1D9" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68" Margin="12,4,12,6" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                <!-- 3. Optional Comment / Note Preview -->
                                                <Border Grid.Row="2" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="12,0,12,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="10" Foreground="#F0883E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <emoji:TextBlock Text="{Binding Comment}" FontSize="10.5" Foreground="#F0883E" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 4. Minimal Muted Footer (Timestamp, Comments badge + Floating Quick Actions on Hover) -->
                                                <Grid Grid.Row="3" Margin="12,0,12,10">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelativeTime}" FontSize="10.5" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        <Border Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}" Background="#1A2D42" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" ToolTip="Archived Comments">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="💬" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding CommentCount}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Floating Quick Actions (Hover Reveal Only) -->
                                                    <Border HorizontalAlignment="Right" Background="#CC161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Padding="4,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsMouseOver}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Command="{Binding DataContext.OpenPasteCommentsWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Paste &amp; Store Comments" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2">
                                                                <TextBlock Text="💬" FontSize="10.5" Foreground="#38BDF8"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Theater View" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" Margin="2,0,0,0">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#38BDF8"/>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete Post" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" Margin="2,0,0,0">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#F87171"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State — shown when feed is empty -->
                            <Border Grid.Row="2" Visibility="{Binding IsEmptyFeed, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="48" Foreground="#21262D" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <TextBlock Text="Your archive is quiet" FontSize="16" FontWeight="SemiBold" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Paste from clipboard or compose to add posts" FontSize="13" Foreground="#484F58" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status Bar (Clean Seamless Footer) -->
                            <Border Grid.Row="3" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,1,0,0" Padding="20,7">
                                <Grid>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='Showing {0} entries'}" FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW B: COLLECTIONS & FOLDERS EXPLORER (Windows 11 Native Minimal) -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Breadcrumb & Search Bar -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Command Bar & Collection Pills -->
                                <RowDefinition Height="*"/>    <!-- Row 2: Folder Viewport (Grid or Details) -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- ================= 1. EXPLORER BREADCRUMB & SEARCH BAR ================= -->
                            <Border Grid.Row="0" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Navigation buttons -->
                                        <ColumnDefinition Width="*"/>    <!-- Breadcrumb path pill -->
                                        <ColumnDefinition Width="Auto"/> <!-- Search input -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Navigation Buttons: Back, Up, Refresh -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <!-- Back -->
                                        <Button Command="{Binding NavigateExplorerBackCommand}" ToolTip="Back (Alt+Left)" Width="30" Height="28" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xea9b;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#C8D1DC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Up to Root -->
                                        <Button Command="{Binding NavigateExplorerUpCommand}" ToolTip="Up to Root (Archive)" Width="30" Height="28" Margin="0,0,2,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xeaa1;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#C8D1DC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Refresh -->
                                        <Button Command="{Binding RefreshDataCommand}" ToolTip="Refresh Folders (F5)" Width="30" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xea77;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12.5" Foreground="#8D96A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- Breadcrumb Path Bar (Windows 11 Explorer Address Pill) -->
                                    <Border Grid.Column="1" Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Computer / Archive Icon -->
                                            <TextBlock Grid.Column="0" Text="&#xebdf;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#4CC2FF" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <!-- Breadcrumbs -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Root Segment -->
                                                <TextBlock Text="Archive" FontSize="12" Foreground="#C8D1DC" VerticalAlignment="Center" Cursor="Hand">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectExplorerCollectionCommand}" CommandParameter="All Folders"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>

                                                <TextBlock Text="›" FontSize="12" Foreground="#6E7681" Margin="6,0,6,0" VerticalAlignment="Center"/>

                                                <!-- Collections Segment -->
                                                <TextBlock Text="Collections" FontSize="12" Foreground="#C8D1DC" VerticalAlignment="Center" Cursor="Hand">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding SelectExplorerCollectionCommand}" CommandParameter="All Folders"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>

                                                <!-- Active Collection Sub-segment (if filtered) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedExplorerCollection}" Value="All Folders">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="›" FontSize="12" Foreground="#6E7681" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                                    <Border Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding SelectedExplorerCollection}" FontSize="11.5" FontWeight="SemiBold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Explorer Search Pill -->
                                    <Border Grid.Column="2" Width="220" Height="32" Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Padding="8,0" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8D96A6" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                            <TextBox Grid.Column="1" Text="{Binding ExplorerSearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12" VerticalAlignment="Center" CaretBrush="#4CC2FF"/>

                                            <!-- Clear Search Button -->
                                            <Button Grid.Column="2" Command="{Binding ClearExplorerSearchCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="16" Height="16" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExplorerSearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExplorerSearchText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9.5" Foreground="#8D96A6"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ================= 2. EXPLORER COMMAND BAR & COLLECTION PILLS ================= -->
                            <Border Grid.Row="1" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Create buttons -->
                                        <ColumnDefinition Width="*"/>    <!-- Filter Pills Strip -->
                                        <ColumnDefinition Width="Auto"/> <!-- View & Sort switches -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Command Action Buttons -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- New Folder -->
                                        <Button Command="{Binding CreateNewFolderCommand}" CommandParameter="{Binding SelectedExplorerCollection}" Padding="11,5" Background="#202530" Foreground="#FFFFFF" BorderBrush="#2F3644" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xea67;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#4CC2FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Folder" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- New Collection -->
                                        <Button Command="{Binding CreateNewCollectionCommand}" Padding="11,5" Background="#202530" Foreground="#C8D1DC" BorderBrush="#2F3644" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xeb00;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#9DA5B4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Collection" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Vertical Divider -->
                                        <Border Width="1" Height="16" Background="#2F3644" Margin="10,0"/>
                                    </StackPanel>

                                    <!-- Collection Filter Pills Strip -->
                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="2,0,10,0">
                                        <ItemsControl ItemsSource="{Binding ExplorerCollectionPills}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="10,4" Margin="0,0,6,0" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectExplorerCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#202530"/>
                                                                <Setter Property="BorderBrush" Value="#2F3644"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#1A2D42"/>
                                                                        <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#282E3B"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DisplayText}" FontSize="11.5" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#9DA5B4"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Foreground" Value="#38BDF8"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Right View Mode Switches -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Sort Toggle -->
                                        <Button Command="{Binding SetExplorerSortCommand}" CommandParameter="Count" ToolTip="Sort folders by count" Padding="8,4" Background="#202530" BorderBrush="#2F3644" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xebcb;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11.5" Foreground="#8D96A6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sort" FontSize="11.5" Foreground="#C8D1DC" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Grid View Mode -->
                                        <Button Command="{Binding SetExplorerViewModeCommand}" CommandParameter="Grid" ToolTip="Grid (Large Icons)" Width="28" Height="26" Margin="0,0,2,0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#202530"/>
                                                    <Setter Property="BorderBrush" Value="#2F3644"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExplorerViewDetails}" Value="False">
                                                            <Setter Property="Background" Value="#1A2D42"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xea88;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Details View Mode -->
                                        <Button Command="{Binding SetExplorerViewModeCommand}" CommandParameter="Details" ToolTip="Details List" Width="28" Height="26" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#202530"/>
                                                    <Setter Property="BorderBrush" Value="#2F3644"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExplorerViewDetails}" Value="True">
                                                            <Setter Property="Background" Value="#1A2D42"/>
                                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xeb84;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= 3. FOLDER CANVAS (GRID & DETAILS) ================= -->
                            <Grid Grid.Row="2">
                                <!-- VIEW 1: GRID MODE (Album Showcase Cards - Curated Hub) -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20" Visibility="{Binding IsExplorerViewDetails, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel>
                                        <!-- Collections Hub Header Banner -->
                                        <Border Background="#12161D" BorderBrush="#202631" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Hub Title & Stats -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="40" Height="40" CornerRadius="10" Background="#162231" BorderBrush="#22344B" BorderThickness="1" Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Curated Collections" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                                            <Border Background="#162B44" BorderBrush="#23456D" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExplorerDisplayFolders.Count, StringFormat='{}{0} Collections'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="Visual album showcase organized by topic, tags, and media" FontSize="12" Foreground="#8B949E" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right: Quick Add Folder -->
                                                <Button Grid.Column="2" Command="{Binding CreateNewFolderCommand}" CommandParameter="{Binding SelectedExplorerCollection}" Padding="12,6" Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea67;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="New Folder" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Empty State -->
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" Margin="0,40,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ExplorerDisplayFolders.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="42" Foreground="#2A313E" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <TextBlock Text="No folders found" FontSize="15" FontWeight="SemiBold" Foreground="#8D96A6" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Try clearing your search or filter pills" FontSize="12" Foreground="#5E6877" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                <Button Content="Show All Folders" Command="{Binding SelectExplorerCollectionCommand}" CommandParameter="All Folders" Padding="12,5" Background="#202530" Foreground="#4CC2FF" BorderBrush="#2F3644" BorderThickness="1" Cursor="Hand" HorizontalAlignment="Center">
                                                    <Button.Resources>
                                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Grid of Folder Album Cards -->
                                        <ItemsControl ItemsSource="{Binding ExplorerDisplayFolders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Modern Album Showcase Card -->
                                                    <Border x:Name="AlbumCardRoot" Width="260" Height="210" Margin="0,0,20,20" CornerRadius="14" Cursor="Hand" BorderThickness="1"
                                                            Background="#161B22" BorderBrush="#252D38"
                                                            AllowDrop="True" DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Folder_Drop"
                                                            ClipToBounds="True">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#45BAEA"/>
                                                                        <Setter Property="Background" Value="#1C232E"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                                        <Setter Property="Background" Value="#19202A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectExplorerFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.ContextMenu>
                                                            <ContextMenu Background="#202530" BorderBrush="#2F3644" BorderThickness="1">
                                                                <MenuItem Header="Open Folder in Feed" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                                <MenuItem Header="Add New Post Here" Command="{Binding DataContext.OpenComposeDialogCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Name}"/>
                                                                <Separator Background="#2F3644"/>
                                                                <MenuItem Header="Delete Folder" Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Foreground="#F87171"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="136"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Row 0: Cover Media Showcase / Ambient Collage -->
                                                            <Grid Grid.Row="0" Background="#0A0D13" ClipToBounds="True">
                                                                <!-- A. Has Media Preview Collage -->
                                                                <Grid Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Hero Left Thumbnail -->
                                                                    <Image Grid.Column="0" Source="{Binding FirstThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>

                                                                    <!-- Right Stack Preview (When multiple thumbnails exist) -->
                                                                    <Grid Grid.Column="1" Width="82" Visibility="{Binding HasMultipleThumbnails, Converter={StaticResource BoolToVis}}" Margin="2,0,0,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*"/>
                                                                            <RowDefinition Height="*"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Image Grid.Row="0" Source="{Binding SecondThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill"/>
                                                                        <Image Grid.Row="1" Source="{Binding ThirdThumbnail, Converter={StaticResource ThumbImageConverter}}" Stretch="UniformToFill" Margin="0,2,0,0" Visibility="{Binding ThirdThumbnail, Converter={StaticResource NullToVis}}"/>
                                                                    </Grid>
                                                                </Grid>

                                                                <!-- B. Empty or Text-Only Album State -->
                                                                <Border Visibility="{Binding HasThumbnails, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                            <GradientStop Color="#162231" Offset="0.0"/>
                                                                            <GradientStop Color="#0D1117" Offset="0.5"/>
                                                                            <GradientStop Color="#161B22" Offset="1.0"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <Border Width="56" Height="56" CornerRadius="28" Background="#1C2533" BorderBrush="#2F3C4F" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayGlyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Border>

                                                                <!-- Bottom Shadow Gradient overlay for contrast -->
                                                                <Border Height="36" VerticalAlignment="Bottom">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                                                            <GradientStop Color="#B3161B22" Offset="1.0"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>

                                                                <!-- Top-Left Category Pill -->
                                                                <Border Background="#E60D1117" BorderBrush="#252D38" BorderThickness="1" CornerRadius="6" Padding="6,2.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DisplayGlyph}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding CollectionName}" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Top-Right Post Count Badge -->
                                                                <Border Background="#E60D1117" BorderBrush="#252D38" BorderThickness="1" CornerRadius="6" Padding="7,2.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} posts'}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Row 1: Card Footer Details & Hover Action -->
                                                            <Border Grid.Row="1" Padding="12,8,12,8" Background="#161B22">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Name & Hover Open Pill -->
                                                                    <Grid Grid.Row="0">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,65,0"/>

                                                                        <!-- Floating Open Button on Hover -->
                                                                        <Button Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Open this folder in Timeline Feed">
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                                            </Button.Resources>
                                                                            <Button.Style>
                                                                                <Style TargetType="Button">
                                                                                    <Setter Property="Opacity" Value="0"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ElementName=AlbumCardRoot, Path=IsMouseOver}" Value="True">
                                                                                            <Setter Property="Opacity" Value="1"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="Open" FontSize="11" FontWeight="SemiBold" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="›" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Subtext / Activity Status -->
                                                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                                                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- VIEW 2: DETAILS MODE (Windows 11 Explorer Table List) -->
                                <Grid Visibility="{Binding IsExplorerViewDetails, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header -->
                                        <RowDefinition Height="*"/>    <!-- Rows -->
                                    </Grid.RowDefinitions>

                                    <!-- Details Table Header -->
                                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6"/>
                                            <TextBlock Grid.Column="1" Text="COLLECTION" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6"/>
                                            <TextBlock Grid.Column="2" Text="ARCHIVE COUNT" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6"/>
                                            <TextBlock Grid.Column="3" Text="ACTIVITY" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6"/>
                                            <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                    <!-- Details Rows -->
                                    <ListView Grid.Row="1" ItemsSource="{Binding ExplorerDisplayFolders}" Background="Transparent" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="#202530"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="Padding" Value="16,10"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListViewItem">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Margin="0,1" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFFF0A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#1A2D42"/>
                                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.InputBindings>
                                                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="280"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Compact Folder Icon & Name -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="26" Height="26" CornerRadius="6" Background="#1C2533" BorderBrush="#2F3C4F" BorderThickness="1" Margin="0,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayGlyph}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Collection Badge -->
                                                    <Border Grid.Column="1" HorizontalAlignment="Left" Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CollectionName}" FontSize="11.5" Foreground="#4CC2FF" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Post Count -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} posts'}" FontSize="12.5" Foreground="#9DA5B4" VerticalAlignment="Center"/>

                                                    <!-- Last Activity -->
                                                    <TextBlock Grid.Column="3" Text="{Binding LastUpdatedText}" FontSize="12" Foreground="#8D96A6" VerticalAlignment="Center"/>

                                                    <!-- Action Button -->
                                                    <Button Grid.Column="4" HorizontalAlignment="Right" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#202530" Foreground="#4CC2FF" BorderBrush="#2F3644" BorderThickness="1" Padding="10,4" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="Browse →" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>

                            <!-- ================= 4. EXPLORER STATUS BAR ================= -->
                            <Border Grid.Row="3" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,1,0,0" Padding="16,5">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ExplorerDisplayFolders.Count, StringFormat='{}{0} folders'}" FontSize="11.5" Foreground="#9DA5B4"/>
                                        <TextBlock Text="  •  " FontSize="11.5" Foreground="#6E7681"/>
                                        <TextBlock Text="{Binding Posts.Count, StringFormat='{}{0} archived posts'}" FontSize="11.5" Foreground="#9DA5B4"/>
                                        <TextBlock Text="  •  " FontSize="11.5" Foreground="#6E7681"/>
                                        <TextBlock Text="{Binding SelectedExplorerCollection, StringFormat='Scope: {0}'}" FontSize="11.5" Foreground="#4CC2FF"/>
                                    </StackPanel>
                                    <TextBlock Text="Windows 11 Fluent Archive • ESE Engine" FontSize="11" Foreground="#6E7681" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= RIGHT INSPECTOR PANEL (COLLAPSIBLE) ================= -->
                <Grid Grid.Column="2" Width="330" Background="{DynamicResource InspectorBgBrush}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeDashboardActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- 1. EMPTY STATE (When NO post is selected) -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedPost}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding HasMultipleSelection}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✦" FontSize="36" Foreground="#2F3336" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Select a post to inspect details" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. MULTI-SELECTION STATE (When > 1 post is selected) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVis}}" Padding="20,18">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Multi-Selection" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}{0} posts selected'}" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding CloseInspectorCommand}" ToolTip="Close Inspector Panel" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <!-- Primary Action Card -->
                            <Border Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="BULK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6" Margin="0,0,0,12"/>

                                    <!-- Bulk Move to Folder Menu -->
                                    <Menu Background="Transparent" Margin="0,0,0,8">
                                        <MenuItem PreviewMouseLeftButtonDown="MoveSelectedMenu_PreviewMouseLeftButtonDown" SubmenuOpened="MoveSelectedMenu_Opened" Header="{Binding SelectedPostsCount, StringFormat='Move {0} Posts to Folder...'}" Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" Foreground="#4CC2FF" FontWeight="SemiBold" Padding="14,9">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                            <MenuItem Header="Loading..." Visibility="Collapsed"/>
                                        </MenuItem>
                                    </Menu>

                                    <!-- Link Selected as Multi-Part Story -->
                                    <Button Command="{Binding LinkSelectedPostsAsStoryCommand}" Background="#1A2D42" BorderBrush="#4CC2FF" BorderThickness="1" Foreground="#FFFFFF" Padding="14,9" Cursor="Hand" Margin="0,0,0,8">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                            <TextBlock Text="Link as Multi-Part Story" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Selected Posts -->
                                    <Button Command="{Binding DeleteSelectedPostsCommand}" Background="#DA3633" BorderBrush="#F85149" BorderThickness="1" Foreground="#FFFFFF" Padding="14,9" Cursor="Hand" Margin="0,0,0,8">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Delete All {0} Posts'}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Clear Selection -->
                                    <Button Command="{Binding ClearSelectionCommand}" Background="#202530" BorderBrush="#2F3644" BorderThickness="1" Foreground="#C9D1D9" Padding="14,8" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deselect All" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Selected Items List Preview -->
                            <TextBlock Text="SELECTED POSTS" FontSize="11" FontWeight="SemiBold" Foreground="#8D96A6" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedPosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding AuthorName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <emoji:TextBlock Text="{Binding ContentSnippet}" FontSize="11.5" Foreground="#9DA5B4" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1A2D42" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding FolderName}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. SINGLE SELECTED POST INSPECTOR CONTENT -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMultipleSelection}" Value="False"/>
                                            <Condition Binding="{Binding SelectedPost, Converter={StaticResource NullToVis}}" Value="Visible"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- Panel Title, Theater Mode Button, and Close Button -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Post Inspector" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenTheaterModeCommand}" CommandParameter="{Binding SelectedPost}" Padding="10,4" Margin="0,0,8,0" Background="#202530" Foreground="#4CC2FF" BorderBrush="#2F3644" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Theater" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Close Inspector Button -->
                                    <Button Command="{Binding CloseInspectorCommand}" ToolTip="Close Inspector Panel" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" Width="26" Height="26">
                                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Details Table -->
                            <!-- 1. Author -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Author" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedPost.AuthorName}" FontSize="13" FontWeight="SemiBold" Foreground="#E7E9EA"/>
                                    <TextBlock Text="{Binding SelectedPost.AuthorHandle, StringFormat='({0})'}" FontSize="12" Foreground="#8B949E"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Folder (with quick Move to Folder Dropdown) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Folder" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Current Folder with Quick-Move Dropdown Menu -->
                                    <Menu Background="Transparent" Margin="0,0,8,4">
                                        <MenuItem PreviewMouseLeftButtonDown="InspectorMovePost_PreviewMouseLeftButtonDown" SubmenuOpened="InspectorMovePost_Opened" Background="{StaticResource BadgeBgBrush}" BorderBrush="#30363D" BorderThickness="1" Padding="8,4" ToolTip="Click to move post to another folder">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SelectedPost.FolderName}" FontSize="12" FontWeight="SemiBold" Foreground="#1D9BF0" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" ⌵" FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                            <MenuItem Header="Loading..." Visibility="Collapsed"/>
                                        </MenuItem>
                                    </Menu>

                                    <!-- Quick Move Entire Thread Menu (Visible when Part of Thread) -->
                                    <Menu Background="Transparent" Margin="0,0,0,4" Visibility="{Binding SelectedPost.IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                        <MenuItem PreviewMouseLeftButtonDown="InspectorMoveThread_PreviewMouseLeftButtonDown" SubmenuOpened="InspectorMoveThread_Opened" Background="#102E24" BorderBrush="#14532D" BorderThickness="1" Padding="8,4" ToolTip="Move all connected parts of this story to another folder">
                                            <MenuItem.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🧵 Move Thread ⌵" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </MenuItem.Header>
                                            <MenuItem Header="Loading..." Visibility="Collapsed"/>
                                        </MenuItem>
                                    </Menu>
                                </WrapPanel>
                            </Grid>

                            <!-- 3. Notes / Comment (Optional) -->
                            <Grid Margin="0,0,0,14" Visibility="{Binding SelectedPost.HasComment, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Comment" FontSize="12" Foreground="#F0883E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <Border Grid.Column="1" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                    <emoji:TextBlock Text="{Binding SelectedPost.Comment}" FontSize="12.5" LineHeight="17" Foreground="#F0883E" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>

                            <!-- 3.5 Linked Multi-Part Story Navigation & Management -->
                            <Border Visibility="{Binding SelectedPost.IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#121820" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MULTI-PART STORY" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedPost.ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Interactive Story Parts Pill List -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                        <ItemsControl ItemsSource="{Binding SelectedPostStoryParts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.JumpToStoryPartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Foreground="#E7E9EA">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="{Binding ThreadPartBadge}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Story Action Buttons (Prev, Next, View Full Story, Unlink) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SelectPreviousLinkedPartCommand}" ToolTip="Jump to Previous Linked Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,4">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="◀ Prev Part" FontSize="11"/>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding SelectNextLinkedPartCommand}" ToolTip="Jump to Next Linked Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,4">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Next Part ▶" FontSize="11"/>
                                        </Button>
                                    </Grid>

                                    <!-- Read in Thread Reader App format -->
                                    <Button Command="{Binding OpenThreadReaderCommand}" CommandParameter="{Binding SelectedPost}" Height="34" Margin="0,0,0,8" Background="#1D2E42" BorderBrush="#38BDF8" BorderThickness="1.5" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Open full thread in Thread Reader App format">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📖" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Thread Reader" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Post Thread as Story (9:16 Canvas) -->
                                    <Button Command="{Binding OpenStoryExportCommand}" CommandParameter="{Binding SelectedPost}" Height="34" Margin="0,0,0,8" Background="#1B2B3A" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Preview and export thread as 9:16 Story Cards (PNG)">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📱" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Post Thread as Story" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Read in Document Reader (Word-like inline images & next part) -->
                                    <Button Command="{Binding OpenDocumentReaderCommand}" CommandParameter="{Binding SelectedPost}" Height="34" Margin="0,0,0,8" Background="#142436" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Read thread as Word-style document with inline images and part progression">
                                        <Button.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📄" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Read in Document Reader" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding ViewFullStoryCommand}" CommandParameter="{Binding SelectedPost}" Background="#1D9BF0" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Padding="6,4" ToolTip="Filter feed to view all parts of this story">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="View Full Story" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding UnlinkFromStoryCommand}" CommandParameter="{Binding SelectedPost}" Background="#211818" BorderBrush="#4A2525" BorderThickness="1" Foreground="#F87171" Cursor="Hand" Padding="6,4" ToolTip="Detach post from this story thread">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Unlink Post" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Date -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FormattedDate}" FontSize="12.5" Foreground="#E7E9EA" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 5. Local Path -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Local Path" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FolderPath}" FontSize="11" Foreground="#9EACB9" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPost.FolderPath}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 6. Tags List -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tags" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top" Margin="0,4,0,0"/>

                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedPost.TagList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.FilterByTagStringCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" Foreground="#9EACB9"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- 7. ARCHIVED COMMENTS SECTION (YouTube Aesthetic) -->
                            <Border Background="#121620" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Section Header -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Archived Comments" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Border Background="#1D2E42" CornerRadius="7" Padding="6,1" Margin="8,0,0,0" BorderBrush="#38BDF8" BorderThickness="1">
                                                <TextBlock Text="{Binding SelectedPost.CommentCount}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Quick Paste / Manage Button -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Command="{Binding OpenPasteCommentsWindowCommand}" CommandParameter="{Binding SelectedPost}" ToolTip="Paste &amp; Store Comments" Background="#1D2E42" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#38BDF8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📋 " FontSize="10.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Paste" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding QuickPasteClipboardCommentsCommand}" CommandParameter="{Binding SelectedPost}" ToolTip="Quick Paste from Clipboard" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#E7E9EA" Cursor="Hand" Padding="7,4">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                </Button.Resources>
                                                <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Inline Quick Comment Input -->
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="💬" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBox Grid.Column="1"
                                                     Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                     FontSize="11.5" CaretBrush="#1D9BF0" VerticalAlignment="Center"
                                                     KeyDown="InlineCommentBox_KeyDown"
                                                     Tag="{Binding SelectedPost}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                                                            <VisualBrush.Visual>
                                                                                <TextBlock Text="Add a comment (Enter to post)..." Foreground="#6E7681" FontSize="11.5"/>
                                                                            </VisualBrush.Visual>
                                                                        </VisualBrush>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Grid.Column="2" Click="PostInlineComment_Click" ToolTip="Post Comment"
                                                    Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0"
                                                    Cursor="Hand" Padding="8,3" Margin="4,0,0,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                </Button.Resources>
                                                <TextBlock Text="Post" FontSize="11" FontWeight="Bold"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Comments List -->
                                    <ItemsControl ItemsSource="{Binding SelectedPost.Comments}" Visibility="{Binding SelectedPost.HasComments, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="#1C212B" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Avatar -->
                                                        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                                Background="{Binding AvatarBackground, Converter={StaticResource HexToBrush}}"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding AvatarInitial}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Comment Details -->
                                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding DisplayHandle}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                <TextBlock Text=" · " FontSize="11" Foreground="#6E7681" Margin="2,0"/>
                                                                <TextBlock Text="{Binding DisplayTime}" FontSize="10.5" Foreground="#8B949E"/>
                                                            </StackPanel>

                                                            <emoji:TextBlock Text="{Binding Content}" FontSize="12" LineHeight="17" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                            <!-- YouTube Reactions Row -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="👍" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding LikeCount}" Visibility="{Binding HasLikes, Converter={StaticResource BoolToVis}}" FontSize="10.5" Foreground="#8B949E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="👎" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.6"/>
                                                                <Border Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}" Background="#0E2436" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                                                    <TextBlock Text="{Binding ReplyCount}" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Delete comment"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="#6E7681" Cursor="Hand" Width="20" Height="20" VerticalAlignment="Top" Opacity="0.5">
                                                            <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty Comments Placeholder -->
                                    <Border Visibility="{Binding SelectedPost.HasComments, Converter={StaticResource InverseBoolToVis}}" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="No comments archived yet." FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Click 'Paste' to import comments." FontSize="10.5" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,10,0,0">
                                <!-- Open Theater Button — Ghost/Outline Style -->
                                
                                <!-- Open Local Folder Button -->
                                <Button Style="{StaticResource InspectorActionButton}" Command="{Binding OpenLocalFolderCommand}" CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Local Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Edit Post Content Button -->
                                <Button Style="{StaticResource InspectorActionButton}" Command="{Binding EditPostCommand}" CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit Post &amp; Media" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Delete Entry Button — subtle muted text, red on hover -->
                                <Button Command="{Binding DeletePostCommand}" CommandParameter="{Binding SelectedPost}" Height="36" Margin="0,4,0,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                                <TextBlock x:Name="delText" Text="Delete Entry" FontSize="12" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2A1B1D"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C2328"/>
                                                    <Setter TargetName="delText" Property="Foreground" Value="#F87171"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ================= TWITTER-STYLE THEATER MODE OVERLAY =================== -->
            <!-- ================= Left: Full Media/Video Player | Right: Tweet Details == -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#F2000000" Visibility="{Binding IsTheaterModeOpen, Converter={StaticResource BoolToVis}}" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- LEFT: MEDIA / VIDEO STAGE (Twitter style) -->
                        <ColumnDefinition Width="380"/>
                        <!-- RIGHT: TWEET DETAILS & ACTIONS -->
                    </Grid.ColumnDefinitions>

                    <!-- Close Button in Theater Mode -->
                    <Button Command="{Binding CloseTheaterModeCommand}" Width="38" Height="38" Margin="16,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#33FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Panel.ZIndex="100">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- ================= LEFT MEDIA STAGE ================= -->
                    <Border Grid.Column="0" Background="#000000" ClipToBounds="True" x:Name="TheaterMediaStage" IsManipulationEnabled="True" ManipulationDelta="TheaterMediaStage_ManipulationDelta" ManipulationCompleted="TheaterMediaStage_ManipulationCompleted" PreviewMouseWheel="TheaterMediaStage_PreviewMouseWheel">
                        <Grid>
                            <!-- IMAGE VIEWER (When media is Image) -->
                            <Border Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource InverseBoolToVis}}" Padding="40">
                                <Image Source="{Binding CurrentTheaterMedia.FilePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- VIDEO PLAYER (When media is Video) -->
                            <Grid Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource BoolToVis}}">
                                <!-- Media Element Video Player with HighQuality rendering -->
                                <MediaElement x:Name="TheaterVideoPlayer" Source="{Binding CurrentTheaterMedia.FilePath}" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseDown="TheaterVideoPlayer_MouseDown" PreviewMouseWheel="TheaterVideoPlayer_PreviewMouseWheel" MediaOpened="TheaterVideoPlayer_MediaOpened" MediaEnded="TheaterVideoPlayer_MediaEnded"/>

                                <!-- Video Floating Glass Control Bar -->
                                <Border Background="#D9161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="24,0,24,24" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="700">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Progress Slider -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Play Controls & Time -->
                                        </Grid.RowDefinitions>

                                        <!-- Progress Slider -->
                                        <Slider x:Name="VideoProgressSlider" Grid.Row="0" Margin="0,0,0,8" Minimum="0" Maximum="100" Value="0" ValueChanged="VideoProgressSlider_ValueChanged" Cursor="Hand"/>

                                        <!-- Play Controls -->
                                        <Grid Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Play / Pause Toggle -->
                                                <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click" Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0" Width="34" Height="34" Cursor="Hand" Margin="0,0,12,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock x:Name="TxtPlayIcon" Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Stop / Rewind -->
                                                <Button Click="BtnStopVideo_Click" Background="#252D38" Foreground="#E7E9EA" BorderThickness="0" Width="34" Height="34" Cursor="Hand" Margin="0,0,14,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="&#xea9f;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Time Label -->
                                                <TextBlock x:Name="TxtVideoTime" Text="00:00 / 00:00" FontSize="12" Foreground="#9EACB9" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Volume / Mute Controls -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="&#xea6c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="VideoVolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VideoVolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Left / Right Carousel Navigation for Multi-Media Tweets -->
                            <Grid Visibility="{Binding HasMultipleTheaterMedia, Converter={StaticResource BoolToVis}}">
                                <!-- Previous Button (Left Arrow) -->
                                <Button Command="{Binding PreviousTheaterMediaCommand}" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="&#xea60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                </Button>

                                <!-- Next Button (Right Arrow) -->
                                <Button Command="{Binding NextTheaterMediaCommand}" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="&#xea61;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Button>

                                <!-- Counter Badge (e.g. 1 / 3) -->
                                <Border Background="#99000000" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                                    <TextBlock Text="{Binding TheaterMediaCounter}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= RIGHT TWEET DETAILS PANEL (Twitter Style) ================= -->
                    <Border Grid.Column="1" Background="#0C1017" BorderBrush="#1C212A" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Top Bar / Close -->
                                <RowDefinition Height="*"/>
                                <!-- Tweet Body & Details -->
                                <RowDefinition Height="Auto"/>
                                <!-- Bottom Actions Bar -->
                            </Grid.RowDefinitions>

                            <!-- Close / Dismiss Header -->
                            <Border Grid.Row="0" Padding="18,14" BorderBrush="#1C212A" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Archived Tweet" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Command="{Binding CloseTheaterModeCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tweet Content & Metadata -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18">
                                <StackPanel>
                                    <!-- Author Header (Avatar, Name, Handle, Folder) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#252D38" BorderBrush="#2F3336" BorderThickness="1">
                                            <TextBlock Text="{Binding TheaterPost.AvatarInitial}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name & Handle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TheaterPost.AuthorName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding TheaterPost.AuthorHandle}" FontSize="13" Foreground="#8B949E" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Folder Badge -->
                                        <Border Grid.Column="2" Background="{StaticResource BadgeBgBrush}" CornerRadius="6" Padding="10,4" BorderBrush="#30363D" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TheaterPost.FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="#9EACB9"/>
                                        </Border>
                                    </Grid>

                                    <!-- Tweet Body Text (Large, Selectable) -->
                                    <emoji:TextBlock Text="{Binding TheaterPost.Content}" FontSize="15" LineHeight="24" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,0,0,16" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                    <!-- Multi-Part Story Navigation in Theater Mode -->
                                    <Border Visibility="{Binding TheaterPost.IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#121820" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="STORY / THREAD PART" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TheaterPost.ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding SelectPreviousLinkedPartCommand}" ToolTip="Jump to Previous Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,5">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="◀ Prev" FontSize="11"/>
                                                </Button>
                                                <Button Grid.Column="2" Command="{Binding SelectNextLinkedPartCommand}" ToolTip="Jump to Next Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,5">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="Next ▶" FontSize="11"/>
                                                </Button>
                                                <Button Grid.Column="4" Command="{Binding OpenThreadReaderCommand}" CommandParameter="{Binding TheaterPost}" Background="#1D2E42" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" Cursor="Hand" Padding="6,5" ToolTip="Read full thread in Thread Reader App format">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="📖" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Reader" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Notes / Comment in Theater (if present) -->
                                    <Border Visibility="{Binding TheaterPost.HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#F0883E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="NOTE / COMMENT" FontSize="10" FontWeight="Bold" Foreground="#F0883E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <emoji:TextBlock Text="{Binding TheaterPost.Comment}" FontSize="12.5" LineHeight="18" Foreground="#F0883E" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Formatted Date Timestamp (Twitter style) -->
                                    <Border BorderBrush="#1C212A" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding TheaterPost.FormattedDate, StringFormat='{}{0} · Local Offline Archive'}" FontSize="12.5" Foreground="#8B949E"/>
                                    </Border>

                                    <!-- Tags Pill Chips -->
                                    <ItemsControl ItemsSource="{Binding TheaterPost.TagList}" Margin="0,0,0,20">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="12" Foreground="#1D9BF0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Archived Comments in Theater Mode (YouTube Aesthetic) -->
                                    <Border Background="#121620" BorderBrush="#252D3D" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,20">
                                        <StackPanel>
                                            <!-- Section Header -->
                                            <Grid Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Archived Comments" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    <Border Background="#1D2E42" CornerRadius="7" Padding="6,1" Margin="8,0,0,0" BorderBrush="#38BDF8" BorderThickness="1">
                                                        <TextBlock Text="{Binding TheaterPost.CommentCount}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Command="{Binding OpenPasteCommentsWindowCommand}" CommandParameter="{Binding TheaterPost}" ToolTip="Paste &amp; Store Comments" Background="#1D2E42" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#38BDF8" Cursor="Hand" Padding="8,4" Margin="0,0,4,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📋 " FontSize="10.5" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Paste" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding QuickPasteClipboardCommentsCommand}" CommandParameter="{Binding TheaterPost}" ToolTip="Quick Paste from Clipboard" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#E7E9EA" Cursor="Hand" Padding="7,4">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Inline Quick Comment Input -->
                                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#10B981" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="💬" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBox Grid.Column="1"
                                                             Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                             FontSize="11.5" CaretBrush="#1D9BF0" VerticalAlignment="Center"
                                                             KeyDown="InlineCommentBox_KeyDown"
                                                             Tag="{Binding TheaterPost}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <VisualBrush AlignmentX="Left" Stretch="None">
                                                                                    <VisualBrush.Visual>
                                                                                        <TextBlock Text="Add a comment (Enter to post)..." Foreground="#6E7681" FontSize="11.5"/>
                                                                                    </VisualBrush.Visual>
                                                                                </VisualBrush>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <Button Grid.Column="2" Click="PostInlineComment_Click" ToolTip="Post Comment"
                                                            Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0"
                                                            Cursor="Hand" Padding="8,3" Margin="4,0,0,0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="Post" FontSize="11" FontWeight="Bold"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Comments List -->
                                            <ItemsControl ItemsSource="{Binding TheaterPost.Comments}" Visibility="{Binding TheaterPost.HasComments, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="0,0,0,8" BorderBrush="#1C212B" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                                        Background="{Binding AvatarBackground, Converter={StaticResource HexToBrush}}"
                                                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding AvatarInitial}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                        <TextBlock Text="{Binding DisplayHandle}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                        <TextBlock Text=" · " FontSize="11" Foreground="#6E7681" Margin="2,0"/>
                                                                        <TextBlock Text="{Binding DisplayTime}" FontSize="10.5" Foreground="#8B949E"/>
                                                                    </StackPanel>

                                                                    <emoji:TextBlock Text="{Binding Content}" FontSize="12" LineHeight="17" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="👍" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding LikeCount}" Visibility="{Binding HasLikes, Converter={StaticResource BoolToVis}}" FontSize="10.5" Foreground="#8B949E" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="👎" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.6"/>
                                                                        <Border Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}" Background="#0E2436" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                                                            <TextBlock Text="{Binding ReplyCount}" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <Button Grid.Column="2"
                                                                        Command="{Binding DataContext.DeleteCommentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Delete comment"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        Foreground="#6E7681" Cursor="Hand" Width="20" Height="20" VerticalAlignment="Top" Opacity="0.5">
                                                                    <TextBlock Text="✕" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Empty state -->
                                            <Border Visibility="{Binding TheaterPost.HasComments, Converter={StaticResource InverseBoolToVis}}" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="No comments archived yet." FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Click 'Paste' to import comments." FontSize="10.5" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Local Disk Directory Path -->
                                    <Border Background="#12161F" CornerRadius="8" Padding="12" BorderBrush="#1C212A" BorderThickness="1" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="LOCAL MEDIA DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TheaterPost.FolderPath}" FontSize="11" Foreground="#9EACB9" TextTrimming="CharacterEllipsis" ToolTip="{Binding TheaterPost.FolderPath}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Action Buttons (Open Folder, Copy Text, Edit, Delete) -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,14">
                                <StackPanel>
                                    <!-- Open Folder Button -->
                                    <Button Style="{StaticResource InspectorActionButton}" Command="{Binding OpenLocalFolderCommand}" CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Local Media Folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy Tweet Text Button -->
                                    <Button Style="{StaticResource InspectorActionButton}" Command="{Binding CopyPostTextCommand}" CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Edit & Delete Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Command="{Binding EditPostCommand}" CommandParameter="{Binding TheaterPost}" Height="36" Background="#212836" Foreground="#E7E9EA" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Edit Post" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Command="{Binding DeletePostCommand}" CommandParameter="{Binding TheaterPost}" Height="36" Background="#332B1818" Foreground="#F87171" BorderBrush="#66DC2626" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
