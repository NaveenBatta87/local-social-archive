<Window x:Class="LocalSocialArchive.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        xmlns:models="clr-namespace:LocalSocialArchive.Models"
        xmlns:converters="clr-namespace:LocalSocialArchive.Converters"
        mc:Ignorable="d"
        Title="Local Social Archive" Height="820" Width="1320"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Foreground="#E7E9EA"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#000000"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#0C1017"/>
        <SolidColorBrush x:Key="RailBgBrush" Color="#080B0F"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2F3336"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#3F464E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1D9BF0"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A8CD8"/>
        <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="#1A3B5C"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7E9EA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7681"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="#21262D"/>
        <SolidColorBrush x:Key="InspectorBgBrush" Color="#0D1117"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#30363D"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#30363D" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#212836"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A3B5C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="⌵" FontSize="11" Foreground="#8B949E"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#45BAEA"/>
                    <Setter TargetName="border" Property="Background" Value="#212836"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="false"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="true"
                                   Focusable="false"
                                   PopupAnimation="Slide">
                                <Border Background="#161B22"
                                        BorderBrush="#2F3336"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer CanContentScroll="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Title Bar Buttons Style -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rail Icon Button Style -->
        <Style x:Key="RailIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Inspector) -->
        <Style x:Key="InspectorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#212836"/>
                                <Setter Property="BorderBrush" Value="#485363"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteFromClipboardCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewPostCommand}"/>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding CreateNewFolderCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CreateNewCollectionCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding NavigateHomeCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFoldersHubCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ShowThreadCanvasCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleInspectorCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshDataCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding CloseTheaterModeCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousTheaterMediaCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextTheaterMediaCommand}"/>
    </Window.InputBindings>

    <!-- Main Container Frame -->
    <Border BorderBrush="#1C212A" BorderThickness="1" Background="{StaticResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/> <!-- Titlebar / Top Header (Spacious) -->
                <RowDefinition Height="*"/>   <!-- Main Content Workspace -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER / TITLEBAR ================= -->
            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/> <!-- Brand / Logo Area -->
                        <ColumnDefinition Width="*"/>   <!-- Search and Quick Actions -->
                        <ColumnDefinition Width="Auto"/> <!-- Window Min/Max/Close Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Logo (Clickable to Home) -->
                    <Button Grid.Column="0" Command="{Binding NavigateHomeCommand}"
                            ToolTip="Home (View All Folders &amp; Archives)"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#1D9BF0" Margin="0,0,12,0">
                                <TextBlock Text="✦" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <TextBlock Text="Local Social Archive" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Top Bar Search & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Search Box (Spacious Rounded) -->
                        <Border Width="280" Height="36" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,12,0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#8B949E"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Foreground="#E7E9EA"
                                         FontSize="12.5" VerticalAlignment="Center" CaretBrush="#1D9BF0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search archived posts..." Foreground="#6E7681" FontSize="12.5"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Quick Paste (Ctrl+V) Button (Spacious Pill) -->
                        <Button Command="{Binding PasteFromClipboardCommand}"
                                Height="36" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#26A7DE" CornerRadius="10" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📥" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quick Paste (Ctrl+V)" FontSize="12.5" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#45BAEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Add Tweet (Ctrl+N) Button (Spacious Pill) -->
                        <Button Command="{Binding CreateNewPostCommand}"
                                Height="36" Margin="0,0,12,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnAddBorder" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="✏️" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add Tweet" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnAddBorder" Property="Background" Value="#212836"/>
                                            <Setter TargetName="btnAddBorder" Property="BorderBrush" Value="#45BAEA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Filter Dropdown (Custom Dark Fluent) -->
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding FilterDropdownOptions}"
                                  SelectedItem="{Binding SelectedFilterDropdownText}"
                                  Height="36" Width="190">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="11" Foreground="#8B949E" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding}" FontSize="12"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Native Vector Window Caption Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Width="10" Height="1" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M 0,0 L 10,0"/>
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="Maximize">
                            <Path Width="10" Height="10" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                        </Button>
                        <!-- Close Button -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" ToolTip="Close">
                            <Path Width="10" Height="10" Stretch="None"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN WORKSPACE (3-PANE LAYOUT) ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="250" MaxWidth="360"/> <!-- Left Sidebar (Spacious) -->
                    <ColumnDefinition Width="*"/>                                   <!-- Center Feed or Folders Hub -->
                    <ColumnDefinition Width="Auto"/>                               <!-- Right Inspector (Collapsible) -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT NAVIGATION SIDEBAR ================= -->
                <Grid Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/> <!-- Slim Vertical Icon Rail -->
                        <ColumnDefinition Width="*"/>  <!-- Navigation Tree & Lists -->
                    </Grid.ColumnDefinitions>

                    <!-- Slim Rail -->
                    <Border Grid.Column="0" Background="{StaticResource RailBgBrush}" BorderBrush="#1C212A" BorderThickness="0,0,1,0">
                        <Grid>
                            <!-- Top Rail Icons -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border Width="34" Height="34" Background="#161B22" CornerRadius="6" Margin="0,0,0,12"
                                        BorderBrush="#1D9BF0" BorderThickness="1">
                                    <TextBlock Text="⚡" Foreground="#1D9BF0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Home Feed Button -->
                                <Button Command="{Binding NavigateHomeCommand}" ToolTip="Home Feed (Ctrl+H)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="False">
                                                    <Setter Property="Background" Value="#161B22"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="🏠" FontSize="14"/>
                                </Button>

                                <!-- Folders Hub Grid Button -->
                                <Button Command="{Binding ShowFoldersHubCommand}" ToolTip="Folders Hub Grid (Ctrl+F)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="📁" FontSize="14"/>
                                </Button>

                                <!-- Word Document Canvas Button -->
                                <Button Command="{Binding ShowThreadCanvasCommand}" ToolTip="Word Document Canvas (Ctrl+T)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCanvasViewActive}" Value="True">
                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="📝" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Add Tweet (Ctrl+N)" Command="{Binding CreateNewPostCommand}">
                                    <TextBlock Text="✏️" FontSize="14"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Quick Paste (Ctrl+V)" Command="{Binding PasteFromClipboardCommand}">
                                    <TextBlock Text="📋" FontSize="14"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Refresh Database (F5)" Command="{Binding RefreshDataCommand}">
                                    <TextBlock Text="🔄" FontSize="14"/>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Rail Icons -->
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Archive Settings &amp; Diagnostics (Ctrl+,)" Command="{Binding OpenSettingsCommand}">
                                    <TextBlock Text="⚙" FontSize="15"/>
                                </Button>
                                <Border Width="28" Height="28" Background="#161B22" CornerRadius="14" ToolTip="Offline ESE Engine Active" Margin="0,4,0,0">
                                    <TextBlock Text="🟢" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Category Tree & Tags -->
                    <Grid Grid.Column="1" Margin="14,14,14,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Global All Posts Button -->
                            <RowDefinition Height="Auto"/> <!-- COLLECTIONS Header with Hub, Add Collection, and Add Folder Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Collections & Folders Accordion List -->
                            <RowDefinition Height="Auto"/> <!-- TAGS Header with Collapse Toggle -->
                            <RowDefinition Height="*"/>    <!-- Tags List -->
                            <RowDefinition Height="Auto"/> <!-- DB Size Indicator -->
                        </Grid.RowDefinitions>

                        <!-- 1. Global "All Posts" Item -->
                        <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="8" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#161B22"/>
                                    <Setter Property="BorderBrush" Value="#2F3336"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFolder.Name}" Value="All Posts">
                                            <Setter Property="Background" Value="#1A3B5C"/>
                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedFolder.Name, Converter={StaticResource InverseBoolToVis}}" Value="False"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#212836"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                            </Border.InputBindings>

                            <Grid Height="36" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="All Posts" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <Border Grid.Column="2" Background="#12161F" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Posts.Count, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#1D9BF0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 2. COLLECTIONS Header (Groups of Folders) -->
                        <Grid Grid.Row="1" Margin="4,4,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="COLLECTIONS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center"/>

                            <!-- Hub Grid View Button -->
                            <Button Grid.Column="1" Command="{Binding ShowFoldersHubCommand}"
                                    ToolTip="Open Collections Hub Grid (Ctrl+F)"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Width="22" Height="22" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="⊞" FontSize="11" Foreground="#8B949E"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#212836"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#1D9BF0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Add Collection Button -->
                            <Button Grid.Column="2" Command="{Binding CreateNewCollectionCommand}"
                                    ToolTip="Add New Collection (Ctrl+Shift+C)"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Width="22" Height="22" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="🗂️+" FontSize="10" Foreground="#1D9BF0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#212836"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#1D9BF0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Add Folder Button -->
                            <Button Grid.Column="3" Command="{Binding CreateNewFolderCommand}"
                                    ToolTip="Add Folder to Collection (Ctrl+Shift+N)"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Width="22" Height="22">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#1D9BF0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#212836"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#1D9BF0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- 3. Collections Accordion (Each contains Folders) -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3,0,6">
                                        <!-- Collection Header Row (Spacious & Clean) -->
                                        <Border Background="#12161F" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/> <!-- Expand/Collapse Arrow -->
                                                    <ColumnDefinition Width="22"/> <!-- Collection Icon -->
                                                    <ColumnDefinition Width="*"/>  <!-- Collection Name -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Folder Count -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Add Folder to this collection -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Delete Collection -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Expand/Collapse Button -->
                                                <Button Grid.Column="0"
                                                        Command="{Binding DataContext.ToggleCollectionExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="18" Height="18">
                                                    <TextBlock FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▾"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                        <Setter Property="Text" Value="▸"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <!-- Collection Icon -->
                                                <TextBlock Grid.Column="1" Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                <!-- Collection Name -->
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="#E7E9EA" VerticalAlignment="Center" Margin="2,0,4,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Folder Count Badge -->
                                                <Border Grid.Column="3" Background="#161B22" CornerRadius="6" Padding="6,2" Margin="4,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FolderCount, StringFormat='{}{0}f'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                </Border>

                                                <!-- Add Folder to this Collection (+) -->
                                                <Button Grid.Column="4"
                                                        Command="{Binding DataContext.CreateNewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Add Folder to this Collection"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="2,0,0,0">
                                                    <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#1D9BF0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Delete Collection Button (If deletable) -->
                                                <Button Grid.Column="5"
                                                        Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Delete Collection"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="2,0,0,0">
                                                    <TextBlock Text="✕" FontSize="9.5" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Nested Folders List (Visible when Collection is Expanded) -->
                                        <ItemsControl ItemsSource="{Binding Folders}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                      Margin="14,3,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" CornerRadius="8" Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="#161B22"/>
                                                                        <Setter Property="BorderBrush" Value="#2F3336"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="#12161F"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>

                                                        <Grid Height="32" Margin="8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Folder Icon -->
                                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>

                                                            <!-- Folder Name -->
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#C9D1D9"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Post Count Badge -->
                                                            <Border Grid.Column="2" Background="#0C1017" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                            </Border>

                                                            <!-- Delete Folder Button -->
                                                            <Button Grid.Column="3"
                                                                    Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Delete Folder"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Width="20" Height="20" Margin="4,0,0,0">
                                                                <TextBlock Text="✕" FontSize="9.5" FontWeight="Bold" Foreground="#6E7681"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- TAGS Section Header with Hide/Show Toggle -->
                        <Grid Grid.Row="3" Margin="4,16,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TAGS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding ToggleTagsCommand}"
                                    ToolTip="Toggle Tags Visibility"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Width="22" Height="22">
                                <TextBlock FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="▲"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTagsVisible}" Value="False">
                                                    <Setter Property="Text" Value="▼"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- Tags List (Collapsible) -->
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsTagsVisible, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,1" CornerRadius="6" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#1A222D"/>
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="#12161F"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>

                                            <Grid Height="30" Margin="8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- DB Size Indicator -->
                        <Border Grid.Row="5" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#1C212A" BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗄️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DatabaseSizeText}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= CENTER MAIN STAGE (POSTS FEED OR FOLDERS HUB) ================= -->
                <Border Grid.Column="1" Background="#000000" BorderBrush="#1C212A" BorderThickness="1,0,1,0">
                    <Grid>
                        <!-- ================================================================= -->
                        <!-- VIEW A: REGULAR POSTS FEED (List View / Grid View) =============== -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCanvasViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Feed Toolbar (Title, View Switcher, Inspector Toggle) -->
                                <RowDefinition Height="*"/>    <!-- Feed Items (List or Grid View) -->
                                <RowDefinition Height="Auto"/> <!-- Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- FEED TOOLBAR / VIEW MODE SWITCHER & INSPECTOR TOGGLE (Spacious) -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="22,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active Filter & Count -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedFolder.Name, FallbackValue='All Posts'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='{}{0} archived posts'}" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right Actions: [ ☰ List | ⊞ Grid ] and [ ◨ Inspector ] -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- View Mode Switcher [ ☰ List | ⊞ Grid ] -->
                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- List View Button -->
                                                <Button Command="{Binding SetListViewCommand}" ToolTip="List View (Full Timeline)"
                                                        Padding="14,6" BorderThickness="0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                                    <Setter Property="Background" Value="#1D9BF0"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="7"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="☰" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="List" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Grid View Button -->
                                                <Button Command="{Binding SetGridViewCommand}" ToolTip="Grid View (Tile Cards)"
                                                        Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                                    <Setter Property="Background" Value="#1D9BF0"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="7"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⊞" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Grid" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Inspector Panel Toggle Button -->
                                        <Button Command="{Binding ToggleInspectorCommand}"
                                                ToolTip="Toggle Inspector Panel (Ctrl+I)"
                                                Padding="12,6" BorderThickness="1" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#161B22"/>
                                                    <Setter Property="BorderBrush" Value="#2F3336"/>
                                                    <Setter Property="Foreground" Value="#8B949E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInspectorVisible}" Value="True">
                                                            <Setter Property="Background" Value="#1A3B5C"/>
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="◨" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Inspector" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= 1. LIST VIEW (Full Width Timeline Cards) ================= -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding FilteredPosts}"
                                      SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
                                      Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="24,18"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      MouseDoubleClick="FeedListView_MouseDoubleClick">
                                
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,16"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <Border CornerRadius="18" Background="{StaticResource CardBgBrush}"
                                                BorderThickness="1" Padding="20" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Header -->
                                                    <RowDefinition Height="Auto"/> <!-- Body Text -->
                                                    <RowDefinition Height="Auto"/> <!-- Media Previews Grid -->
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/> <!-- Avatar -->
                                                        <ColumnDefinition Width="*"/>  <!-- Names & Date -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Folder Badge -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar Circle -->
                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                                            Background="#252D38" BorderBrush="#2F3336" BorderThickness="1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="14" FontWeight="Bold"
                                                                   Foreground="#E7E9EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name, Handle & Timestamp -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👤 " FontSize="10" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AuthorName}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding AuthorHandle}" FontSize="12" Foreground="#8B949E"/>
                                                            <TextBlock Text=" • " FontSize="12" Foreground="#8B949E"/>
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="12" Foreground="#8B949E"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Folder Badge & Theater Shortcut -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="8"
                                                                Padding="12,4" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#9EACB9"/>
                                                        </Border>
                                                        <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Open Split Theater View"
                                                                Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" Cursor="Hand" Width="28" Height="28">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="⤢" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tweet Content Text -->
                                                <TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="14.5" LineHeight="21"
                                                           Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,12,0,12"/>

                                                <!-- Attached Media Preview Grids -->
                                                <Grid Grid.Row="2" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                    <!-- Single Image / Video Preview -->
                                                    <Border Visibility="{Binding HasSingleMedia, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="14" Background="#0C1017" ClipToBounds="True" MaxHeight="320" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Image Source="{Binding PrimaryImage}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                            <!-- Video Play Overlay Badge -->
                                                            <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}"
                                                                    Background="#CC000000" CornerRadius="22" Width="44" Height="44"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Dual Images Layout -->
                                                    <Grid Visibility="{Binding HasTwoMedia, Converter={StaticResource BoolToVis}}" Height="200" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Margin="4,0,0,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 3+ Images Layout -->
                                                    <Grid Visibility="{Binding HasThreeOrMoreMedia, Converter={StaticResource BoolToVis}}" Height="240" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                                          Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,3,3,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding ThirdImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Margin="3,3,0,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding FourthImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- ================= 2. GRID VIEW (Card Tiles Multi-Column Layout - Spacious & Rounded) ================= -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{Binding FilteredPosts}"
                                      SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
                                      Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="24,20"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True"
                                      MouseDoubleClick="FeedListView_MouseDoubleClick">

                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,22,22"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <!-- Spacious & Smoothly Rounded Tile Card -->
                                        <Border Width="330" MinHeight="340" CornerRadius="18" Background="#161B22"
                                                BorderThickness="1" Cursor="Hand" ClipToBounds="False">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#252D38"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="#45BAEA"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Media Capsule or Folder Header -->
                                                    <RowDefinition Height="Auto"/> <!-- Author Row -->
                                                    <RowDefinition Height="*"/>    <!-- Text Content -->
                                                    <RowDefinition Height="Auto"/> <!-- Bottom Row -->
                                                </Grid.RowDefinitions>

                                                <!-- 1A. Inset Floating Rounded Media Capsule (When Post HAS Media) -->
                                                <Border Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"
                                                        Height="165" Margin="14,14,14,10" CornerRadius="14" Background="#0A0D13" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Image Preview -->
                                                        <Image Source="{Binding PrimaryImage}" Stretch="UniformToFill"/>

                                                        <!-- Video Play Overlay Badge -->
                                                        <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}"
                                                                Background="#CC000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                                CornerRadius="20" Width="40" Height="40"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </Border>

                                                        <!-- Folder Pill Badge (Top-Right) -->
                                                        <Border Background="#E60A0D13" CornerRadius="8" Padding="8,3"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                        </Border>

                                                        <!-- Media Counter Pill Badge (Top-Left if > 1) -->
                                                        <Border Visibility="{Binding HasMultipleMedia, Converter={StaticResource BoolToVis}}"
                                                                Background="#CC0A0D13" CornerRadius="8" Padding="8,3"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                            <TextBlock Text="{Binding MediaCount, StringFormat='📷 {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 1B. Top Folder Pill (When Post has NO Media) -->
                                                <Grid Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}" Margin="16,14,16,6">
                                                    <Border Background="#1C2430" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding FolderName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                    </Border>
                                                </Grid>

                                                <!-- 2. Author Header Row -->
                                                <Grid Grid.Row="1" Margin="16,4,16,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#212836" BorderBrush="#2F3336" BorderThickness="1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding AuthorName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AuthorHandle}" FontSize="11" Foreground="#8B949E" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 3. Text Content -->
                                                <TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="12.5" LineHeight="18" Foreground="#C9D1D9"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                                                           Margin="16,0,16,12"/>

                                                <!-- 4. Bottom Row (Relative Time & View Button) -->
                                                <Border Grid.Row="3" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,10" Background="#11151C" CornerRadius="0,0,18,18">
                                                    <Grid>
                                                        <TextBlock Text="{Binding RelativeTime}" FontSize="11.5" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Open Theater View"
                                                                HorizontalAlignment="Right" Background="#1A3B5C" Foreground="#1D9BF0"
                                                                Padding="10,4" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="⤢ View" FontSize="11.5" FontWeight="SemiBold"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Status Bar -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="14,6">
                                <Grid>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='Showing {0} entries'}" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW B: COLLECTIONS HUB (Visual Grid of Collections & Folders) === -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="True"/>
                                                <Condition Binding="{Binding IsCanvasViewActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Hub Header & Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Grid of Collections -->
                                <RowDefinition Height="Auto"/> <!-- Hub Bottom Status -->
                            </Grid.RowDefinitions>

                            <!-- Collections Hub Header Bar -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🗂️ Collections Hub — Collections of Folders" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <Border Background="#1A3B5C" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Collections.Count, StringFormat='{}{0} Collections'}" FontSize="11" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                            </Border>
                                            <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Posts.Count, StringFormat='{}{0} Total Posts'}" FontSize="11" Foreground="#8B949E"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Top-level collections grouping your categorized folders and offline archives" FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Add Collection Button -->
                                        <Button Command="{Binding CreateNewCollectionCommand}"
                                                Padding="12,7" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1"
                                                FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗂️+" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Collection" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Add Folder Button -->
                                        <Button Command="{Binding CreateNewFolderCommand}"
                                                Padding="12,7" Background="#1D9BF0" Foreground="#FFFFFF" FontWeight="SemiBold"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Folder" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Back to Feed Button -->
                                        <Button Command="{Binding NavigateHomeCommand}"
                                                Padding="12,7" Background="#161B22" Foreground="#E7E9EA" BorderBrush="#2F3336" BorderThickness="1"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⤺" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="View Feed" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Collections Cards Visual Grid -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <ItemsControl ItemsSource="{Binding Collections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="360" MinHeight="290" CornerRadius="12" Background="#161B22"
                                                    BorderBrush="#2F3336" BorderThickness="1" Margin="0,0,18,18" Padding="18">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/> <!-- Collection Header (Icon, Title, Badges) -->
                                                        <RowDefinition Height="Auto"/> <!-- Collection Description -->
                                                        <RowDefinition Height="*"/>    <!-- Contained Folders List -->
                                                        <RowDefinition Height="Auto"/> <!-- Collection Footer -->
                                                    </Grid.RowDefinitions>

                                                    <!-- 1. Collection Header -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Colored Icon Circle -->
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                                                Background="#212836" BorderBrush="#2F3336" BorderThickness="1">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="18"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Name & Counts -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding FolderCount, StringFormat='{}{0} folders'}" FontSize="11" Foreground="#1D9BF0" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" • " FontSize="11" Foreground="#6E7681"/>
                                                                <TextBlock Text="{Binding TotalPostsCount, StringFormat='{}{0} total posts'}" FontSize="11" Foreground="#8B949E"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Delete Collection (if custom) -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Delete Collection"
                                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                Width="24" Height="24" VerticalAlignment="Top">
                                                            <TextBlock Text="✕" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 2. Collection Description -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#8B949E"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                                                    <!-- 3. Folders Contained in this Collection -->
                                                    <Border Grid.Row="2" Background="#0C1017" BorderBrush="#21262D" BorderThickness="1"
                                                            CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <TextBlock Text="FOLDERS IN THIS COLLECTION" FontSize="10.5" FontWeight="Bold" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                                <Button Content="+ Add Folder"
                                                                        Command="{Binding DataContext.CreateNewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalAlignment="Right" Padding="6,2"
                                                                        Background="Transparent" Foreground="#1D9BF0" FontSize="11" FontWeight="SemiBold"
                                                                        BorderThickness="0" Cursor="Hand"/>
                                                            </Grid>

                                                            <!-- Folders List -->
                                                            <ItemsControl ItemsSource="{Binding Folders}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1"
                                                                                CornerRadius="6" Padding="10,7" Margin="0,0,0,6" Cursor="Hand">
                                                                            <Border.InputBindings>
                                                                                <MouseBinding MouseAction="LeftClick"
                                                                                              Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              CommandParameter="{Binding}"/>
                                                                            </Border.InputBindings>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Folder Icon & Name -->
                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center"/>

                                                                                <!-- Post Count -->
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} posts'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                                <!-- Browse Button -->
                                                                                <Button Grid.Row="0" Grid.Column="3" Content="Browse →"
                                                                                        Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        CommandParameter="{Binding}"
                                                                                        Background="#212836" Foreground="#1D9BF0" FontSize="11" FontWeight="SemiBold"
                                                                                        Padding="8,3" BorderThickness="0" Cursor="Hand">
                                                                                    <Button.Resources>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                                        </Style>
                                                                                    </Button.Resources>
                                                                                </Button>

                                                                                <!-- Thumbnail Previews (if any) -->
                                                                                <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" CornerRadius="4" ClipToBounds="True"
                                                                                        Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                                                                                    <Grid Height="46">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Image Grid.Column="0" Source="{Binding FirstThumbnail}" Stretch="UniformToFill" Margin="0,0,2,0"/>
                                                                                        <Image Grid.Column="1" Source="{Binding SecondThumbnail}" Stretch="UniformToFill" Margin="1,0,1,0"/>
                                                                                        <Image Grid.Column="2" Source="{Binding ThirdThumbnail}" Stretch="UniformToFill" Margin="2,0,0,0"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 4. Card Bottom Bar -->
                                                    <TextBlock Grid.Row="3" Text="{Binding FolderCount, StringFormat='Collection contains {0} folders'}"
                                                               FontSize="11" Foreground="#6E7681"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Hub Bottom Status -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid>
                                    <TextBlock Text="Each Collection groups multiple folders. Click any folder to view its archived posts." FontSize="11.5" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding Collections.Count, StringFormat='Total Collections: {0}'}" FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW C: MICROSOFT WORD DOCUMENT CANVAS (Rich Text & Media Studio) -->
                        <!-- ================================================================= -->
                        <Grid Visibility="{Binding IsCanvasViewActive, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Word Ribbon / Toolbar -->
                                <RowDefinition Height="*"/>    <!-- Word Document Paper Canvas (Desk & Sheet) -->
                                <RowDefinition Height="Auto"/> <!-- Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- 1. Word Ribbon Toolbar -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 1: Document Metadata & Primary Archive Action -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Word Canvas Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Border Background="#1A3B5C" CornerRadius="6" Padding="10,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📝 " FontSize="14"/>
                                                    <TextBlock Text="Word Document Canvas" FontSize="13.5" FontWeight="Bold" Foreground="#1D9BF0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Center: Title and Target Folder Selector -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Document Title Input -->
                                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Title: " FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CanvasThreadTitle, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"
                                                             VerticalAlignment="Center" CaretBrush="#1D9BF0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Target Folder Input -->
                                            <Border Grid.Column="1" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="📁 " FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CanvasSelectedFolder, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Foreground="#1D9BF0" FontSize="12" FontWeight="SemiBold"
                                                             VerticalAlignment="Center" CaretBrush="#1D9BF0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Right: Save & Clear Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Save & Archive Button -->
                                            <Button Click="BtnArchiveDoc_Click" ToolTip="Save Document &amp; All Embedded Media to Database"
                                                    Padding="14,7" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold"
                                                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾 " FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Save &amp; Archive Post" FontSize="12.5" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Clear Document Button -->
                                            <Button Click="BtnClearDoc_Click" ToolTip="Clear Document Canvas"
                                                    Padding="10,7" Background="#211212" Foreground="#F87171" BorderBrush="#3B1C1C" BorderThickness="1"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6"/>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="🧹 Clear" FontSize="12" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Formatting Toolbar (Bold, Italic, Underline, Bullets, Images, GIFs, Videos, Paste) -->
                                    <Border Grid.Row="1" Background="#12161F" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Text Formatting Group (Standard Word commands) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Bold -->
                                                <Button Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=DocRichTextBox}"
                                                        ToolTip="Bold (Ctrl+B)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF"
                                                        BorderBrush="#2F3336" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="B" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Italic -->
                                                <Button Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=DocRichTextBox}"
                                                        ToolTip="Italic (Ctrl+I)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF"
                                                        BorderBrush="#2F3336" BorderThickness="1" FontStyle="Italic" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Underline -->
                                                <Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=DocRichTextBox}"
                                                        ToolTip="Underline (Ctrl+U)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF"
                                                        BorderBrush="#2F3336" BorderThickness="1" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Bullets -->
                                                <Button Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=DocRichTextBox}"
                                                        ToolTip="Bullet List" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF"
                                                        BorderBrush="#2F3336" BorderThickness="1" FontSize="13" Cursor="Hand" Margin="0,0,8,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="•≡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Rectangle Grid.Column="1" Width="1" Fill="#2F3336" Margin="4,3,10,3"/>

                                            <!-- Media Insert Buttons Group -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Insert Image / GIF -->
                                                <Button Click="BtnInsertImage_Click" ToolTip="Insert Image or GIF from disk"
                                                        Padding="10,4" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🖼️ " FontSize="12"/>
                                                        <TextBlock Text="Image / GIF" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Insert Video -->
                                                <Button Click="BtnInsertVideo_Click" ToolTip="Insert Video (.mp4 / .webm) from disk"
                                                        Padding="10,4" Background="#161B22" Foreground="#8B5CF6" BorderBrush="#2F3336" BorderThickness="1"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🎥 " FontSize="12"/>
                                                        <TextBlock Text="Video" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Paste into Canvas (Ctrl+V) -->
                                                <Button Click="BtnPasteIntoDoc_Click" ToolTip="Paste text, image, or GIF directly from clipboard"
                                                        Padding="10,4" Background="#1A3B5C" Foreground="#1D9BF0" BorderBrush="#1D9BF0" BorderThickness="1"
                                                        Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📋 " FontSize="12"/>
                                                        <TextBlock Text="Paste (Ctrl+V)" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Author & Tags Inline Configuration (Right side of ribbon) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Author: " FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding CanvasDefaultAuthor, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" FontSize="11.5" MinWidth="85" CaretBrush="#1D9BF0"/>
                                                </Border>

                                                <TextBlock Text="Tags: " FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBox Text="{Binding CanvasDefaultTags, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Foreground="#9EACB9" FontSize="11.5" MinWidth="100" CaretBrush="#1D9BF0"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 2. Word Document Desk & Page Canvas -->
                            <ScrollViewer Grid.Row="1" Background="#0C1017" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,24">
                                <!-- Microsoft Word "Page Sheet" (Crisp elevated container) -->
                                <Border MaxWidth="860" MinHeight="720" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10"
                                        Margin="0,0,0,40">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
                                    </Border.Effect>
                                    
                                    <!-- Rich Document Canvas -->
                                    <RichTextBox x:Name="DocRichTextBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#E7E9EA"
                                                 CaretBrush="#1D9BF0"
                                                 FontSize="14.5"
                                                 FontFamily="Segoe UI, Segoe UI Emoji, Arial"
                                                 Padding="32,28"
                                                 AcceptsTab="True"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True">
                                        <FlowDocument PagePadding="0" FontFamily="Segoe UI, Segoe UI Emoji, Arial" FontSize="14.5" Foreground="#E7E9EA">
                                            <Paragraph Margin="0,0,0,10">
                                                <Run Text=""/>
                                            </Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                </Border>
                            </ScrollViewer>

                            <!-- 3. Bottom Status Bar -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid>
                                    <TextBlock Text="💡 Word Canvas: Supports rich formatted text, inline images, animated GIFs, and videos. Click 'Save &amp; Archive Post' to store offline."
                                               FontSize="11.5" Foreground="#8B949E"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Offline ESE Windows Engine" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= RIGHT INSPECTOR PANEL (COLLAPSIBLE) ================= -->
                <Grid Grid.Column="2" Width="330" Background="{StaticResource InspectorBgBrush}"
                      Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}">
                    
                    <!-- 1. EMPTY STATE (When NO post is selected) -->
                    <Border Visibility="{Binding SelectedPost, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✦" FontSize="36" Foreground="#2F3336" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Select a post to inspect details" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. SELECTED POST INSPECTOR CONTENT -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SelectedPost, Converter={StaticResource NullToVis}}"
                                  Padding="20,18">
                        <StackPanel>
                            <!-- Panel Title, Theater Mode Button, and Close Button -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Post Inspector" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenTheaterModeCommand}"
                                            CommandParameter="{Binding SelectedPost}"
                                            Padding="10,4" Margin="0,0,8,0"
                                            Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⤢" FontSize="11" Margin="0,0,4,0"/>
                                            <TextBlock Text="Theater" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Close Inspector Button -->
                                    <Button Command="{Binding CloseInspectorCommand}" ToolTip="Close Inspector Panel"
                                            Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                                            Cursor="Hand" Width="26" Height="26">
                                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Details Table -->
                            <!-- 1. Author -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Author" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedPost.AuthorName}" FontSize="13" FontWeight="SemiBold" Foreground="#E7E9EA"/>
                                    <TextBlock Text="{Binding SelectedPost.AuthorHandle, StringFormat='({0})'}" FontSize="12" Foreground="#8B949E"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Date -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FormattedDate}" FontSize="12.5" Foreground="#E7E9EA" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 3. Local Path -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Local Path" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FolderPath}" FontSize="11" Foreground="#9EACB9"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPost.FolderPath}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 4. Tags List -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tags" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedPost.TagList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1"
                                                    CornerRadius="6" Padding="8,3" Margin="0,0,6,6" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.FilterByTagStringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" Foreground="#9EACB9"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,10,0,0">
                                <!-- Open Theater Button (Cyan) -->
                                <Button Style="{StaticResource InspectorActionButton}"
                                        Command="{Binding OpenTheaterModeCommand}"
                                        CommandParameter="{Binding SelectedPost}"
                                        Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⤢ " FontSize="13"/>
                                        <TextBlock Text="Open Split Media View"/>
                                    </StackPanel>
                                </Button>

                                <!-- Open Local Folder Button -->
                                <Button Style="{StaticResource InspectorActionButton}"
                                        Command="{Binding OpenLocalFolderCommand}"
                                        CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁 " FontSize="13"/>
                                        <TextBlock Text="Open Local Folder"/>
                                    </StackPanel>
                                </Button>

                                <!-- Edit Post Content Button -->
                                <Button Style="{StaticResource InspectorActionButton}"
                                        Command="{Binding EditPostCommand}"
                                        CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✏️ " FontSize="12"/>
                                        <TextBlock Text="Edit Post Content"/>
                                    </StackPanel>
                                </Button>

                                <!-- Delete Entry Button (Red) -->
                                <Button Command="{Binding DeletePostCommand}"
                                        CommandParameter="{Binding SelectedPost}"
                                        Height="40" Margin="0,6,0,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🗑️ " FontSize="12" Foreground="#F87171"/>
                                                    <TextBlock Text="Delete Entry" FontSize="13" FontWeight="SemiBold" Foreground="#F87171"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#332B1818"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#66DC2626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ================= TWITTER-STYLE THEATER MODE OVERLAY =================== -->
            <!-- ================= Left: Full Media/Video Player | Right: Tweet Details == -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#F2000000"
                    Visibility="{Binding IsTheaterModeOpen, Converter={StaticResource BoolToVis}}"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- LEFT: MEDIA / VIDEO STAGE (Twitter style) -->
                        <ColumnDefinition Width="380"/> <!-- RIGHT: TWEET DETAILS & ACTIONS -->
                    </Grid.ColumnDefinitions>

                    <!-- Close Button in Theater Mode -->
                    <Button Command="{Binding CloseTheaterModeCommand}"
                            Width="38" Height="38" Margin="16,16,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#33FFFFFF" Foreground="#FFFFFF" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Cursor="Hand" Panel.ZIndex="100">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- ================= LEFT MEDIA STAGE ================= -->
                    <Border Grid.Column="0" Background="#000000" ClipToBounds="True">
                        <Grid>
                            <!-- IMAGE VIEWER (When media is Image) -->
                            <Border Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource InverseBoolToVis}}"
                                    Padding="40">
                                <Image Source="{Binding CurrentTheaterMedia.FilePath}"
                                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- VIDEO PLAYER (When media is Video) -->
                            <Grid Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource BoolToVis}}">
                                <!-- Media Element Video Player -->
                                <MediaElement x:Name="TheaterVideoPlayer"
                                              Source="{Binding CurrentTheaterMedia.FilePath}"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Close"
                                              ScrubbingEnabled="True"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              MediaOpened="TheaterVideoPlayer_MediaOpened"
                                              MediaEnded="TheaterVideoPlayer_MediaEnded"/>

                                <!-- Video Floating Glass Control Bar -->
                                <Border Background="#D9161B22" BorderBrush="#2F3336" BorderThickness="1"
                                        CornerRadius="12" Padding="16,10" Margin="24,0,24,24"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="700">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Progress Slider -->
                                            <RowDefinition Height="Auto"/> <!-- Play Controls & Time -->
                                        </Grid.RowDefinitions>

                                        <!-- Progress Slider -->
                                        <Slider x:Name="VideoProgressSlider" Grid.Row="0" Margin="0,0,0,8"
                                                Minimum="0" Maximum="100" Value="0"
                                                ValueChanged="VideoProgressSlider_ValueChanged"
                                                Cursor="Hand"/>

                                        <!-- Play Controls -->
                                        <Grid Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Play / Pause Toggle -->
                                                <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click"
                                                        Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0"
                                                        Width="34" Height="34" Cursor="Hand" Margin="0,0,12,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock x:Name="TxtPlayIcon" Text="▶" FontSize="13" Margin="2,0,0,0"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Stop / Rewind -->
                                                <Button Click="BtnStopVideo_Click"
                                                        Background="#252D38" Foreground="#E7E9EA" BorderThickness="0"
                                                        Width="34" Height="34" Cursor="Hand" Margin="0,0,14,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="⏹" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Time Label -->
                                                <TextBlock x:Name="TxtVideoTime" Text="00:00 / 00:00" FontSize="12" Foreground="#9EACB9" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Volume / Mute Controls -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="🔊" FontSize="12" Foreground="#8B949E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="VideoVolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8"
                                                        ValueChanged="VideoVolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Left / Right Carousel Navigation for Multi-Media Tweets -->
                            <Grid Visibility="{Binding HasMultipleTheaterMedia, Converter={StaticResource BoolToVis}}">
                                <!-- Previous Button (Left Arrow) -->
                                <Button Command="{Binding PreviousTheaterMediaCommand}"
                                        Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="16,0,0,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0"
                                        FontSize="18" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="◀" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                </Button>

                                <!-- Next Button (Right Arrow) -->
                                <Button Command="{Binding NextTheaterMediaCommand}"
                                        Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,16,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0"
                                        FontSize="18" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Button>

                                <!-- Counter Badge (e.g. 1 / 3) -->
                                <Border Background="#99000000" CornerRadius="12" Padding="12,4"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                                    <TextBlock Text="{Binding TheaterMediaCounter}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= RIGHT TWEET DETAILS PANEL (Twitter Style) ================= -->
                    <Border Grid.Column="1" Background="#0C1017" BorderBrush="#1C212A" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Top Bar / Close -->
                                <RowDefinition Height="*"/>   <!-- Tweet Body & Details -->
                                <RowDefinition Height="Auto"/> <!-- Bottom Actions Bar -->
                            </Grid.RowDefinitions>

                            <!-- Close / Dismiss Header -->
                            <Border Grid.Row="0" Padding="18,14" BorderBrush="#1C212A" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Archived Tweet" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Command="{Binding CloseTheaterModeCommand}"
                                            HorizontalAlignment="Right" Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                                            FontSize="14" FontWeight="Bold" Cursor="Hand">
                                        <TextBlock Text="✕"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tweet Content & Metadata -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18">
                                <StackPanel>
                                    <!-- Author Header (Avatar, Name, Handle, Folder) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                                Background="#252D38" BorderBrush="#2F3336" BorderThickness="1">
                                            <TextBlock Text="{Binding TheaterPost.AvatarInitial}" FontSize="16" FontWeight="Bold"
                                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name & Handle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TheaterPost.AuthorName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding TheaterPost.AuthorHandle}" FontSize="13" Foreground="#8B949E" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Folder Badge -->
                                        <Border Grid.Column="2" Background="{StaticResource BadgeBgBrush}" CornerRadius="6"
                                                Padding="10,4" BorderBrush="#30363D" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TheaterPost.FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="#9EACB9"/>
                                        </Border>
                                    </Grid>

                                    <!-- Tweet Body Text (Large, Selectable) -->
                                    <TextBlock Text="{Binding TheaterPost.Content}"
                                               FontSize="15" LineHeight="24" Foreground="#E7E9EA"
                                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                                    <!-- Formatted Date Timestamp (Twitter style) -->
                                    <Border BorderBrush="#1C212A" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding TheaterPost.FormattedDate, StringFormat='{}{0} · Local Offline Archive'}"
                                                   FontSize="12.5" Foreground="#8B949E"/>
                                    </Border>

                                    <!-- Tags Pill Chips -->
                                    <ItemsControl ItemsSource="{Binding TheaterPost.TagList}" Margin="0,0,0,20">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="12" Foreground="#1D9BF0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Local Disk Directory Path -->
                                    <Border Background="#12161F" CornerRadius="8" Padding="12" BorderBrush="#1C212A" BorderThickness="1" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="LOCAL MEDIA DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TheaterPost.FolderPath}" FontSize="11" Foreground="#9EACB9"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TheaterPost.FolderPath}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Action Buttons (Open Folder, Copy Text, Edit, Delete) -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,14">
                                <StackPanel>
                                    <!-- Open Folder Button -->
                                    <Button Style="{StaticResource InspectorActionButton}"
                                            Command="{Binding OpenLocalFolderCommand}"
                                            CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📁 " FontSize="13"/>
                                            <TextBlock Text="Open Local Media Folder"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy Tweet Text Button -->
                                    <Button Style="{StaticResource InspectorActionButton}"
                                            Command="{Binding CopyPostTextCommand}"
                                            CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋 " FontSize="13"/>
                                            <TextBlock Text="Copy Tweet Text"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Edit & Delete Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Content="Edit Post"
                                                Command="{Binding EditPostCommand}"
                                                CommandParameter="{Binding TheaterPost}"
                                                Height="36" Background="#212836" Foreground="#E7E9EA"
                                                BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Grid.Column="2" Content="Delete"
                                                Command="{Binding DeletePostCommand}"
                                                CommandParameter="{Binding TheaterPost}"
                                                Height="36" Background="#332B1818" Foreground="#F87171"
                                                BorderBrush="#66DC2626" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
