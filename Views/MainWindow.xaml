<Window x:Class="LocalSocialArchive.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
    xmlns:models="clr-namespace:LocalSocialArchive.Models"
    xmlns:converters="clr-namespace:LocalSocialArchive.Converters"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf" mc:Ignorable="d" Title="Local Social Archive" Height="820" Width="1320" MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#E7E9EA" FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Curated Slate Palette (Matching Mockup) -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#090D13"/>
        <SolidColorBrush x:Key="RailBgBrush" Color="#06090E"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#21262D"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1D9BF0"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A8CD8"/>
        <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="#1A3B5C"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7E9EA"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7681"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="#21262D"/>
        <SolidColorBrush x:Key="InspectorBgBrush" Color="#090D13"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#30363D"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#30363D" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#212836"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A3B5C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="⌵" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#45BAEA"/>
                    <Setter TargetName="border" Property="Background" Value="#212836"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="false" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="true" Focusable="false" PopupAnimation="Slide">
                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Padding="4" Margin="0,4,0,0">
                                    <ScrollViewer CanContentScroll="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Title Bar Buttons Style -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rail Icon Button Style -->
        <Style x:Key="RailIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Inspector) -->
        <Style x:Key="InspectorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21262D"/>
                                <Setter Property="BorderBrush" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeletePostCommand}" CommandParameter="{Binding SelectedPost}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteFromClipboardCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewPostCommand}"/>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding CreateNewFolderCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CreateNewCollectionCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding NavigateHomeCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFoldersHubCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ShowThreadCanvasCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleInspectorCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockVaultCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshDataCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding CloseTheaterModeCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousTheaterMediaCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextTheaterMediaCommand}"/>
    </Window.InputBindings>

    <!-- Main Container Frame -->
    <Border BorderBrush="#21262D" BorderThickness="1" Background="{StaticResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <!-- Titlebar / Top Header (Spacious) -->
                <RowDefinition Height="*"/>
                <!-- Main Content Workspace -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER / TITLEBAR ================= -->
            <Border Grid.Row="0" Background="#0A0E14" BorderBrush="#21262D" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <!-- Brand / Logo Area -->
                        <ColumnDefinition Width="*"/>
                        <!-- Search and Quick Actions -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Window Min/Max/Close Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Logo (Clickable to Home) -->
                    <Button Grid.Column="0" Command="{Binding NavigateHomeCommand}" ToolTip="Home (View All Folders &amp; Archives)" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="8" Background="#1D9BF0" Margin="0,0,12,0">
                                <TextBlock Text="✦" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <TextBlock Text="Local Social Archive" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Top Bar Search & Actions -->
                    <Grid Grid.Column="1" Margin="8,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Search (fills available space) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Compact Action Buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Search Box (Pill-shaped, expands smoothly) -->
                        <Border Grid.Column="0" Height="36" Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="18" Margin="0,0,10,0">
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xEA6D;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#6E7681" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" FontSize="12.5" VerticalAlignment="Center" CaretBrush="#1D9BF0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search..." Foreground="#6E7681" FontSize="12.5"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchQuery, Converter={StaticResource NullToVis}}" Background="Transparent" BorderThickness="0" Foreground="#6E7681" Cursor="Hand" Width="18" Height="18" VerticalAlignment="Center" ToolTip="Clear Search">
                                    <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Compact Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Quick Paste — Pill Style like mockup -->
                            <Button Command="{Binding PasteFromClipboardCommand}" Height="36" Margin="0,0,8,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnBorder" Background="Transparent" BorderBrush="#21262D" BorderThickness="1" CornerRadius="18" Padding="16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEAC2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8B949E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Quick Paste (Ctrl+V)" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBorder" Property="Background" Value="#161B22"/>
                                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#30363D"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Compose — Circle "+" Button -->
                            <Button Command="{Binding CreateNewPostCommand}" ToolTip="Add Tweet (Ctrl+N)" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btnCompose" Width="36" Height="36" CornerRadius="18" Background="#161B22" BorderBrush="#21262D" BorderThickness="1">
                                            <TextBlock Text="&#xEA60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnCompose" Property="Background" Value="#21262D"/>
                                                <Setter TargetName="btnCompose" Property="BorderBrush" Value="#30363D"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Filter Dropdown (Compact) -->
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding FilterDropdownOptions}" SelectedItem="{Binding SelectedFilterDropdownText}" Height="36" Width="160">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Native Vector Window Caption Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Width="10" Height="1" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0,0 L 10,0"/>
                        </Button>
                        <!-- Maximize / Restore Button -->
                        <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="Maximize">
                            <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                        </Button>
                        <!-- Close Button -->
                        <Button Style="{StaticResource WindowCloseButtonStyle}" Click="Close_Click" ToolTip="Close">
                            <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN WORKSPACE (3-PANE LAYOUT) ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Left Rail + Extended Sidebar (Collapsible) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Center Feed or Folders Hub -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right Inspector (Collapsible) -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT NAVIGATION SIDEBAR ================= -->
                <Grid Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <!-- Slim Vertical Icon Rail -->
                        <ColumnDefinition Width="*"/>
                        <!-- Navigation Tree & Lists -->
                    </Grid.ColumnDefinitions>

                    <!-- Slim Rail -->
                    <Border Grid.Column="0" Background="{StaticResource RailBgBrush}" BorderBrush="#1C212A" BorderThickness="0,0,1,0">
                        <Grid>
                            <!-- Top Rail Icons -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border Width="34" Height="34" Background="#161B22" CornerRadius="6" Margin="0,0,0,12" BorderBrush="#1D9BF0" BorderThickness="1">
                                    <TextBlock Text="&#xEC10;" FontFamily="{StaticResource CodiconFontFamily}" Foreground="#1D9BF0" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Home Feed Button (Click to toggle panel like VS Code) -->
                                <Button Command="{Binding NavigateHomeCommand}" ToolTip="Home Feed (Ctrl+H / Toggle Sidebar)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ActiveRailView}" Value="Home"/>
                                                        <Condition Binding="{Binding IsSidebarExpanded}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#161B22"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xEB06;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>

                                <!-- Folders Hub Grid Button (Click to toggle panel like VS Code) -->
                                <Button Command="{Binding ShowFoldersHubCommand}" ToolTip="Folders Hub Grid (Ctrl+F / Toggle Sidebar)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ActiveRailView}" Value="Folders"/>
                                                        <Condition Binding="{Binding IsSidebarExpanded}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xEA83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>

                                <!-- Word Document Canvas Button (Click to toggle panel like VS Code) -->
                                <Button Command="{Binding ShowThreadCanvasCommand}" ToolTip="Word Document Canvas (Ctrl+T / Toggle Sidebar)" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RailIconStyle}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ActiveRailView}" Value="Canvas"/>
                                                        <Condition Binding="{Binding IsSidebarExpanded}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                    <Setter Property="Foreground" Value="#1D9BF0"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xEC5E;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Add Tweet (Ctrl+N)" Command="{Binding CreateNewPostCommand}">
                                    <TextBlock Text="&#xEA73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Quick Paste (Ctrl+V)" Command="{Binding PasteFromClipboardCommand}">
                                    <TextBlock Text="&#xEAC2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>

                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Refresh Database (F5)" Command="{Binding RefreshDataCommand}">
                                    <TextBlock Text="&#xEA77;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>
                            </StackPanel>

                            <!-- Bottom Rail Icons -->
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Lock Vault (Ctrl+L)" Command="{Binding LockVaultCommand}">
                                    <TextBlock Text="&#xEA75;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>
                                <Button Style="{StaticResource RailIconStyle}" ToolTip="Archive Settings &amp; Diagnostics (Ctrl+,)" Command="{Binding OpenSettingsCommand}">
                                    <TextBlock Text="&#xEAF8;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="30"/>
                                </Button>
                                <Border Width="28" Height="28" Background="#161B22" CornerRadius="14" ToolTip="Offline ESE Engine Active" Margin="0,4,0,0">
                                    <TextBlock Text="&#xEAB2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Category Tree & Tags (Collapsible Extended Panel) -->
                    <Border Grid.Column="1" Width="235" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}" Background="{StaticResource SidebarBgBrush}" BorderBrush="#1C212A" BorderThickness="0,0,1,0">
                        <Grid Margin="14,14,14,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Global All Posts Button -->
                                <RowDefinition Height="Auto"/>
                                <!-- COLLECTIONS Header with Hub, Add Collection, and Add Folder Buttons -->
                                <RowDefinition Height="Auto"/>
                                <!-- Collections & Folders Accordion List -->
                                <RowDefinition Height="Auto"/>
                                <!-- TAGS Header with Collapse Toggle -->
                                <RowDefinition Height="*"/>
                                <!-- Tags List -->
                                <RowDefinition Height="Auto"/>
                                <!-- DB Size Indicator -->
                            </Grid.RowDefinitions>

                            <!-- 1. Global "All Posts" Item (Simplified) -->
                            <Border Grid.Row="0" Margin="0,0,0,12" CornerRadius="8" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFolder.Name}" Value="All Posts">
                                                <Setter Property="Background" Value="#141A24"/>
                                                <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#111820"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateHomeCommand}"/>
                                </Border.InputBindings>

                                <Grid Height="34" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xEB01;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="All Posts" FontSize="13" FontWeight="SemiBold" Foreground="#C9D1D9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Posts.Count, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2. COLLECTIONS Header (Groups of Folders) — actions visible on hover -->
                            <Border Grid.Row="1" Margin="0,4,0,8" Background="Transparent">
                                <Grid Margin="4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="COLLECTIONS" FontSize="10" FontWeight="Bold" Foreground="#6E7681" VerticalAlignment="Center" Margin="0,0,0,0"/>

                                    <!-- Action buttons — hidden until header hover -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Command="{Binding ShowFoldersHubCommand}" ToolTip="Hub Grid (Ctrl+F)" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="0,0,2,0">
                                            <TextBlock Text="&#xEBEB;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Command="{Binding CreateNewCollectionCommand}" ToolTip="New Collection (Ctrl+Shift+C)" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="0,0,2,0">
                                            <TextBlock Text="&#xEA60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Command="{Binding CreateNewFolderCommand}" ToolTip="New Folder (Ctrl+Shift+N)" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20">
                                            <TextBlock Text="&#xEA83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3. Collections Accordion (Each contains Folders) -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding FilteredCollections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3,0,6">
                                            <!-- Collection Header Row (Spacious & Clean) -->
                                            <Border Background="#12161F" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <!-- Expand/Collapse Arrow -->
                                                        <ColumnDefinition Width="22"/>
                                                        <!-- Collection Icon -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Collection Name -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Folder Count -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Add Folder to this collection -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Delete Collection -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Expand/Collapse Button -->
                                                    <Button Grid.Column="0" Command="{Binding DataContext.ToggleCollectionExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="18" Height="18">
                                                        <TextBlock FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xEAB4;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                                            <Setter Property="Text" Value="&#xEAB6;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <!-- Collection Icon -->
                                                    <TextBlock Grid.Column="1" Text="{Binding IconGlyph, Converter={StaticResource CodiconGlyphConverter}}" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                    <!-- Collection Name -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center" Margin="2,0,4,0" TextTrimming="CharacterEllipsis"/>

                                                    <!-- Folder Count Badge -->
                                                    <Border Grid.Column="3" Background="#161B22" CornerRadius="6" Padding="6,2" Margin="4,0,4,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FolderCount, StringFormat='{}{0}f'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                    </Border>

                                                    <!-- Add Folder to this Collection (+) — visible on row hover -->
                                                    <Button Grid.Column="4" Command="{Binding DataContext.CreateNewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Add Folder to this Collection" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="2,0,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xEA60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <!-- Delete Collection Button (If deletable) — visible on row hover -->
                                                    <Button Grid.Column="5" Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}" ToolTip="Delete Collection" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="2,0,0,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Nested Folders List (Visible when Collection is Expanded) -->
                                            <ItemsControl ItemsSource="{Binding Folders}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="14,3,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,2" CornerRadius="8" Cursor="Hand" AllowDrop="True" DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Folder_Drop">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#1A3B5C"/>
                                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Background" Value="#161B22"/>
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>

                                                            <Grid Height="32" Margin="8,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Folder Icon -->
                                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph, Converter={StaticResource CodiconGlyphConverter}}" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>

                                                                <!-- Folder Name -->
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#C9D1D9"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                                <!-- Post Count Badge -->
                                                                <Border Grid.Column="2" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#161B22"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="#1D9BF0"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#8B949E"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>

                                                                <!-- Delete Folder Button — visible on row hover -->
                                                                <Button Grid.Column="3" Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}" ToolTip="Delete Folder" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="20" Height="20" Margin="4,0,0,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Opacity" Value="0"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="10" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- TAGS Section Header with Hide/Show Toggle -->
                            <Grid Grid.Row="3" Margin="4,16,4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TAGS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding ToggleTagsCommand}" ToolTip="Toggle Tags Visibility" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="22" Height="22">
                                    <TextBlock FontSize="10" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▲"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTagsVisible}" Value="False">
                                                        <Setter Property="Text" Value="▼"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </Grid>

                            <!-- Tags List (Collapsible) -->
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsTagsVisible, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,1" CornerRadius="6" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1A222D"/>
                                                                <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Background" Value="#12161F"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>

                                                <Grid Height="30" Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- DB Size Indicator -->
                            <Border Grid.Row="5" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="#1C212A" BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEACE;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#1D9BF0" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DatabaseSizeText}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= CENTER MAIN STAGE (POSTS FEED OR FOLDERS HUB) ================= -->
                <Border Grid.Column="1" Background="#000000" BorderBrush="#1C212A" BorderThickness="1,0,1,0">
                    <Grid>
                        <!-- ================================================================= -->
                        <!-- VIEW A: REGULAR POSTS FEED (List View / Grid View) =============== -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFoldersViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCanvasViewActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Feed Toolbar (Title, View Switcher, Inspector Toggle) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Multi-Selection Bulk Action Bar -->
                                <RowDefinition Height="*"/>
                                <!-- Feed Items (List or Grid View) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- FEED TOOLBAR / VIEW MODE SWITCHER & INSPECTOR TOGGLE (Spacious) -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="22,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active Filter & Count -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedFolder.Name, FallbackValue='All Posts'}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='{}{0} archived posts'}" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Matching Folders Jump Row (Visible when search matches folders) -->
                                        <ItemsControl ItemsSource="{Binding MatchedFolders}" Visibility="{Binding HasMatchedFolders, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,3" Margin="0,0,6,4" Background="#1A3B5C" BorderBrush="#1D9BF0" BorderThickness="1" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" FontSize="10.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Right Actions: [ ☰ List | ⊞ Grid ] and [ ◨ Inspector ] -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- View Mode Switcher [ ☰ List | ⊞ Grid ] -->
                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- List View Button -->
                                                <Button Command="{Binding SetListViewCommand}" ToolTip="List View (Full Timeline)" Padding="14,6" BorderThickness="0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                                    <Setter Property="Foreground" Value="#E7E9EA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="7"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEB17;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="List" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Grid View Button -->
                                                <Button Command="{Binding SetGridViewCommand}" ToolTip="Grid View (Tile Cards)" Padding="14,6" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                                    <Setter Property="Background" Value="#1A3B5C"/>
                                                                    <Setter Property="Foreground" Value="#E7E9EA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="7"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEBEB;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Grid" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Inspector Panel Toggle Button -->
                                        <Button Command="{Binding ToggleInspectorCommand}" ToolTip="Toggle Inspector Panel (Ctrl+I)" Padding="12,6" BorderThickness="1" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#161B22"/>
                                                    <Setter Property="BorderBrush" Value="#2F3336"/>
                                                    <Setter Property="Foreground" Value="#8B949E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInspectorVisible}" Value="True">
                                                            <Setter Property="Background" Value="#1A3B5C"/>
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="10"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEBF4;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Inspector" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= MULTI-SELECTION BULK ACTION BAR ================= -->
                            <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="22,10" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Count Badge & Keyboard Shortcuts Tip -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1D9BF0" CornerRadius="12" Padding="12,4" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEAB2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}{0} Selected'}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Ctrl+Click to toggle • Shift+Click to range • Press Del to remove" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right Actions: [ ☑ Select All ] [ ✕ Clear ] [ 📁 Move Selected ⌵ ] [ 🔗 Link Story ] [ 🗑️ Delete Selected (N) ] -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Select All Button -->
                                        <Button Command="{Binding SelectAllPostsCommand}" Margin="0,0,8,0" Padding="12,6" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" ToolTip="Select All Posts (Ctrl+A)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEBB1;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Select All" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Clear Selection Button -->
                                        <Button Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" Padding="12,6" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" ToolTip="Deselect All (Esc)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clear" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Move Selected Dropdown Menu Button -->
                                        <Menu Background="Transparent" Margin="0,0,8,0">
                                            <MenuItem Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" Padding="12,6">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xEA83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                                        <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Move ({0})'}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" &#xEAB4;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#8B949E"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                                <MenuItem.ItemsSource>
                                                    <Binding Path="Folders"/>
                                                </MenuItem.ItemsSource>
                                                <MenuItem.ItemContainerStyle>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Header" Value="{Binding Name}"/>
                                                        <Setter Property="Command" Value="{Binding DataContext.MoveSelectedPostsToFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                        <Setter Property="Background" Value="#161B22"/>
                                                        <Setter Property="Foreground" Value="#E7E9EA"/>
                                                        <Setter Property="FontSize" Value="12.5"/>
                                                        <Setter Property="Padding" Value="10,6"/>
                                                    </Style>
                                                </MenuItem.ItemContainerStyle>
                                            </MenuItem>
                                        </Menu>

                                        <!-- Link Selected Posts as Multi-Part Story Button -->
                                        <Button Command="{Binding LinkSelectedPostsAsStoryCommand}" Margin="0,0,8,0" Padding="12,6" Background="#1A3B5C" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#38BDF8" Cursor="Hand" ToolTip="Link all selected posts into a multi-part story sequence">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEB15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Link Story" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Selected Button (Prominent Crimson Warning) -->
                                        <Button Command="{Binding DeleteSelectedPostsCommand}" Padding="16,6" Background="#DA3633" BorderBrush="#F85149" BorderThickness="1" Foreground="#FFFFFF" Cursor="Hand" ToolTip="Permanently delete all selected posts from database (Delete key)">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Delete Selected ({0})'}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ================= 1. LIST VIEW (Full Width Timeline Cards) ================= -->
                            <ListView Grid.Row="2" x:Name="FeedListControl" PreviewMouseLeftButtonDown="FeedList_PreviewMouseLeftButtonDown" PreviewMouseMove="FeedList_PreviewMouseMove" ItemsSource="{Binding FilteredPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="FeedListView_SelectionChanged" KeyDown="FeedListView_KeyDown" Visibility="{Binding IsGridView, Converter={StaticResource InverseBoolToVis}}" Background="Transparent" BorderThickness="0" Padding="24,18" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" MouseDoubleClick="FeedListView_MouseDoubleClick">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,16"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <Border CornerRadius="14" Background="{StaticResource CardBgBrush}" BorderThickness="1" Padding="20" Cursor="Hand">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="#161B22" BorderBrush="#2F3336" Foreground="#E7E9EA">
                                                    <MenuItem Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open Theater View" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding DataContext.EditPostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#E7E9EA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Edit Post Content" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Multi-Part Story Linking Options -->
                                                    <MenuItem Command="{Binding DataContext.ViewFullStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="View Full Story (Thread)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.UnlinkFromStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Unlink from Story" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.LinkSelectedPostsAsStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Link Selected as Multi-Part Story" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <!-- Move to Folder Menu (Moves Selected posts if multiple, or this single post) -->
                                                    <MenuItem ItemsSource="{Binding DataContext.Folders, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move to Folder..." VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                                <Setter Property="Command" Value="{Binding DataContext.MovePostToFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.OpenLocalFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Explorer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.CopyPostTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <MenuItem Command="{Binding DataContext.DeleteSelectedPostsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F87171" FontWeight="Bold" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.SelectedPostsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Delete {0} Selected Posts'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#F87171">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.DeleteSingleMenuHeader, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Header -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Body Text -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Comment Note (Optional) -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Media Previews Grid -->
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <!-- Avatar -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Names & Date -->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- Actions -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar Circle -->
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="15" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name, Handle, Timestamp, Folder & Story Badges -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding AuthorName}" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AuthorHandle}" FontSize="12" Foreground="#8B949E"/>
                                                            <TextBlock Text=" · " FontSize="12" Foreground="#6E7681"/>
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="12" Foreground="#8B949E"/>

                                                            <!-- Folder Badge -->
                                                            <Border Background="#21262D" CornerRadius="6" Padding="7,2" BorderBrush="#30363D" BorderThickness="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                            </Border>

                                                            <!-- Story Part Badge (if part of multi-part story) -->
                                                            <Border Background="#1A3B5C" CornerRadius="6" Padding="7,2" BorderBrush="#1D9BF0" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Cursor="Hand" ToolTip="Part of a multi-part story. Click to view full story.">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ViewFullStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <TextBlock Text="{Binding ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Inline Action Buttons (Edit, Delete, Theater) — reveal on card hover -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <!-- Edit Button -->
                                                        <Button Command="{Binding DataContext.EditPostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Edit Post" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Delete Button -->
                                                        <Button Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete Post (Del)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28" Margin="0,0,4,0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <!-- Theater View Button -->
                                                        <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Split Theater View" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Width="28" Height="28">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="6"/>
                                                                </Style>
                                                            </Button.Resources>
                                                            <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tweet Content Text -->
                                                <emoji:TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="14.5" LineHeight="21" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,12,0,10" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                <!-- Optional Note / Comment Bubble -->
                                                <Border Grid.Row="2" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F0883E" VerticalAlignment="Top" Margin="0,2,6,0"/>
                                                        <emoji:TextBlock Text="{Binding Comment}" FontSize="12.5" Foreground="#F0883E" TextWrapping="Wrap" LineHeight="18"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Attached Media Preview Grids -->
                                                <Grid Grid.Row="3" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                    <!-- Single Image / Video Preview -->
                                                    <Border Visibility="{Binding HasSingleMedia, Converter={StaticResource BoolToVis}}" CornerRadius="14" Background="#0C1017" ClipToBounds="True" MaxHeight="320" Cursor="Hand">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Image Source="{Binding PrimaryThumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                            <!-- Video Play Overlay Badge -->
                                                            <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}" Background="#CC000000" CornerRadius="22" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" Foreground="#FFFFFF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Dual Images Layout -->
                                                    <Grid Visibility="{Binding HasTwoMedia, Converter={StaticResource BoolToVis}}" Height="200" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryThumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Margin="4,0,0,0" CornerRadius="12" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryThumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 3+ Images Layout -->
                                                    <Grid Visibility="{Binding HasThreeOrMoreMedia, Converter={StaticResource BoolToVis}}" Height="240" Cursor="Hand">
                                                        <Grid.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid.InputBindings>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Margin="0,0,3,3" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding PrimaryThumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Margin="3,0,0,3" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding SecondaryThumbnail}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" Margin="0,3,3,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding ThirdImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Margin="3,3,0,0" CornerRadius="10" Background="#0C1017" ClipToBounds="True">
                                                            <Image Source="{Binding FourthImage}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- ================= 2. GRID VIEW (Card Tiles Multi-Column Layout - Spacious & Rounded) ================= -->
                            <ListView Grid.Row="2" x:Name="FeedGridControl" PreviewMouseLeftButtonDown="FeedList_PreviewMouseLeftButtonDown" PreviewMouseMove="FeedList_PreviewMouseMove" ItemsSource="{Binding FilteredPosts}" SelectedItem="{Binding SelectedPost, Mode=TwoWay}" SelectionMode="Extended" SelectionChanged="FeedListView_SelectionChanged" KeyDown="FeedListView_KeyDown" Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" Padding="24,20" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" MouseDoubleClick="FeedListView_MouseDoubleClick">

                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,22,22"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Post}">
                                        <!-- Clean Tile Card -->
                                        <Border Width="330" MinHeight="340" CornerRadius="14" Background="#161B22" BorderThickness="1" Cursor="Hand" ClipToBounds="False">
                                            <Border.ContextMenu>
                                                <ContextMenu Background="#161B22" BorderBrush="#2F3336" Foreground="#E7E9EA">
                                                    <MenuItem Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#1D9BF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open Theater View" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding DataContext.EditPostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#E7E9EA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Edit Post Content" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <!-- Multi-Part Story Linking Options -->
                                                    <MenuItem Command="{Binding DataContext.ViewFullStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="View Full Story (Thread)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.UnlinkFromStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Unlink from Story" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.LinkSelectedPostsAsStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Link Selected as Multi-Part Story" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <!-- Move to Folder Menu -->
                                                    <MenuItem ItemsSource="{Binding DataContext.Folders, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Move to Folder..." VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                        <MenuItem.ItemContainerStyle>
                                                            <Style TargetType="MenuItem">
                                                                <Setter Property="Header" Value="{Binding Name}"/>
                                                                <Setter Property="Command" Value="{Binding DataContext.MovePostToFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                            </Style>
                                                        </MenuItem.ItemContainerStyle>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.OpenLocalFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open in Explorer" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.CopyPostTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <Separator Background="#2F3336"/>

                                                    <MenuItem Command="{Binding DataContext.DeleteSelectedPostsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F87171" FontWeight="Bold" Visibility="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.SelectedPostsCount, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Delete {0} Selected Posts'}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>

                                                    <MenuItem Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#F87171">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F87171" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding DataContext.DeleteSingleMenuHeader, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#252D38"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#1D9BF0"/>
                                                            <Setter Property="Background" Value="#19202A"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="#45BAEA"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Media Capsule or Folder Header -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Author Row -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- Text Content -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Comment Preview if present -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- Bottom Row -->
                                                </Grid.RowDefinitions>

                                                <!-- 1A. Inset Floating Rounded Media Capsule (When Post HAS Media) -->
                                                <Border Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}" Height="165" Margin="14,14,14,10" CornerRadius="14" Background="#0A0D13" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Image / Video Preview using PrimaryThumbnail -->
                                                        <Image Source="{Binding PrimaryThumbnail}" Stretch="UniformToFill"/>

                                                        <!-- Video Play Overlay Badge -->
                                                        <Border Visibility="{Binding PrimaryIsVideo, Converter={StaticResource BoolToVis}}" Background="#CC000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" Foreground="#FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                        </Border>

                                                        <!-- Folder Pill Badge (Top-Right) -->
                                                        <Border Background="#E60A0D13" CornerRadius="8" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                        </Border>

                                                        <!-- Story Badge Pill (Top-Center if part of thread) -->
                                                        <Border Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#E61A3B5C" CornerRadius="8" Padding="7,3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8" Cursor="Hand" ToolTip="Part of a multi-part story. Click to view full story.">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ViewFullStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding ThreadPartBadge}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Media Counter Pill Badge (Top-Left if > 1) -->
                                                        <Border Visibility="{Binding HasMultipleMedia, Converter={StaticResource BoolToVis}}" Background="#CC0A0D13" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xea72;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="10" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding MediaCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 1B. Top Folder & Story Pills (When Post has NO Media) -->
                                                <Grid Grid.Row="0" Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}" Margin="16,14,16,6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <!-- Story Pill -->
                                                        <Border Visibility="{Binding IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#1A3B5C" CornerRadius="8" Padding="7,3" Margin="0,0,6,0" Cursor="Hand" ToolTip="Part of a multi-part story. Click to view full story.">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ViewFullStoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9.5" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                                <TextBlock Text="{Binding ThreadPartBadge}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Folder Pill -->
                                                        <Border Background="#1C2430" CornerRadius="8" Padding="8,3">
                                                            <TextBlock Text="{Binding FolderName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 2. Author Header Row -->
                                                <Grid Grid.Row="1" Margin="16,4,16,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#212836" BorderBrush="#2F3336" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AvatarInitial}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding AuthorName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AuthorHandle}" FontSize="11" Foreground="#8B949E" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 3. Text Content -->
                                                <emoji:TextBlock Grid.Row="2" Text="{Binding Content}" FontSize="12.5" LineHeight="18" Foreground="#C9D1D9" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="16,0,16,10" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                                <!-- 4. Optional Comment Pill in Tile -->
                                                <Border Grid.Row="3" Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="16,0,16,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#F0883E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <emoji:TextBlock Text="{Binding Comment}" FontSize="11" Foreground="#F0883E" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 5. Bottom Row (Relative Time & Quick Actions) -->
                                                <Border Grid.Row="4" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="14,10" Background="#11151C" CornerRadius="0,0,18,18">
                                                    <Grid>
                                                        <TextBlock Text="{Binding RelativeTime}" FontSize="11.5" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <!-- Quick Delete -->
                                                            <Button Command="{Binding DataContext.DeletePostCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete Post (Del)" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="26" Height="26" Margin="0,0,6,0">
                                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                            <!-- View Button -->
                                                            <Button Command="{Binding DataContext.OpenTheaterModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open Theater View" Background="#1A3B5C" Foreground="#1D9BF0" Padding="10,4" BorderThickness="0" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="6"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="View" FontSize="11.5" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State — shown when feed is empty -->
                            <Border Grid.Row="2" Visibility="{Binding IsEmptyFeed, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="48" Foreground="#21262D" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                    <TextBlock Text="Your archive is quiet" FontSize="16" FontWeight="SemiBold" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Paste from clipboard or compose to add posts" FontSize="13" Foreground="#484F58" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status Bar -->
                            <Border Grid.Row="3" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="14,6">
                                <Grid>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding FilteredPosts.Count, StringFormat='Showing {0} entries'}" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW B: COLLECTIONS HUB (Visual Grid of Collections & Folders) === -->
                        <!-- ================================================================= -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="True"/>
                                                <Condition Binding="{Binding IsCanvasViewActive}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Hub Header & Toolbar -->
                                <RowDefinition Height="*"/>
                                <!-- Grid of Collections -->
                                <RowDefinition Height="Auto"/>
                                <!-- Hub Bottom Status -->
                            </Grid.RowDefinitions>

                            <!-- Collections Hub Header Bar -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xeb00;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" Foreground="#1D9BF0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Collections Hub — Collections of Folders" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <Border Background="#1A3B5C" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Collections.Count, StringFormat='{}{0} Collections'}" FontSize="11" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                            </Border>
                                            <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Posts.Count, StringFormat='{}{0} Total Posts'}" FontSize="11" Foreground="#8B949E"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Top-level collections grouping your categorized folders and offline archives" FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Add Collection Button -->
                                        <Button Command="{Binding CreateNewCollectionCommand}" Padding="12,7" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xeb00;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Collection" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Add Folder Button -->
                                        <Button Command="{Binding CreateNewFolderCommand}" Padding="12,7" Background="#1D9BF0" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xea67;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Folder" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Back to Feed Button -->
                                        <Button Command="{Binding NavigateHomeCommand}" Padding="12,7" Background="#161B22" Foreground="#E7E9EA" BorderBrush="#2F3336" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xeb18;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="View Feed" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Collections Cards Visual Grid -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                                <ItemsControl ItemsSource="{Binding FilteredCollections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="360" MinHeight="290" CornerRadius="12" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" Margin="0,0,18,18" Padding="18">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Collection Header (Icon, Title, Badges) -->
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Collection Description -->
                                                        <RowDefinition Height="*"/>
                                                        <!-- Contained Folders List -->
                                                        <RowDefinition Height="Auto"/>
                                                        <!-- Collection Footer -->
                                                    </Grid.RowDefinitions>

                                                    <!-- 1. Collection Header -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Colored Icon Circle -->
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#212836" BorderBrush="#2F3336" BorderThickness="1">
                                                            <TextBlock Text="{Binding IconGlyph, Converter={StaticResource CodiconGlyphConverter}}" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" Foreground="#1D9BF0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Name & Counts -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding FolderCount, StringFormat='{}{0} folders'}" FontSize="11" Foreground="#1D9BF0" FontWeight="SemiBold"/>
                                                                <TextBlock Text=" • " FontSize="11" Foreground="#6E7681"/>
                                                                <TextBlock Text="{Binding TotalPostsCount, StringFormat='{}{0} total posts'}" FontSize="11" Foreground="#8B949E"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- Delete Collection (if custom) -->
                                                        <Button Grid.Column="2" Command="{Binding DataContext.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}" ToolTip="Delete Collection" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24" VerticalAlignment="Top">
                                                            <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 2. Collection Description -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                                                    <!-- 3. Folders Contained in this Collection -->
                                                    <Border Grid.Row="2" Background="#0C1017" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,8">
                                                                <TextBlock Text="FOLDERS IN THIS COLLECTION" FontSize="10.5" FontWeight="Bold" Foreground="#6E7681" VerticalAlignment="Center"/>
                                                                <Button Content="+ Add Folder" Command="{Binding DataContext.CreateNewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" Padding="6,2" Background="Transparent" Foreground="#1D9BF0" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                                                            </Grid>

                                                            <!-- Folders List -->
                                                            <ItemsControl ItemsSource="{Binding Folders}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,6" Cursor="Hand" AllowDrop="True" DragOver="Folder_DragOver" DragLeave="Folder_DragLeave" Drop="Folder_Drop">
                                                                            <Border.InputBindings>
                                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                                            </Border.InputBindings>
                                                                            <Grid>
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Folder Icon & Name -->
                                                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding IconGlyph, Converter={StaticResource CodiconGlyphConverter}}" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center"/>

                                                                                <!-- Post Count -->
                                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} posts'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                                <!-- Browse Button -->
                                                                                <Button Grid.Row="0" Grid.Column="3" Command="{Binding DataContext.OpenFolderFromHubCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#212836" Foreground="#1D9BF0" FontSize="11" FontWeight="SemiBold" Padding="8,3" BorderThickness="0" Cursor="Hand">
                                                                                    <Button.Resources>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                                        </Style>
                                                                                    </Button.Resources>
                                                                                    <TextBlock Text="Browse →"/>
                                                                                </Button>

                                                                                <!-- Thumbnail Previews (if any) -->
                                                                                <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0" CornerRadius="4" ClipToBounds="True" Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                                                                                    <Grid Height="46">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Image Grid.Column="0" Source="{Binding FirstThumbnail}" Stretch="UniformToFill" Margin="0,0,2,0"/>
                                                                                        <Image Grid.Column="1" Source="{Binding SecondThumbnail}" Stretch="UniformToFill" Margin="1,0,1,0"/>
                                                                                        <Image Grid.Column="2" Source="{Binding ThirdThumbnail}" Stretch="UniformToFill" Margin="2,0,0,0"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 4. Card Bottom Bar -->
                                                    <TextBlock Grid.Row="3" Text="{Binding FolderCount, StringFormat='Collection contains {0} folders'}" FontSize="11" Foreground="#6E7681"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Hub Bottom Status -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid>
                                    <TextBlock Text="Each Collection groups multiple folders. Click any folder to view its archived posts." FontSize="11.5" Foreground="#8B949E"/>
                                    <TextBlock Text="{Binding Collections.Count, StringFormat='Total Collections: {0}'}" FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ================================================================= -->
                        <!-- VIEW C: CANVAS & STUDIO (Word Document Canvas + Thread Maker) ===== -->
                        <!-- ================================================================= -->
                        <Grid Visibility="{Binding IsCanvasViewActive, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Canvas Mode Switcher Ribbon -->
                                <RowDefinition Height="*"/>
                                <!-- Canvas Workspace (Doc Sheet or Thread Nodes) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Status Bar -->
                            </Grid.RowDefinitions>

                            <!-- 1. Top Ribbon & Mode Switcher -->
                            <Border Grid.Row="0" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,0,0,1" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 1: Mode Switcher [ 📝 Word Document Canvas | 🧵 Thread Maker Studio ] & Metadata -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mode Switcher Pill Segmented Buttons -->
                                        <Border Grid.Column="0" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Word Canvas Mode -->
                                                <Button Command="{Binding SetCanvasModeCommand}" CommandParameter="Doc" ToolTip="Microsoft Word Document Canvas (Rich text, inline images &amp; media)" Padding="12,5" BorderThickness="0" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThreadModeActive}" Value="False">
                                                                    <Setter Property="Background" Value="#1D9BF0"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb51;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Word Document" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Thread Maker Studio Mode -->
                                                <Button Command="{Binding SetCanvasModeCommand}" CommandParameter="Thread" ToolTip="Thread Maker Studio (Sequential multi-tweet thread composer)" Padding="12,5" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="#8B949E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsThreadModeActive}" Value="True">
                                                                    <Setter Property="Background" Value="#1D9BF0"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Thread Studio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Center: Title & Target Folder Selector -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Title Input -->
                                            <Border Grid.Column="0" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Title: " FontSize="11" FontWeight="Bold" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CanvasThreadTitle, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" CaretBrush="#1D9BF0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Target Folder Input -->
                                            <Border Grid.Column="1" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CanvasSelectedFolder, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#1D9BF0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" CaretBrush="#1D9BF0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Right: Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Actions for Doc Mode -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsThreadModeActive, Converter={StaticResource InverseBoolToVis}}">
                                                <!-- Auto-Split Page Overflow Toggle Option -->
                                                <CheckBox IsChecked="{Binding CanvasAutoSplitPages}" ToolTip="When enabled, documents exceeding ~1 page (3,500 chars) automatically generate linked multi-part documents (Doc 1, Doc 2, etc.)" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand">
                                                    <CheckBox.Template>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <Border x:Name="chkBorder" Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="6" Padding="9,5">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="chkIcon" Text="&#xeb51;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="chkText" Text="Auto-Split Pages" FontSize="11.5" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chkBorder" Property="Background" Value="#1A3B5C"/>
                                                                    <Setter TargetName="chkBorder" Property="BorderBrush" Value="#1D9BF0"/>
                                                                    <Setter TargetName="chkText" Property="Foreground" Value="#1D9BF0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chkBorder" Property="BorderBrush" Value="#30363D"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </CheckBox.Template>
                                                </CheckBox>

                                                <Button Click="BtnArchiveDoc_Click" ToolTip="Save Document &amp; All Embedded Media to Database" Padding="14,7" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea98;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Save &amp; Archive Post" FontSize="12.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Click="BtnClearDoc_Click" ToolTip="Clear Document Canvas" Padding="10,7" Background="#211212" Foreground="#F87171" BorderBrush="#3B1C1C" BorderThickness="1" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb05;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Actions for Thread Studio Mode -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsThreadModeActive, Converter={StaticResource BoolToVis}}">
                                                <Button Command="{Binding AddEmptyCanvasNodeCommand}" ToolTip="Add New Step Node to Thread" Padding="10,7" Background="#1D9BF0" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea67;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Add Step" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding PasteToCanvasCommand}" ToolTip="Paste Tweet/Thread from Clipboard" Padding="10,7" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Paste" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding ArchiveThreadAsSeriesCommand}" ToolTip="Save as Connected Multi-Post Series" Padding="10,7" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Save Series" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding MergeAndArchiveThreadCommand}" ToolTip="Merge All Steps into 1 Master Archived Post" Padding="10,7" Background="#212836" Foreground="#E7E9EA" BorderBrush="#2F3336" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Merge 1 Post" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding ClearCanvasCommand}" ToolTip="Clear Thread Canvas" Padding="8,7" Background="#211212" Foreground="#F87171" BorderBrush="#3B1C1C" BorderThickness="1" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="&#xeb05;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Secondary Toolbars & Settings -->
                                    <!-- A. Word Doc Toolbar (Formatting, Media, Emoji) -->
                                    <Border Grid.Row="1" Visibility="{Binding IsThreadModeActive, Converter={StaticResource InverseBoolToVis}}" Background="#12161F" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Text Formatting Group -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=DocRichTextBox}" ToolTip="Bold (Ctrl+B)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#2F3336" BorderThickness="1" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="B" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <Button Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=DocRichTextBox}" ToolTip="Italic (Ctrl+I)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#2F3336" BorderThickness="1" FontStyle="Italic" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <Button Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=DocRichTextBox}" ToolTip="Underline (Ctrl+U)" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#2F3336" BorderThickness="1" FontSize="13" Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <Button Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=DocRichTextBox}" ToolTip="Bullet List" Width="30" Height="28" Background="#161B22" Foreground="#FFFFFF" BorderBrush="#2F3336" BorderThickness="1" FontSize="13" Cursor="Hand" Margin="0,0,8,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="•≡" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Divider -->
                                            <Rectangle Grid.Column="1" Width="1" Fill="#2F3336" Margin="4,3,10,3"/>

                                            <!-- Media & Emoji Group -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Insert Image / GIF -->
                                                <Button Click="BtnInsertImage_Click" ToolTip="Insert Image (.png, .jpg, .jfif, .webp, .gif) from disk" Padding="10,4" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea72;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Image / JFIF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Insert Video -->
                                                <Button Click="BtnInsertVideo_Click" ToolTip="Insert Video (.mp4 / .webm) from disk" Padding="10,4" Background="#161B22" Foreground="#8B5CF6" BorderBrush="#2F3336" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Video" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Emoji Palette Popup Trigger -->
                                                <Grid Margin="0,0,6,0">
                                                    <Button x:Name="BtnDocEmojiTrigger" Click="BtnDocEmoji_Click" ToolTip="Insert Emoji Pack" Padding="10,4" Background="#161B22" Foreground="#F59E0B" BorderBrush="#2F3336" BorderThickness="1" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xea89;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Emoji" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Popup x:Name="DocEmojiPopup" PlacementTarget="{Binding ElementName=BtnDocEmojiTrigger}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Padding="12" Width="320" Margin="0,6,0,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
                                                            </Border.Effect>
                                                            <StackPanel>
                                                                <!-- Windows Native Emoji Picker Button -->
                                                                <Button Click="BtnOpenWindowsEmojiPicker_Click" Padding="10,6" Margin="0,0,0,10" Background="#1A3B5C" Foreground="#1D9BF0" BorderBrush="#1D9BF0" BorderThickness="1" Cursor="Hand" ToolTip="Launch native Windows 10/11 Emoji &amp; Symbol Picker (Win + .)">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="6"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock Text="🪟 " FontSize="13"/>
                                                                        <TextBlock Text="Windows Emoji Picker (Win + .)" FontSize="12" FontWeight="SemiBold"/>
                                                                    </StackPanel>
                                                                </Button>

                                                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                                    <ItemsControl ItemsSource="{Binding EmojiCategories}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,8">
                                                                                    <TextBlock Text="{Binding Name, StringFormat='{}{0}'}" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="2,0,0,4"/>
                                                                                    <ItemsControl ItemsSource="{Binding Emojis}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Button Content="{Binding}" Click="BtnDocEmojiItem_Click" Width="30" Height="30" FontSize="14" Margin="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" Cursor="Hand">
                                                                                                    <Button.Resources>
                                                                                                        <Style TargetType="Border">
                                                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                                                        </Style>
                                                                                                    </Button.Resources>
                                                                                                </Button>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>

                                                <!-- Paste into Canvas (Ctrl+V) -->
                                                <Button Click="BtnPasteIntoDoc_Click" ToolTip="Paste text, Word image, or GIF directly from clipboard" Padding="10,4" Background="#1A3B5C" Foreground="#1D9BF0" BorderBrush="#1D9BF0" BorderThickness="1" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📋 " FontSize="12"/>
                                                        <TextBlock Text="Paste (Ctrl+V)" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Author & Tags Inline -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Author: " FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBox Text="{Binding CanvasDefaultAuthor, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" FontSize="11.5" MinWidth="85" CaretBrush="#1D9BF0"/>
                                                </Border>

                                                <TextBlock Text="Tags: " FontSize="11" Foreground="#6E7681" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBox Text="{Binding CanvasDefaultTags, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#9EACB9" FontSize="11.5" MinWidth="100" CaretBrush="#1D9BF0"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- B. Thread Studio Defaults Bar -->
                                    <Border Grid.Row="1" Visibility="{Binding IsThreadModeActive, Converter={StaticResource BoolToVis}}" Background="#12161F" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Default Author: " FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBox Text="{Binding CanvasDefaultAuthor, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" FontSize="12" MinWidth="110" CaretBrush="#1D9BF0"/>
                                                </Border>

                                                <TextBlock Text="Handle: " FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                                    <TextBox Text="{Binding CanvasDefaultHandle, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#8B949E" FontSize="12" MinWidth="100" CaretBrush="#1D9BF0"/>
                                                </Border>

                                                <TextBlock Text="Tags: " FontSize="11.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                    <TextBox Text="{Binding CanvasDefaultTags, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#1D9BF0" FontSize="12" MinWidth="120" CaretBrush="#1D9BF0"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#1A3B5C" CornerRadius="6" Padding="8,3">
                                                    <TextBlock Text="{Binding CanvasThreadNodes.Count, StringFormat='{}{0} Steps in Thread'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 2. Workspace: Word Document Paper Canvas OR Thread Studio Sequential Nodes -->
                            <!-- WORKSPACE A: Word Document Page Sheet -->
                            <ScrollViewer Grid.Row="1" Background="#0C1017" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20,24" Visibility="{Binding IsThreadModeActive, Converter={StaticResource InverseBoolToVis}}">
                                <Border MaxWidth="860" MinHeight="720" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Margin="0,0,0,40">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
                                    </Border.Effect>

                                    <!-- Rich Document Canvas -->
                                    <emoji:RichTextBox x:Name="DocRichTextBox" Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" CaretBrush="#1D9BF0" FontSize="14.5" FontFamily="{StaticResource TweetContentFontFamily}" Padding="32,28" AcceptsTab="True" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" IsDocumentEnabled="True">
                                        <FlowDocument PagePadding="0" FontFamily="{StaticResource TweetContentFontFamily}" FontSize="14.5" Foreground="#E7E9EA">
                                            <Paragraph Margin="0,0,0,10">
                                                <Run Text=""/>
                                            </Paragraph>
                                        </FlowDocument>
                                    </emoji:RichTextBox>
                                </Border>
                            </ScrollViewer>

                            <!-- WORKSPACE B: Thread Maker Studio Sequential Nodes -->
                            <ScrollViewer Grid.Row="1" Background="#0A0D13" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="{Binding IsThreadModeActive, Converter={StaticResource BoolToVis}}">
                                <StackPanel MaxWidth="820" HorizontalAlignment="Center">
                                    <!-- Empty State Banner -->
                                    <Border Visibility="{Binding CanvasThreadNodes.Count, Converter={StaticResource InverseBoolToVis}}" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="12" Padding="32" Margin="0,20,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="40" Foreground="#1D9BF0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="Thread Studio is Empty" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Compose or paste a connected sequence of tweets. Each step will be linked in order." FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding AddEmptyCanvasNodeCommand}" Padding="16,8" Background="#1D9BF0" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xea60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Add First Step" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding PasteToCanvasCommand}" Padding="16,8" Background="#212836" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Paste from Clipboard" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sequential Nodes List -->
                                    <ItemsControl ItemsSource="{Binding CanvasThreadNodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ThreadNode}">
                                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Step Header (Number, Reorder, Delete) -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Content TextBox -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Emoji Palette Quick Bar -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Attached Media Previews -->
                                                            <RowDefinition Height="Auto"/>
                                                            <!-- Node Footer (+ Attach Media) -->
                                                        </Grid.RowDefinitions>

                                                        <!-- 1. Step Header -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Step Number Pill -->
                                                            <Border Grid.Column="0" Background="#1A3B5C" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding StepNumber, StringFormat='Step #{0}'}" FontSize="12" FontWeight="Bold" Foreground="#1D9BF0"/>
                                                            </Border>

                                                            <!-- Author & Handle for this node -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AuthorName}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding AuthorHandle}" FontSize="11.5" Foreground="#8B949E"/>
                                                            </StackPanel>

                                                            <!-- Reorder (Up/Down) and Delete Actions -->
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Move Up -->
                                                                <Button Command="{Binding DataContext.MoveNodeUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move Step Up" Background="#212836" Foreground="#8B949E" BorderThickness="0" Width="26" Height="26" Cursor="Hand" Margin="0,0,4,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="&#xeb0b;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                                <!-- Move Down -->
                                                                <Button Command="{Binding DataContext.MoveNodeDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move Step Down" Background="#212836" Foreground="#8B949E" BorderThickness="0" Width="26" Height="26" Cursor="Hand" Margin="0,0,8,0">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="&#xea53;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                                <!-- Delete Step -->
                                                                <Button Command="{Binding DataContext.RemoveCanvasNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete Step" Background="#332B1818" Foreground="#F87171" BorderBrush="#66DC2626" BorderThickness="1" Width="26" Height="26" Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                    <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- 2. Content TextBox (Supports cursor pasting of text & images) -->
                                                        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                            <emoji:RichTextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DataObject.Pasting="NodeTextBox_Pasting" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="14" AcceptsReturn="True" MinHeight="85" CaretBrush="#1D9BF0" FontFamily="{StaticResource TweetContentFontFamily}"/>
                                                        </Border>

                                                        <!-- 3. Quick Emoji Palette Bar -->
                                                        <Border Grid.Row="2" Background="#11151C" BorderBrush="#1C212A" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,0,8">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Emojis:" FontSize="10.5" Foreground="#8B949E" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                                                <Button Content="🔥" Command="{Binding InsertEmojiCommand}" CommandParameter="🔥" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="🚀" Command="{Binding InsertEmojiCommand}" CommandParameter="🚀" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="💡" Command="{Binding InsertEmojiCommand}" CommandParameter="💡" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="🧵" Command="{Binding InsertEmojiCommand}" CommandParameter="🧵" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="✅" Command="{Binding InsertEmojiCommand}" CommandParameter="✅" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="❤️" Command="{Binding InsertEmojiCommand}" CommandParameter="❤️" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="💻" Command="{Binding InsertEmojiCommand}" CommandParameter="💻" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="📌" Command="{Binding InsertEmojiCommand}" CommandParameter="📌" Width="24" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                                                <Button Content="🪟 Win + ." Click="BtnNodeWindowsEmojiPicker_Click" ToolTip="Open Windows Built-in Emoji &amp; Symbol Picker (Win + .)" Padding="6,1" Margin="8,0,0,0" Background="#161B22" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand">
                                                                    <Button.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="4"/>
                                                                        </Style>
                                                                    </Button.Resources>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 4. Attached Media Previews -->
                                                        <ItemsControl Grid.Row="3" ItemsSource="{Binding AttachedImagePaths}" Visibility="{Binding HasAttachedImages, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#0D1117" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Margin="0,0,8,8" Width="90" Height="90" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                                            <!-- Delete Media Button -->
                                                                            <Button Command="{Binding DataContext.RemoveMediaItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Width="20" Height="20" Background="#CC000000" Foreground="#F87171" BorderThickness="0" Cursor="Hand">
                                                                                <Button.Resources>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="CornerRadius" Value="10"/>
                                                                                    </Style>
                                                                                </Button.Resources>
                                                                                <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- 5. Node Footer (+ Attach Media Button) -->
                                                        <Grid Grid.Row="4">
                                                            <Button Command="{Binding DataContext.AddMediaToNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Attach Image, JFIF, GIF or Video to this step" Padding="10,4" Background="#212836" Foreground="#1D9BF0" BorderBrush="#2F3336" BorderThickness="1" HorizontalAlignment="Left" Cursor="Hand">
                                                                <Button.Resources>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="CornerRadius" Value="6"/>
                                                                    </Style>
                                                                </Button.Resources>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xea72;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="Attach Media" FontSize="11.5" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <TextBlock Text="{Binding Content.Length, StringFormat='{}{0} chars'}" FontSize="11" Foreground="#6E7681" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 3. Bottom Status Bar -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,8">
                                <Grid>
                                    <TextBlock Text="💡 Studio: Supports Word document rich canvas with native pasted images, and multi-step sequential Twitter threads." FontSize="11.5" Foreground="#8B949E"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Offline ESE Windows Engine" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= RIGHT INSPECTOR PANEL (COLLAPSIBLE) ================= -->
                <Grid Grid.Column="2" Width="330" Background="{StaticResource InspectorBgBrush}" Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVis}}">

                    <!-- 1. EMPTY STATE (When NO post is selected) -->
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SelectedPost}" Value="{x:Null}"/>
                                            <Condition Binding="{Binding HasMultipleSelection}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✦" FontSize="36" Foreground="#2F3336" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Select a post to inspect details" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. MULTI-SELECTION STATE (When > 1 post is selected) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasMultipleSelection, Converter={StaticResource BoolToVis}}" Padding="20,18">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Multi-Selection" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}{0} posts selected'}" FontSize="12" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Command="{Binding CloseInspectorCommand}" ToolTip="Close Inspector Panel" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <!-- Primary Action Card -->
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="BULK ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,12"/>

                                    <!-- Bulk Move to Folder Menu -->
                                    <Menu Background="Transparent" Margin="0,0,0,8">
                                        <MenuItem Header="{Binding SelectedPostsCount, StringFormat='Move {0} Posts to Folder...'}" Background="#212836" BorderBrush="#2F3336" BorderThickness="1" Foreground="#1D9BF0" FontWeight="SemiBold" Padding="14,9" ItemsSource="{Binding Folders}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding Name}"/>
                                                    <Setter Property="Command" Value="{Binding DataContext.MoveSelectedPostsToFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding Name}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                    </Menu>

                                    <!-- Link Selected as Multi-Part Story -->
                                    <Button Command="{Binding LinkSelectedPostsAsStoryCommand}" Background="#1A3B5C" BorderBrush="#1D9BF0" BorderThickness="1" Foreground="#FFFFFF" Padding="14,9" Cursor="Hand" Margin="0,0,0,8">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                            <TextBlock Text="Link as Multi-Part Story" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Selected Posts -->
                                    <Button Command="{Binding DeleteSelectedPostsCommand}" Background="#DA3633" BorderBrush="#F85149" BorderThickness="1" Foreground="#FFFFFF" Padding="14,9" Cursor="Hand" Margin="0,0,0,8">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedPostsCount, StringFormat='{}Delete All {0} Posts'}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Clear Selection -->
                                    <Button Command="{Binding ClearSelectionCommand}" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="14,8" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deselect All" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Selected Items List Preview -->
                            <TextBlock Text="SELECTED POSTS" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedPosts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#161B22" BorderBrush="#252D38" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding AuthorName}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                    <emoji:TextBlock Text="{Binding ContentSnippet}" FontSize="11.5" Foreground="#8B949E" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1A3B5C" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding FolderName}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. SINGLE SELECTED POST INSPECTOR CONTENT -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,18">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMultipleSelection}" Value="False"/>
                                            <Condition Binding="{Binding SelectedPost, Converter={StaticResource NullToVis}}" Value="Visible"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <!-- Panel Title, Theater Mode Button, and Close Button -->
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="Post Inspector" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenTheaterModeCommand}" CommandParameter="{Binding SelectedPost}" Padding="10,4" Margin="0,0,8,0" Background="Transparent" Foreground="#1D9BF0" BorderBrush="#21262D" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xeb7d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Theater" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Close Inspector Button -->
                                    <Button Command="{Binding CloseInspectorCommand}" ToolTip="Close Inspector Panel" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" Width="26" Height="26">
                                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Details Table -->
                            <!-- 1. Author -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Author" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SelectedPost.AuthorName}" FontSize="13" FontWeight="SemiBold" Foreground="#E7E9EA"/>
                                    <TextBlock Text="{Binding SelectedPost.AuthorHandle, StringFormat='({0})'}" FontSize="12" Foreground="#8B949E"/>
                                </StackPanel>
                            </Grid>

                            <!-- 2. Folder (with quick Move to Folder ComboBox) -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Folder" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BadgeBgBrush}" CornerRadius="6" Padding="8,3" BorderBrush="#30363D" BorderThickness="1" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedPost.FolderName}" FontSize="12" FontWeight="SemiBold" Foreground="#1D9BF0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Notes / Comment (Optional) -->
                            <Grid Margin="0,0,0,14" Visibility="{Binding SelectedPost.HasComment, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Comment" FontSize="12" Foreground="#F0883E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <Border Grid.Column="1" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                    <emoji:TextBlock Text="{Binding SelectedPost.Comment}" FontSize="12.5" LineHeight="17" Foreground="#F0883E" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>

                            <!-- 3.5 Linked Multi-Part Story Navigation & Management -->
                            <Border Visibility="{Binding SelectedPost.IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#121820" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="MULTI-PART STORY" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedPost.ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Interactive Story Parts Pill List -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                        <ItemsControl ItemsSource="{Binding SelectedPostStoryParts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.JumpToStoryPartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Foreground="#E7E9EA">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <TextBlock Text="{Binding ThreadPartBadge}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Story Action Buttons (Prev, Next, View Full Story, Unlink) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SelectPreviousLinkedPartCommand}" ToolTip="Jump to Previous Linked Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,4">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="◀ Prev Part" FontSize="11"/>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding SelectNextLinkedPartCommand}" ToolTip="Jump to Next Linked Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,4">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Next Part ▶" FontSize="11"/>
                                        </Button>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding ViewFullStoryCommand}" CommandParameter="{Binding SelectedPost}" Background="#1D9BF0" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Padding="6,4" ToolTip="Filter feed to view all parts of this story">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="View Full Story" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding UnlinkFromStoryCommand}" CommandParameter="{Binding SelectedPost}" Background="#211818" BorderBrush="#4A2525" BorderThickness="1" Foreground="#F87171" Cursor="Hand" Padding="6,4" ToolTip="Detach post from this story thread">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="Unlink Post" FontSize="11"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. Date -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FormattedDate}" FontSize="12.5" Foreground="#E7E9EA" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 5. Local Path -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Local Path" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.FolderPath}" FontSize="11" Foreground="#9EACB9" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPost.FolderPath}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 6. Tags List -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tags" FontSize="12" Foreground="#8B949E" VerticalAlignment="Top" Margin="0,4,0,0"/>

                                <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedPost.TagList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,6" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.FilterByTagStringCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11" Foreground="#9EACB9"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Margin="0,10,0,0">
                                <!-- Open Theater Button — Ghost/Outline Style -->
                                
                                <!-- Open Local Folder Button -->
                                <Button Style="{StaticResource InspectorActionButton}" Command="{Binding OpenLocalFolderCommand}" CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Local Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Edit Post Content Button -->
                                <Button Style="{StaticResource InspectorActionButton}" Command="{Binding EditPostCommand}" CommandParameter="{Binding SelectedPost}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edit Post &amp; Media" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Delete Entry Button — subtle muted text, red on hover -->
                                <Button Command="{Binding DeletePostCommand}" CommandParameter="{Binding SelectedPost}" Height="36" Margin="0,4,0,0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="14,0">
                                                <TextBlock x:Name="delText" Text="Delete Entry" FontSize="12" Foreground="#6E7681" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#2A1B1D"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4C2328"/>
                                                    <Setter TargetName="delText" Property="Foreground" Value="#F87171"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- ================= TWITTER-STYLE THEATER MODE OVERLAY =================== -->
            <!-- ================= Left: Full Media/Video Player | Right: Tweet Details == -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0" Grid.RowSpan="2" Background="#F2000000" Visibility="{Binding IsTheaterModeOpen, Converter={StaticResource BoolToVis}}" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- LEFT: MEDIA / VIDEO STAGE (Twitter style) -->
                        <ColumnDefinition Width="380"/>
                        <!-- RIGHT: TWEET DETAILS & ACTIONS -->
                    </Grid.ColumnDefinitions>

                    <!-- Close Button in Theater Mode -->
                    <Button Command="{Binding CloseTheaterModeCommand}" Width="38" Height="38" Margin="16,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#33FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Panel.ZIndex="100">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="19"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- ================= LEFT MEDIA STAGE ================= -->
                    <Border Grid.Column="0" Background="#000000" ClipToBounds="True" x:Name="TheaterMediaStage" IsManipulationEnabled="True" ManipulationDelta="TheaterMediaStage_ManipulationDelta" ManipulationCompleted="TheaterMediaStage_ManipulationCompleted" PreviewMouseWheel="TheaterMediaStage_PreviewMouseWheel">
                        <Grid>
                            <!-- IMAGE VIEWER (When media is Image) -->
                            <Border Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource InverseBoolToVis}}" Padding="40">
                                <Image Source="{Binding CurrentTheaterMedia.FilePath}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- VIDEO PLAYER (When media is Video) -->
                            <Grid Visibility="{Binding IsTheaterMediaVideo, Converter={StaticResource BoolToVis}}">
                                <!-- Media Element Video Player with HighQuality rendering -->
                                <MediaElement x:Name="TheaterVideoPlayer" Source="{Binding CurrentTheaterMedia.FilePath}" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseDown="TheaterVideoPlayer_MouseDown" PreviewMouseWheel="TheaterVideoPlayer_PreviewMouseWheel" MediaOpened="TheaterVideoPlayer_MediaOpened" MediaEnded="TheaterVideoPlayer_MediaEnded"/>

                                <!-- Video Floating Glass Control Bar -->
                                <Border Background="#D9161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="24,0,24,24" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="700">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- Progress Slider -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- Play Controls & Time -->
                                        </Grid.RowDefinitions>

                                        <!-- Progress Slider -->
                                        <Slider x:Name="VideoProgressSlider" Grid.Row="0" Margin="0,0,0,8" Minimum="0" Maximum="100" Value="0" ValueChanged="VideoProgressSlider_ValueChanged" Cursor="Hand"/>

                                        <!-- Play Controls -->
                                        <Grid Grid.Row="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Play / Pause Toggle -->
                                                <Button x:Name="BtnPlayPause" Click="BtnPlayPause_Click" Background="#1D9BF0" Foreground="#FFFFFF" BorderThickness="0" Width="34" Height="34" Cursor="Hand" Margin="0,0,12,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock x:Name="TxtPlayIcon" Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Stop / Rewind -->
                                                <Button Click="BtnStopVideo_Click" Background="#252D38" Foreground="#E7E9EA" BorderThickness="0" Width="34" Height="34" Cursor="Hand" Margin="0,0,14,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="17"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="&#xea9f;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>

                                                <!-- Time Label -->
                                                <TextBlock x:Name="TxtVideoTime" Text="00:00 / 00:00" FontSize="12" Foreground="#9EACB9" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Volume / Mute Controls -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="&#xea6c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="VideoVolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" ValueChanged="VideoVolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Left / Right Carousel Navigation for Multi-Media Tweets -->
                            <Grid Visibility="{Binding HasMultipleTheaterMedia, Converter={StaticResource BoolToVis}}">
                                <!-- Previous Button (Left Arrow) -->
                                <Button Command="{Binding PreviousTheaterMediaCommand}" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="&#xea60;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                </Button>

                                <!-- Next Button (Right Arrow) -->
                                <Button Command="{Binding NextTheaterMediaCommand}" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Background="#66000000" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="22"/>
                                        </Style>
                                    </Button.Resources>
                                    <TextBlock Text="&#xea61;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Button>

                                <!-- Counter Badge (e.g. 1 / 3) -->
                                <Border Background="#99000000" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                                    <TextBlock Text="{Binding TheaterMediaCounter}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ================= RIGHT TWEET DETAILS PANEL (Twitter Style) ================= -->
                    <Border Grid.Column="1" Background="#0C1017" BorderBrush="#1C212A" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Top Bar / Close -->
                                <RowDefinition Height="*"/>
                                <!-- Tweet Body & Details -->
                                <RowDefinition Height="Auto"/>
                                <!-- Bottom Actions Bar -->
                            </Grid.RowDefinitions>

                            <!-- Close / Dismiss Header -->
                            <Border Grid.Row="0" Padding="18,14" BorderBrush="#1C212A" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="Archived Tweet" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Command="{Binding CloseTheaterModeCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand">
                                        <TextBlock Text="&#xea76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" FontWeight="Bold"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Tweet Content & Metadata -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18">
                                <StackPanel>
                                    <!-- Author Header (Avatar, Name, Handle, Folder) -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#252D38" BorderBrush="#2F3336" BorderThickness="1">
                                            <TextBlock Text="{Binding TheaterPost.AvatarInitial}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Name & Handle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TheaterPost.AuthorName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding TheaterPost.AuthorHandle}" FontSize="13" Foreground="#8B949E" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Folder Badge -->
                                        <Border Grid.Column="2" Background="{StaticResource BadgeBgBrush}" CornerRadius="6" Padding="10,4" BorderBrush="#30363D" BorderThickness="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TheaterPost.FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="#9EACB9"/>
                                        </Border>
                                    </Grid>

                                    <!-- Tweet Body Text (Large, Selectable) -->
                                    <emoji:TextBlock Text="{Binding TheaterPost.Content}" FontSize="15" LineHeight="24" Foreground="#E7E9EA" TextWrapping="Wrap" Margin="0,0,0,16" FontFamily="{StaticResource TweetContentFontFamily}"/>

                                    <!-- Multi-Part Story Navigation in Theater Mode -->
                                    <Border Visibility="{Binding TheaterPost.IsPartOfThread, Converter={StaticResource BoolToVis}}" Background="#121820" BorderBrush="#1D9BF0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xeb15;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="STORY / THREAD PART" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TheaterPost.ThreadPartBadge}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding SelectPreviousLinkedPartCommand}" ToolTip="Jump to Previous Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,5">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="◀ Prev" FontSize="11"/>
                                                </Button>
                                                <Button Grid.Column="2" Command="{Binding SelectNextLinkedPartCommand}" ToolTip="Jump to Next Part" Background="#212836" BorderBrush="#30363D" BorderThickness="1" Foreground="#8B949E" Cursor="Hand" Padding="6,5">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="Next ▶" FontSize="11"/>
                                                </Button>
                                                <Button Grid.Column="4" Command="{Binding ViewFullStoryCommand}" CommandParameter="{Binding TheaterPost}" Background="#1D9BF0" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand" Padding="6,5" ToolTip="View full story in feed">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <TextBlock Text="View All" FontSize="11" FontWeight="Bold"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Notes / Comment in Theater (if present) -->
                                    <Border Visibility="{Binding TheaterPost.HasComment, Converter={StaticResource BoolToVis}}" Background="#1A1814" BorderBrush="#6B3F18" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="&#xea6d;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" Foreground="#F0883E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="NOTE / COMMENT" FontSize="10" FontWeight="Bold" Foreground="#F0883E" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <emoji:TextBlock Text="{Binding TheaterPost.Comment}" FontSize="12.5" LineHeight="18" Foreground="#F0883E" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Formatted Date Timestamp (Twitter style) -->
                                    <Border BorderBrush="#1C212A" BorderThickness="0,1,0,1" Padding="0,12" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding TheaterPost.FormattedDate, StringFormat='{}{0} · Local Offline Archive'}" FontSize="12.5" Foreground="#8B949E"/>
                                    </Border>

                                    <!-- Tags Pill Chips -->
                                    <ItemsControl ItemsSource="{Binding TheaterPost.TagList}" Margin="0,0,0,20">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A222D" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="12" Foreground="#1D9BF0"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Local Disk Directory Path -->
                                    <Border Background="#12161F" CornerRadius="8" Padding="12" BorderBrush="#1C212A" BorderThickness="1" Margin="0,0,0,20">
                                        <StackPanel>
                                            <TextBlock Text="LOCAL MEDIA DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TheaterPost.FolderPath}" FontSize="11" Foreground="#9EACB9" TextTrimming="CharacterEllipsis" ToolTip="{Binding TheaterPost.FolderPath}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Bottom Action Buttons (Open Folder, Copy Text, Edit, Delete) -->
                            <Border Grid.Row="2" Background="#0A0D13" BorderBrush="#1C212A" BorderThickness="0,1,0,0" Padding="16,14">
                                <StackPanel>
                                    <!-- Open Folder Button -->
                                    <Button Style="{StaticResource InspectorActionButton}" Command="{Binding OpenLocalFolderCommand}" CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Open Local Media Folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Copy Tweet Text Button -->
                                    <Button Style="{StaticResource InspectorActionButton}" Command="{Binding CopyPostTextCommand}" CommandParameter="{Binding TheaterPost}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xea7a;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy Tweet Text" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Edit & Delete Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Command="{Binding EditPostCommand}" CommandParameter="{Binding TheaterPost}" Height="36" Background="#212836" Foreground="#E7E9EA" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xea73;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Edit Post" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2" Command="{Binding DeletePostCommand}" CommandParameter="{Binding TheaterPost}" Height="36" Background="#332B1818" Foreground="#F87171" BorderBrush="#66DC2626" BorderThickness="1" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xea81;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
