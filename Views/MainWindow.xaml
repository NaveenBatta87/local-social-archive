                                            </Border.Style>
                                        </Border>

                                        <!-- Icon -->
                                        <TextBlock Grid.Column="1" Text="&#xEB18;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8D96A6"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ActiveRailView}" Value="Feed"/>
                                                                <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
                                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#4CC2FF"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Label -->
                                        <TextBlock Grid.Column="2" Text="Timeline Feed" FontSize="13.5" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#C8D1DC"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ActiveRailView}" Value="Feed"/>
                                                                <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
                                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Count badge -->
                                        <TextBlock Grid.Column="3" Text="{Binding Posts.Count, StringFormat='{}{0:N0}'}" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Collections Hub Button -->
                                <Border Margin="0,2" CornerRadius="6" Cursor="Hand" Height="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsFoldersViewActive}" Value="True"/>
                                                        <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="#282E3B"/>
                                                </MultiDataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1F242F"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowFoldersHubCommand}"/>
