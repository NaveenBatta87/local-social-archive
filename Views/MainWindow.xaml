                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="True"/>
                                                                <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
