<Window x:Class="LocalSocialArchive.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
    xmlns:models="clr-namespace:LocalSocialArchive.Models"
    xmlns:converters="clr-namespace:LocalSocialArchive.Converters"
    xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel" mc:Ignorable="d" Title="Local Social Archive" Height="820" Width="1320" MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen" Background="{DynamicResource BgDarkBrush}" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" WindowStyle="None" AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Windows 11 Fluent Slate Palette (Matching Approved Mockup) -->
        <SolidColorBrush x:Key="BgDarkBrush" Color="#1C2028"/>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#181C23"/>
        <SolidColorBrush x:Key="RailBgBrush" Color="#181C23"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#202530"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2F3644"/>
        <SolidColorBrush x:Key="CardBorderHoverBrush" Color="#3B4456"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="#1A2D42"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9DA5B4"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7681"/>
        <SolidColorBrush x:Key="BadgeBgBrush" Color="#232731"/>
        <SolidColorBrush x:Key="InspectorBgBrush" Color="#181C23"/>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#30363D"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#30363D" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#212836"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1A3B5C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="⌵" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#45BAEA"/>
                    <Setter TargetName="border" Property="Background" Value="#212836"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggleButton}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter IsHitTestVisible="false" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="true" Focusable="false" PopupAnimation="Slide">
                                <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Padding="4" Margin="0,4,0,0">
                                    <ScrollViewer CanContentScroll="true">
                                        <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Title Bar Buttons Style -->
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rail Icon Button Style -->
        <Style x:Key="RailIconStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                                <Setter Property="Foreground" Value="#1D9BF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (Inspector) -->
        <Style x:Key="InspectorActionButton" TargetType="Button">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E7E9EA"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#21262D"/>
                                <Setter Property="BorderBrush" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateNewPostCommand}"/>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding CreateNewFolderCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CreateNewCollectionCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding NavigateHomeCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFoldersHubCommand}"/>
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ToggleInspectorCommand}"/>
        <KeyBinding Key="I" Modifiers="Control+Shift" Command="{Binding OpenImportArchiveCommand}"/>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockVaultCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInGridCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInGridCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutGridCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutGridCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control+Shift" Command="{Binding ZoomInAppCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control+Shift" Command="{Binding ZoomInAppCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control+Shift" Command="{Binding ZoomOutAppCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control+Shift" Command="{Binding ZoomOutAppCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetAppScaleCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetAppScaleCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshDataCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding CloseTheaterModeCommand}"/>
    </Window.InputBindings>

    <!-- Main Container Frame -->
    <Border BorderBrush="#252A34" BorderThickness="1" Background="{DynamicResource BgDarkBrush}">
        <Grid>
            <!-- Application Dynamic UI Zoom / Scale (Default 125%) -->
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding AppScale}" ScaleY="{Binding AppScale}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <!-- Titlebar / Top Header (Spacious) -->
                <RowDefinition Height="*"/>
                <!-- Main Content Workspace -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER / TITLEBAR ================= -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="#252A34" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="200"/>
                        <!-- App Title & Glowing Icon -->
                        <ColumnDefinition Width="*"/>
                        <!-- Responsive Fluid Search Pill (Auto-adjusts to window/screen size) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Quick Actions + App Zoom + Caption Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Logo (Clickable to Home) -->
                    <Button Grid.Column="0" Command="{Binding NavigateHomeCommand}" ToolTip="Home Dashboard" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Glowing gradient folder box matching concept mockup -->
                            <Border Width="30" Height="30" CornerRadius="8" Background="#1A2432" BorderBrush="#4CC2FF" BorderThickness="1.5" Margin="0,0,10,0">
                                <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <TextBlock Text="Local Social Archive" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Responsive Fluent Search Pill (Adjusts dynamically to screen size) -->
                    <Border Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="180" MaxWidth="640" Height="34" Margin="12,0" Background="#232731" BorderThickness="1" CornerRadius="17" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#333946"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchInputBox, Path=IsFocused}" Value="True">
                                        <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                        <Setter Property="Background" Value="#1C2433"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="#4A5263"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xEA6D;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8D96A6" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchInputBox" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="12.5" VerticalAlignment="Center" CaretBrush="#60CDFF">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search posts (e.g. from:user, has:media, is:thread)..." Foreground="#8D96A6" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ctrl+K Shortcut Badge (Visible when search is empty) -->
                                <Border Visibility="{Binding SearchQuery, Converter={StaticResource InverseNullToVis}}" Background="#2B3240" CornerRadius="4" Padding="5,2" Margin="0,0,2,0" VerticalAlignment="Center" ToolTip="Press Ctrl+K to search">
                                    <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="SemiBold" Foreground="#8D96A6"/>
                                </Border>
                                <!-- Clear Button (Visible when search has text) -->
                                <Button Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchQuery, Converter={StaticResource NullToVis}}" Background="Transparent" BorderThickness="0" Foreground="#8D96A6" Cursor="Hand" Width="18" Height="18" VerticalAlignment="Center" ToolTip="Clear Search (Esc)">
                                    <TextBlock Text="&#xEA76;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: New Post + Quick Paste Pill Buttons + Native Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- New Post Pill Button (Primary Action) -->
                        <Button Command="{Binding CreateNewPostCommand}" ToolTip="Create New Post (Ctrl+N)" Height="32" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#38BDF8" CornerRadius="16" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#041224" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="New Post" FontSize="12" FontWeight="Bold" Foreground="#041224" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#60CDFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quick Paste Pill Button (Matching Mockup) -->
                        <Button Command="{Binding PasteFromClipboardCommand}" ToolTip="Quick Paste (Ctrl+V)" Height="32" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#232731" BorderBrush="#333946" BorderThickness="1" CornerRadius="16" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEAC2;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quick Paste" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2D3340"/>
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4A5263"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Story Creator Button -->
                        <Button Command="{Binding OpenStoryExportCommand}" ToolTip="Post Thread as Story (9:16 Canvas &amp; PNG Export)" Height="32" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#1D2A3A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="16" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📱" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Story Creator" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#25384E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Document Canvas Button -->
                        <Button Command="{Binding OpenStoryCanvasCommand}" ToolTip="Open Word-like Document Canvas (Inline images, Clean styling &amp; 12MB splitting)" Height="32" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#1D2A3A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="16" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📝" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Document Canvas" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#25384E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Import Archive / Download Pill Button -->
                        <Button Command="{Binding OpenImportArchiveCommand}" ToolTip="Import Twitter Archive or Download Profile (Ctrl+Shift+I)" Height="32" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="#232731" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="16" Padding="14,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xEA9C;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Import" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#1A2D3D"/>
                                            <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60CDFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- App Zoom Selector Pill Menu -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <MenuItem Background="#232731" BorderBrush="#333946" BorderThickness="1" Cursor="Hand" Padding="10,4" ToolTip="App UI Zoom Scale (Ctrl+Shift++ / Ctrl+Shift+- / Ctrl+0)">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA88;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="12" Foreground="#8D96A6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AppScalePercentageText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style>
                                </MenuItem.Resources>
                                <MenuItem Header="100% (Standard)" Command="{Binding SetAppScaleCommand}" CommandParameter="1.0"/>
                                <MenuItem Header="115% (Comfortable)" Command="{Binding SetAppScaleCommand}" CommandParameter="1.15"/>
                                <MenuItem Header="125% (Recommended - Spacious)" Command="{Binding SetAppScaleCommand}" CommandParameter="1.25" FontWeight="Bold"/>
                                <MenuItem Header="135% (Large)" Command="{Binding SetAppScaleCommand}" CommandParameter="1.35"/>
                                <MenuItem Header="150% (Extra Large)" Command="{Binding SetAppScaleCommand}" CommandParameter="1.50"/>
                                <Separator Background="#2F3644"/>
                                <MenuItem Header="Reset to 125% (Ctrl+0)" Command="{Binding ResetAppScaleCommand}"/>
                            </MenuItem>
                        </Menu>

                        <!-- Native Vector Window Caption Buttons (Minimize, Maximize, Close) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButtonStyle}" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Width="10" Height="1" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0,0 L 10,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButtonStyle}" Click="Maximize_Click" ToolTip="Maximize">
                                <Path Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"/>
                            </Button>
