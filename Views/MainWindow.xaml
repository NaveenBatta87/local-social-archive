                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Icon -->
                                        <TextBlock Grid.Column="1" Text="&#xEB9F;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8D96A6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveRailView}" Value="Media">
                                                            <Setter Property="Foreground" Value="#4CC2FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Label -->
