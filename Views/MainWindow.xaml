                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Timeline Feed Button -->
                                <Border Margin="0,2" CornerRadius="6" Cursor="Hand" Height="40">
