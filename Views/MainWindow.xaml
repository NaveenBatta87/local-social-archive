                                                    <Setter Property="Foreground" Value="#C8D1DC"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveRailView}" Value="Media">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Tags & Discover Button -->
                                <Border Margin="0,2" CornerRadius="6" Cursor="Hand" Height="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveRailView}" Value="Tags">
                                                    <Setter Property="Background" Value="#282E3B"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1F242F"/>
                                                </Trigger>
