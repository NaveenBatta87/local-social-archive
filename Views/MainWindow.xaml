                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="True"/>
                                                                <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="#4CC2FF"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Label -->
                                        <TextBlock Grid.Column="2" Text="Collections Hub" FontSize="13.5" VerticalAlignment="Center" Margin="8,0,0,0">
