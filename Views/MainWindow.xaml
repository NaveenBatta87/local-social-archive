                                </Border>

                                <!-- Media Gallery Button -->
                                <Border Margin="0,2" CornerRadius="6" Cursor="Hand" Height="40">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
