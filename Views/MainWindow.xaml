                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Indicator Pill -->
                                        <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" Background="#4CC2FF" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ActiveRailView}" Value="Feed"/>
                                                                <Condition Binding="{Binding IsHomeDashboardActive}" Value="False"/>
                                                                <Condition Binding="{Binding IsFoldersViewActive}" Value="False"/>
