<Window x:Class="LocalSocialArchive.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock Vault — Local Social Archive"
        Height="420" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        MouseDown="Window_MouseDown">

    <!-- Outer Elevated Container -->
    <Border Background="#0D1117" BorderBrush="#2F3336" BorderThickness="1.5" CornerRadius="18" Padding="28,24">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Brand & Close -->
                <RowDefinition Height="Auto"/> <!-- Title & Subtitle -->
                <RowDefinition Height="Auto"/> <!-- Password Input Field -->
                <RowDefinition Height="Auto"/> <!-- Error Message -->
                <RowDefinition Height="*"/>    <!-- Unlock & Exit Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Top Brand & Close Button -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#161B22" BorderBrush="#1D9BF0" BorderThickness="2">
                        <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Button Click="BtnExit_Click" ToolTip="Exit Application"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Header Texts -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,20">
                <TextBlock Text="Offline Vault Protected" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Enter your master password to unlock your offline archive." FontSize="12.5" Foreground="#8B949E"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 3. Password Box -->
            <Border Grid.Row="2" Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔑" FontSize="14" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFF" FontSize="15" CaretBrush="#1D9BF0"
                                 VerticalAlignment="Center" Margin="6,0,0,0"
                                 KeyDown="TxtPassword_KeyDown"/>
                </Grid>
            </Border>

            <!-- 4. Error Message Banner -->
            <Border x:Name="ErrorBorder" Grid.Row="3" Background="#261A1A" BorderBrush="#5C2626" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="12" Foreground="#F87171"/>
                    <TextBlock x:Name="TxtError" Text="Incorrect master password. Please try again." FontSize="12" Foreground="#F87171" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 5. Action Buttons -->
            <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,20,0,0">
                <Button Click="BtnUnlock_Click" IsDefault="True"
                        Height="42" Background="#1D9BF0" Foreground="#FFFFFF"
                        FontSize="13.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔓 " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Unlock Archive" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnExit_Click"
                        Height="36" Background="Transparent" Foreground="#8B949E"
                        FontSize="12.5" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="Cancel &amp; Exit" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
