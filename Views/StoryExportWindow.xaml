<Window x:Class="LocalSocialArchive.Views.StoryExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        xmlns:views="clr-namespace:LocalSocialArchive.Views"
        xmlns:models="clr-namespace:LocalSocialArchive.Models"
        mc:Ignorable="d"
        Title="Post Thread as Story — Local Social Archive"
        Width="1180" Height="880" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#E7E9EA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousCardCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextCardCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteFromClipboardCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportStoryCommand}"/>
    </Window.InputBindings>

    <!-- Main Container Frame -->
    <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Background="#0D1117" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Workspace -->
                <RowDefinition Height="56"/> <!-- Footer Action Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. HEADER ================= -->
            <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Button & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Close_Click" ToolTip="Back (Esc)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="10,6" Cursor="Hand" Margin="0,0,14,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" FontSize="14" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="28" CornerRadius="7" Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="📱" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Post Thread as Story" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Detected Status Badge -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" CornerRadius="6" Padding="12,4">
                        <TextBlock Text="{Binding CardIndicatorText, StringFormat='Story Preview • {0}'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>

                    <!-- Right: Window Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Minimize_Click" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Maximize_Click" ToolTip="Maximize / Restore" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Close_Click" ToolTip="Close" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2. WORKSPACE ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370" MinWidth="320"/> <!-- Left Config Sidebar -->
                    <ColumnDefinition Width="*"/>                    <!-- Center Live Story Canvas -->
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="#11151C" BorderBrush="#21262D" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
                        <StackPanel>
                            <!-- Section: Ingestion -->
                            <TextBlock Text="THREAD SOURCE" FontSize="11" FontWeight="Bold" Foreground="#6E7681" Margin="0,0,0,10"/>
                            <Button Command="{Binding PasteFromClipboardCommand}" ToolTip="Read thread from clipboard (Ctrl+V)"
                                    Background="#1F2A38" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8"
                                    Padding="14,10" Cursor="Hand" Margin="0,0,0,12">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Paste Thread from Clipboard" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Detected Tweets:" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1A2D42" CornerRadius="5" Padding="8,2">
                                        <TextBlock Text="{Binding DetectedItemsCount, StringFormat='{}{0} Parts'}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Rectangle Height="1" Fill="#21262D" Margin="0,0,0,18"/>

                            <!-- Section: Layout Mode -->
                            <TextBlock Text="LAYOUT MODE" FontSize="11" FontWeight="Bold" Foreground="#6E7681" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Auto-Fit" IsChecked="{Binding IsAutoFit}"
                                             Foreground="#E7E9EA" FontSize="12.5" Cursor="Hand" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <RadioButton Grid.Column="1" Content="Custom" IsChecked="{Binding IsAutoFit, Converter={StaticResource InverseBool}}"
                                             Foreground="#E7E9EA" FontSize="12.5" Cursor="Hand" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Custom Controls (Visible when not Auto-Fit) -->
                            <StackPanel Visibility="{Binding IsAutoFit, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Font Size" FontSize="12" Foreground="#8B949E"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomFontSize, StringFormat='{}{0:F0} px'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Grid>
                                <Slider Minimum="28" Maximum="50" Value="{Binding CustomFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" Cursor="Hand"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="#21262D" Margin="0,0,0,18"/>

                            <!-- Section: Theme & Styling -->
                            <TextBlock Text="STORY THEME" FontSize="11" FontWeight="Bold" Foreground="#6E7681" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                      Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="10,8" Margin="0,0,0,20" Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StoryTheme}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding BackgroundHex, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{Binding AccentHex, Converter={StaticResource HexToBrush}}" BorderThickness="1.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Rectangle Height="1" Fill="#21262D" Margin="0,0,0,18"/>

                            <!-- Section: Media Option -->
                            <TextBlock Text="MEDIA &amp; ASSETS" FontSize="11" FontWeight="Bold" Foreground="#6E7681" Margin="0,0,0,10"/>
                            <CheckBox IsChecked="{Binding IncludeMedia, Mode=TwoWay}" Foreground="#E7E9EA" FontSize="12.5" Cursor="Hand" Margin="0,0,0,20">
                                <TextBlock Text="Include Attached Media Images" FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>

                            <Rectangle Height="1" Fill="#21262D" Margin="0,0,0,18"/>

                            <!-- Section: Author Details Override -->
                            <TextBlock Text="AUTHOR DETAILS" FontSize="11" FontWeight="Bold" Foreground="#6E7681" Margin="0,0,0,10"/>
                            <TextBlock Text="Name" FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="8,6" Margin="0,0,0,10"/>

                            <TextBlock Text="Handle" FontSize="11.5" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AuthorHandle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#161B22" Foreground="#FFFFFF" BorderBrush="#30363D" Padding="8,6" Margin="0,0,0,16"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- CENTER WORKSPACE: 9:16 LIVE STORY CANVAS -->
                <Grid Grid.Column="1" Background="#0A0D12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scaled Live Canvas inside Viewbox -->
                    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="24,20,24,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Shadow Border wrapper for realism -->
                        <Border Width="1080" Height="1920" CornerRadius="36" ClipToBounds="True" BorderBrush="#30363D" BorderThickness="3">
                            <views:StoryCardCanvasView DataContext="{Binding CurrentCard}"/>
                        </Border>
                    </Viewbox>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" Padding="0,0,0,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding PreviousCardCommand}" IsEnabled="{Binding CanGoPrevious}"
                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9"
                                    Padding="14,6" Cursor="Hand" Margin="0,0,12,0">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◀" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Previous" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="16,6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CardIndicatorText}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>

                            <Button Command="{Binding NextCardCommand}" IsEnabled="{Binding CanGoNext}"
                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9"
                                    Padding="14,6" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Next" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="▶" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= 3. FOOTER ACTION BAR ================= -->
            <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status message & Progress info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ " FontSize="12" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#8B949E"/>
                    </StackPanel>

                    <!-- Right: Export Button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ExportStoryCommand}" IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}"
                                Background="#238636" BorderThickness="0" Foreground="#FFFFFF" Padding="18,9" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export Story (1080 × 1920 PNG)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
