<Window x:Class="LocalSocialArchive.Views.StoryCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        mc:Ignorable="d"
        Title="Document Canvas (Word Mode) — Local Social Archive"
        Width="1100" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#191919"
        Foreground="#E1E1E1"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteFromClipboardCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveStoryDocumentCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="10" Background="#191919" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/> <!-- Word-like Dark Titlebar -->
                <RowDefinition Height="50"/> <!-- Action Toolbar -->
                <RowDefinition Height="*"/>  <!-- Word Page Canvas -->
                <RowDefinition Height="28"/> <!-- Bottom Word Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. WORD-STYLE DARK TITLEBAR ================= -->
            <Border Grid.Row="0" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back & Word Document Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Close_Click" ToolTip="Back (Esc)" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" Foreground="#C9D1D9" Padding="9,5" Cursor="Hand" Margin="0,0,12,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" FontSize="13" FontWeight="Bold" Margin="0,-1,5,0"/>
                                <TextBlock Text="Back" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Word Blue Icon -->
                        <Border Width="26" Height="26" CornerRadius="5" Background="#185ABD" Margin="0,0,10,0">
                            <TextBlock Text="W" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Document Canvas" FontSize="13" FontWeight="SemiBold" Foreground="#E1E1E1" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Editable Document Name -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox Text="{Binding DocumentTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#E1E1E1" FontSize="13" FontWeight="SemiBold"
                                 HorizontalContentAlignment="Center" CaretBrush="#38BDF8" MinWidth="180" ToolTip="Click to rename document"/>
                        <TextBlock Text=" • Archive Document" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Minimize_Click" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Maximize_Click" ToolTip="Maximize / Restore" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Close_Click" ToolTip="Close" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2. MINIMAL ACTION TOOLBAR ================= -->
            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Paste & Clean Styling (No formatting waste!) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Primary Paste Action -->
                        <Button Click="PasteButton_Click" ToolTip="Paste entire thread or article with inline images (Ctrl+V)"
                                Background="#185ABD" BorderThickness="0" Foreground="#FFFFFF" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Paste (Ctrl+V)" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Clean Text Styling Button (Requested Feature!) -->
                        <Button Click="CleanTextStylingButton_Click" ToolTip="Strip website HTML styling, colors, and weird fonts while leaving all inline images in place!"
                                Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Foreground="#38BDF8" Padding="12,6" Cursor="Hand" Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧹" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Clean Text Styling" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Size Tracker + Part Navigation + Save + Reader -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 12 MB Size Tracker Badge -->
                        <Border BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="BorderBrush" Value="#383838"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Is12MBWarningVisible}" Value="True">
                                            <Setter Property="Background" Value="#3D1A1A"/>
                                            <Setter Property="BorderBrush" Value="#E81123"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦 " FontSize="11" Foreground="#8B949E"/>
                                <TextBlock Text="{Binding SizeBadgeText}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <!-- Split into Part 2 Button -->
                        <Button Click="SplitPartButton_Click" ToolTip="Split content into Part 2 (recommended when exceeding 12 MB)"
                                Background="#2A2A2A" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" Padding="10,5" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="Split Part" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Part Stepper -->
                        <Border Background="#252525" BorderBrush="#383838" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Click="PreviousPartButton_Click" IsEnabled="{Binding CanGoPreviousPart}" ToolTip="Previous Part" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="◀" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock Text="{Binding PartIndicatorText}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="6,0"/>
                                <Button Click="NextPartButton_Click" IsEnabled="{Binding CanGoNextPart}" ToolTip="Next Part" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="▶" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Cancel Button (Requested) -->
                        <Button Click="Close_Click" ToolTip="Discard changes and exit Document Canvas (Esc)"
                                Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Foreground="#C9D1D9" Padding="12,6" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✕" FontSize="11" Margin="0,0,5,0" Foreground="#F87171" FontWeight="Bold"/>
                                <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Save Story Button -->
                        <Button Click="SaveButton_Click" ToolTip="Save all document parts to offline archive (Ctrl+S)"
                                Background="#238636" BorderThickness="0" Foreground="#FFFFFF" Padding="14,6" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Save Story" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Open in Document Reader -->
                        <Button Click="OpenReaderButton_Click" ToolTip="View in separate Document Reader interface"
                                Background="#2A2A2A" BorderBrush="#404040" BorderThickness="1" Foreground="#E1E1E1" Padding="11,6" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="12" Margin="0,0,5,0"/>
                                <TextBlock Text="Reader View" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 3. WORD DOCUMENT PAGE CANVAS ================= -->
            <ScrollViewer Grid.Row="2" x:Name="CanvasScrollViewer" Background="#141414" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,28">
                <StackPanel Width="820" HorizontalAlignment="Center">
                    <!-- Microsoft Word Dark Mode Page Sheet -->
                    <Border Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="0" MinHeight="1020" Margin="0,0,0,40">
                        <RichTextBox x:Name="WordRichTextBox"
                                     Background="#2B2B2B"
                                     Foreground="#E1E1E1"
                                     CaretBrush="#FFFFFF"
                                     BorderThickness="0"
                                     FontSize="15.5"
                                     FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
                                     VerticalScrollBarVisibility="Disabled"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     IsDocumentEnabled="True"
                                     Padding="0"
                                     Margin="0"
                                     TextChanged="WordRichTextBox_TextChanged"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 4. WORD BOTTOM STATUS BAR ================= -->
            <Border Grid.Row="3" Background="#1A1A1A" BorderBrush="#252525" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PartIndicatorText, StringFormat='Page {0}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="20,0"/>
                    <TextBlock Grid.Column="2" Text="Word Canvas • Inline Images Kept in Flow" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
