<Window x:Class="LocalSocialArchive.Views.ThreadReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        xmlns:models="clr-namespace:LocalSocialArchive.Models"
        xmlns:converters="clr-namespace:LocalSocialArchive.Converters"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="{Binding StoryTitle, StringFormat='{}Thread Reader — {0}'}"
        Width="960" Height="840" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#E7E9EA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=CloseCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInFontCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInFontCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutFontCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutFontCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetFontCommand}"/>
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CopyStoryCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ExportMarkdownCommand}"/>
    </Window.InputBindings>

    <!-- Main Container Frame with Dynamic Theme Support -->
    <Border x:Name="RootBorder" BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Background="#0D1117" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Reader Top Header / Toolbar -->
                <RowDefinition Height="*"/>  <!-- Article Reading Stream -->
                <RowDefinition Height="30"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. READER TOOLBAR ================= -->
            <Border Grid.Row="0" x:Name="TopHeaderBorder" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Button & Reader Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Close_Click" ToolTip="Back to Archive (Esc)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="10,6" Cursor="Hand" Margin="0,0,14,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" FontSize="14" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="28" CornerRadius="7" Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="📖" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Thread Reader" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Story Title Snippet (Clickable to scroll to top) -->
                    <TextBlock Grid.Column="1" Text="{Binding StoryTitle}" FontSize="12.5" Foreground="#8B949E" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>

                    <!-- Right Actions: Folder Changer + Font Zoom + Theme + Copy + Export + Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Move Thread to Folder Menu -->
                        <Menu Background="Transparent" Margin="0,0,8,0">
                            <MenuItem Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Cursor="Hand" Padding="10,5" ToolTip="Organize Thread: Move to another folder">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FolderName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ⌵" FontSize="9" Foreground="#8B949E" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem.ItemsSource>
                                    <Binding Path="AvailableFolders"/>
                                </MenuItem.ItemsSource>
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}"/>
                                        <Setter Property="Command" Value="{Binding DataContext.MoveToFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                        <Setter Property="Background" Value="#161B22"/>
                                        <Setter Property="Foreground" Value="#E7E9EA"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </Menu>

                        <!-- Font Size Controls -->
                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ZoomOutFontCommand}" ToolTip="Decrease Font Size (Ctrl+-)" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="A-" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding ResetFontCommand}" ToolTip="Reset Font Size (Ctrl+0)" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="22" Height="26" Cursor="Hand">
                                    <TextBlock Text="•" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding ZoomInFontCommand}" ToolTip="Increase Font Size (Ctrl++)" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="A+" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Theme Toggle Button -->
                        <Button Command="{Binding CycleThemeCommand}" ToolTip="Toggle Reader Theme (Dark Slate / OLED / Sepia)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="9,5" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveTheme}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Copy Story Button -->
                        <Button Command="{Binding CopyStoryCommand}" ToolTip="Copy Full Story as Clean Markdown (Ctrl+Shift+C)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#38BDF8" Padding="10,5" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Story" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Post as Story Button -->
                        <Button Command="{Binding OpenStoryExportCommand}" ToolTip="Generate 9:16 Story Cards / Export PNGs" Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" Padding="10,5" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📱" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Post as Story" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Document Reader Button -->
                        <Button Command="{Binding OpenDocumentReaderCommand}" ToolTip="View in Document Reader (Word-like inline images &amp; next part progression)" Background="#142436" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" Padding="10,5" Margin="0,0,8,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Doc Reader" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Export Button -->
                        <Button Command="{Binding ExportMarkdownCommand}" ToolTip="Save Story as .md File (Ctrl+S)" Background="#238636" BorderThickness="0" Foreground="#FFFFFF" Padding="10,5" Margin="0,0,14,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export .md" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Window Caption Buttons -->
                        <Button Click="Minimize_Click" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Maximize_Click" ToolTip="Maximize / Restore" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Close_Click" ToolTip="Close" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2. ARTICLE READING STREAM ================= -->
            <ScrollViewer Grid.Row="1" x:Name="ArticleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center">

                    <!-- ARTICLE HERO HEADER -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Author Profile & Meta Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Author Avatar Circle -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#1D2E42" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding AuthorAvatarInitial}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Author Name, Handle & Folder -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AuthorName}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="✓" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding AuthorHandle}" FontSize="13" Foreground="#8B949E" Margin="0,0,10,0"/>
                                        <Border Background="#21262D" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding FolderName, StringFormat='📁 {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Thread Stats Badges -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TotalTweetsCount, StringFormat='🧵 {0} Tweets'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                    <TextBlock Text="{Binding ReadingTimeText, StringFormat='⏱ {0}'}" FontSize="11.5" Foreground="#8B949E" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Story Date -->
                            <TextBlock Text="{Binding PostDateText, StringFormat='Published on {0}'}" FontSize="12.5" Foreground="#8B949E" Margin="0,0,0,14"/>

                            <!-- Divider Line -->
                            <Rectangle Height="1" Fill="#21262D" Margin="0,0,0,16"/>

                            <!-- Story Title / Headline -->
                            <TextBlock Text="{Binding StoryTitle}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="30"/>
                        </StackPanel>
                    </Border>

                    <!-- CONTINUOUS TWEET STREAM -->
                    <ItemsControl ItemsSource="{Binding Posts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Post}">
                                <Border Margin="0,0,0,18" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12" Padding="24,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Part Counter Badge & Timeline Line -->
                                        <Grid Grid.Column="0" Margin="0,2,12,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Width="30" Height="26" CornerRadius="6" Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ThreadIndex, StringFormat='{}{0}'}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Vertical Timeline Guide -->
                                            <Rectangle Grid.Row="1" Width="2" Fill="#21262D" HorizontalAlignment="Center" Margin="0,8,12,0"/>
                                        </Grid>

                                        <!-- Right: Tweet Content & Media -->
                                        <StackPanel Grid.Column="1">
                                            <!-- Tweet Text Content with Rich Emojis -->
                                            <emoji:TextBlock Text="{Binding Content}"
                                                             FontSize="{Binding DataContext.ReaderFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Foreground="#E7E9EA"
                                                             TextWrapping="Wrap"
                                                             LineHeight="26"
                                                             Margin="0,0,0,12"/>

                                            <!-- Attached Media Items (Images or Videos) -->
                                            <ItemsControl ItemsSource="{Binding MediaItems}" Margin="0,4,0,8" Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:MediaItem}">
                                                        <Border Margin="0,4,0,8" CornerRadius="10" ClipToBounds="True" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" MaxHeight="460">
                                                            <Image Source="{Binding FilePath, Converter={StaticResource ThumbImageConverter}}" Stretch="Uniform" MaxHeight="460"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Personal Note / Comment Callout (if any) -->
                                            <Border Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}" Background="#1A2634" BorderBrush="#2F4864" BorderThickness="1,0,0,0" Padding="12,8" Margin="0,8,0,4" CornerRadius="0,6,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                                    <emoji:TextBlock Text="{Binding Comment}" FontSize="12.5" Foreground="#79C0FF" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Footer Timestamp -->
                                            <TextBlock Text="{Binding PostDate, StringFormat='{}{0:h:mm tt • MMM dd, yyyy}'}" FontSize="11" Foreground="#6E7681" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ARTICLE FOOTER -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="12" Padding="28,24" Margin="0,8,0,32" HorizontalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✦  END OF THREAD  ✦" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding TotalWordCount, StringFormat='Archived thread sequence containing {0} words.'}" FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding CopyStoryCommand}" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#38BDF8" Padding="14,8" Cursor="Hand" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Copy Full Story" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding OpenStoryExportCommand}" Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" Padding="14,8" Cursor="Hand" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📱" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Export Story Cards" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ExportMarkdownCommand}" Background="#238636" BorderThickness="0" Foreground="#FFFFFF" Padding="14,8" Cursor="Hand" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Export as Markdown" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="Close_Click" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="14,8" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                    </Button.Resources>
                                    <TextBlock Text="Back to Feed" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 3. BOTTOM STATUS BAR ================= -->
            <Border Grid.Row="2" Background="#0A0D12" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Shortcuts: Esc to exit • Ctrl++ / Ctrl+- to zoom font • Ctrl+S to export" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
