<Window x:Class="LocalSocialArchive.Views.ImportThreadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        xmlns:models="clr-namespace:LocalSocialArchive.Models"
        xmlns:converters="clr-namespace:LocalSocialArchive.Converters"
        mc:Ignorable="d"
        Title="Unroll &amp; Import Thread — Local Social Archive"
        Width="1080" Height="740" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#1C2028"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Custom ScrollBar Theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2F3644" BorderThickness="1" CornerRadius="12" Background="#1C2028" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>   <!-- Main 2-Column Workspace -->
                <RowDefinition Height="58"/>  <!-- Footer Action Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. WINDOW TITLE BAR ================= -->
            <Border Grid.Row="0" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,0,0,1" Padding="20,0" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#1D2E42" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,12,0">
                            <TextBlock Text="🧵" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thread Unroller &amp; Importer" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Archive full Twitter threads from Thread Reader App or unroll sites as linked stories" FontSize="11" Foreground="#8D96A6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Foreground="#8D96A6" Width="36" Height="32" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close (Esc)">
                        <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ================= 2. MAIN 2-COLUMN WORKSPACE ================= -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480" MinWidth="380"/> <!-- Left: Input & Config -->
                    <ColumnDefinition Width="16"/>                 <!-- Spacer -->
                    <ColumnDefinition Width="*" MinWidth="360"/>   <!-- Right: Live Segment Cards -->
                </Grid.ColumnDefinitions>

                <!-- ========== LEFT PANE: SOURCE TEXT & SETTINGS ========== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action bar above text -->
                        <RowDefinition Height="*"/>    <!-- Text Area -->
                        <RowDefinition Height="Auto"/> <!-- Settings / Meta -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Source Text / HTML" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Command="{Binding PasteFromClipboardCommand}" Background="#202530" BorderBrush="#3B4456" BorderThickness="1" Foreground="#4CC2FF" Padding="10,4" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Paste from Clipboard" FontSize="11.5" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DockPanel>

                    <!-- Large Input TextBox -->
                    <Border Grid.Row="1" Background="#161A22" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="10">
                        <TextBox Text="{Binding RawInputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#E7E9EA" BorderThickness="0" FontFamily="Consolas, Segoe UI, sans-serif" FontSize="12.5" CaretBrush="#38BDF8"/>
                    </Border>

                    <!-- Split Rules & Metadata Form -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <!-- Split Rule Selector -->
                        <TextBlock Text="Thread Splitting Method" FontSize="11.5" FontWeight="SemiBold" Foreground="#8D96A6" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding SplitModeOptions}" SelectedItem="{Binding SelectedSplitMode}" Background="#202530" Foreground="#E7E9EA" BorderBrush="#2F3644" BorderThickness="1" Padding="8,6" Margin="0,0,0,10"/>

                        <!-- Author & Handle Fields -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Author Name" FontSize="11" Foreground="#8D96A6" Margin="0,0,0,3"/>
                                <Border Background="#161A22" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="6">
                                    <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="8,6" FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Handle" FontSize="11" Foreground="#8D96A6" Margin="0,0,0,3"/>
                                <Border Background="#161A22" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="6">
                                    <TextBox Text="{Binding AuthorHandle, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" Padding="8,6" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Folder & Tags Fields -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Folder" FontSize="11" Foreground="#8D96A6" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding AvailableFolders}" SelectedItem="{Binding TargetFolder}" IsEditable="True" Background="#202530" Foreground="#E7E9EA" BorderBrush="#2F3644" BorderThickness="1" Padding="8,6" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Tags" FontSize="11" Foreground="#8D96A6" Margin="0,0,0,3"/>
                                <Border Background="#161A22" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="6">
                                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#E7E9EA" Padding="8,6" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ========== RIGHT PANE: LIVE SEGMENT CARDS PREVIEW ========== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Cards List -->
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Segment Preview" FontSize="12.5" FontWeight="SemiBold" Foreground="#E7E9EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding SummaryBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Right" Text="Live Order: Tweet 1 to N" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Virtualized Preview List -->
                    <Border Grid.Row="1" Background="#161A22" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <!-- Empty State Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSegments, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="🧵" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.6"/>
                                <TextBlock Text="No tweet segments detected yet." FontSize="13.5" FontWeight="SemiBold" Foreground="#8D96A6" HorizontalAlignment="Center"/>
                                <TextBlock Text="Paste your thread text in the left pane to preview segments here." FontSize="11.5" Foreground="#6E7681" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Virtualized Tweet Cards -->
                            <ListView ItemsSource="{Binding Segments}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Visibility="{Binding HasSegments, Converter={StaticResource BoolToVis}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ThreadSegmentItem}">
                                        <Border Background="#202530" BorderBrush="#2F3644" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Card Top Row: Badge, Char Count, Remove Button -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#1D2E42" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding CharacterCount, StringFormat='{}{0} chars'}" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>

                                                    <!-- Delete Segment Button -->
                                                    <Button Grid.Column="3" Command="{Binding DataContext.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2" ToolTip="Exclude this tweet from import">
                                                        <TextBlock Text="🗑️" FontSize="12" Opacity="0.7"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Tweet Content Box (Editable) -->
                                                <Border Grid.Row="1" Background="#161A22" BorderBrush="#282F3B" BorderThickness="1" CornerRadius="4" Padding="4">
                                                    <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="12.5"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= 3. FOOTER ACTION BAR ================= -->
            <Border Grid.Row="2" Background="#181C23" BorderBrush="#252A34" BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ℹ️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8D96A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Cancel Button -->
                    <Button Grid.Column="1" Click="CloseButton_Click" Content="Cancel" Foreground="#8D96A6" Width="80" Height="34" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" BorderBrush="#3B4456" BorderThickness="1" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Primary Save Button -->
                    <Button Grid.Column="2" Command="{Binding SaveThreadCommand}" Height="34" Padding="16,0" Cursor="Hand" IsEnabled="{Binding HasSegments}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1D9BF0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="💾" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TotalSegmentsCount, StringFormat='{}Save {0} Tweets to Archive'}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#38BDF8"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#252A34"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
