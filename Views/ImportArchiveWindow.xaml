<Window x:Class="LocalSocialArchive.Views.ImportArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        mc:Ignorable="d"
        Title="Import Twitter / X Data" Height="620" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#0C1017"
        Foreground="#E7E9EA"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F3336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#1D9BF0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="txtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="#485363"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="#1D9BF0"/>
                                <Setter TargetName="txtBorder" Property="Background" Value="#1A222D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="24" Background="#0C1017">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Tab Selector -->
                <RowDefinition Height="*"/>    <!-- Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Progress / Status -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="#1D9BF0" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Import Twitter / X Posts" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0"/>
                        <TextBlock Text="Bulk import tweets and media without paying any API costs." FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 2. Mode Selector Pills -->
            <Border Grid.Row="1" Background="#161B22" CornerRadius="10" Padding="4" Margin="0,0,0,18" BorderBrush="#252A34" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding SelectTabCommand}" CommandParameter="Zip" Height="34" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pillBorder" CornerRadius="8" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xea83;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Official Archive (.zip / Folder)" FontSize="12.5" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsZipMode}" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#252F3F"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding SelectTabCommand}" CommandParameter="GalleryDl" Height="34" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="pillBorder" CornerRadius="8" Background="Transparent">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xeb05;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Public Profile (via gallery-dl)" FontSize="12.5" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsGalleryDlMode}" Value="True">
                                        <Setter TargetName="pillBorder" Property="Background" Value="#252F3F"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Tab Contents -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- ================= TAB 1: OFFICIAL ARCHIVE ================= -->
                    <StackPanel Visibility="{Binding IsZipMode, Converter={StaticResource BoolToVis}}">
                        <!-- File / Folder Path -->
                        <TextBlock Text="Select Archive (.zip) or Folder"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ArchiveZipPath, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            <Button Grid.Column="1" Command="{Binding BrowseZipFileCommand}" Margin="8,0,0,0" Padding="12,0" Height="38" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Browse Zip" VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" Padding="12,0" Height="38" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Folder..." VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Target Folder -->
                        <TextBlock Text="Save Into Folder Category"/>
                        <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,0,14"/>

                        <!-- Options -->
                        <CheckBox IsChecked="{Binding ImportLikes}" Margin="0,0,0,14" VerticalAlignment="Center">
                            <CheckBox.Content>
                                <TextBlock Text="Also import liked tweets from 'data/like.js'" Foreground="#E7E9EA" FontSize="12.5" FontWeight="Normal" Margin="6,0,0,0"/>
                            </CheckBox.Content>
                        </CheckBox>

                        <!-- Help box -->
                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="💡 How to get your official Twitter archive:" Foreground="#4CC2FF" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="1. Go to x.com &gt; Settings and privacy &gt; Your account &gt; Download an archive of your data.&#x0a;2. When X finishes preparing it, download the .zip file and select it above.&#x0a;3. All your tweets, threads, and media will be extracted directly into your offline vault." Foreground="#8B949E" FontSize="11.5" FontWeight="Normal" LineHeight="17" TextWrapping="Wrap" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================= TAB 2: GALLERY-DL ================= -->
                    <StackPanel Visibility="{Binding IsGalleryDlMode, Converter={StaticResource BoolToVis}}">
                        <!-- Profile URL / Handle -->
                        <TextBlock Text="Twitter/X Profile URL or Handle"/>
                        <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,0,0,14" ToolTip="e.g. @username or https://x.com/username"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Target Folder -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Target Folder Category"/>
                                <TextBox Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            </StackPanel>

                            <!-- Browser Cookies -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Browser Session (Cookies)"/>
                                <ComboBox ItemsSource="{Binding AvailableBrowserCookies}"
                                          SelectedItem="{Binding SelectedBrowserCookie}"
                                          Height="38"
                                          Style="{StaticResource UniversalDarkComboBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Max Tweets Limit -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Max Tweets to Download" Margin="0"/>
                                <TextBlock Text="Limits how many recent posts to fetch (default: 50)" FontSize="11.5" Foreground="#6E7681" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding MaxTweets, UpdateSourceTrigger=PropertyChanged}" Height="38" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <!-- gallery-dl Path -->
                        <TextBlock Text="gallery-dl Executable Path"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GalleryDlPath, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                            <Button Grid.Column="1" Command="{Binding BrowseGalleryDlPathCommand}" Margin="8,0,0,0" Padding="14,0" Height="38" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Browse..." VerticalAlignment="Center" FontSize="12"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Output Console if running -->
                        <Border Visibility="{Binding HasLogOutput, Converter={StaticResource BoolToVis}}" Background="#090D13" BorderBrush="#252A34" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding LogOutputText}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Progress Bar & Status Text -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <!-- Status Message / Result Alert -->
                <TextBlock Text="{Binding ProgressStatusText}" FontSize="12" Foreground="#8B949E" Margin="0,0,0,6"/>
                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6" Background="#161B22" Foreground="#1D9BF0" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                <Grid x:Name="PART_Track">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <TextBlock Text="{Binding ResultMessage}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E7E9EA"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessResult}" Value="True">
                                    <Setter Property="Foreground" Value="#7EE787"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSuccessResult}" Value="False">
                                    <Setter Property="Foreground" Value="#FFA198"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 5. Bottom Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding CancelCommand}" Content="Cancel" IsEnabled="{Binding IsImporting}" Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}" Height="38" Padding="16,0" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="CloseButton_Click" Content="Close" Height="38" Padding="18,0" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding StartImportCommand}" Height="38" Padding="22,0" Background="#1D9BF0" Foreground="#041224" FontWeight="Bold" FontSize="13" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xea9c;" FontFamily="{StaticResource CodiconFontFamily}" FontSize="13" Foreground="#041224" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Start Import" Foreground="#041224" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#4CC2FF"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#38444D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
