<Window x:Class="LocalSocialArchive.Views.SetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vault Security — Set Password"
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
        MouseDown="Window_MouseDown">

    <!-- Elevated Dark Container -->
    <Border Background="#0D1117" BorderBrush="#2F3336" BorderThickness="1.5" CornerRadius="18" Padding="28,24">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Form Fields -->
                <RowDefinition Height="Auto"/> <!-- Error Banner -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐 " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Vault Master Password" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Protect your tweets and media with offline cryptographic hashing." FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnCancel_Click" ToolTip="Close"
                        Width="28" Height="28" Background="Transparent" Foreground="#8B949E" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- 2. Form Fields -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12">
                <StackPanel>
                    <!-- Current Password (only visible if password already exists) -->
                    <StackPanel x:Name="CurrentPasswordPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock Text="CURRENT PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <PasswordBox x:Name="TxtCurrentPassword"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="14" CaretBrush="#1D9BF0"/>
                        </Border>
                    </StackPanel>

                    <!-- New Password -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="NEW PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <PasswordBox x:Name="TxtNewPassword"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="14" CaretBrush="#1D9BF0"/>
                        </Border>
                    </StackPanel>

                    <!-- Confirm New Password -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="CONFIRM NEW PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <Border Background="#161B22" BorderBrush="#2F3336" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <PasswordBox x:Name="TxtConfirmPassword"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="14" CaretBrush="#1D9BF0"/>
                        </Border>
                    </StackPanel>

                    <!-- Security Note -->
                    <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ Security Guarantee" FontSize="12" FontWeight="SemiBold" Foreground="#1D9BF0" Margin="0,0,0,3"/>
                            <TextBlock Text="Passwords are encrypted using 100,000 rounds of PBKDF2 SHA-256 with a unique cryptographic salt. It is stored 100% locally and never leaves your computer."
                                       FontSize="11.5" Foreground="#8B949E" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Error Banner -->
            <Border x:Name="ErrorBorder" Grid.Row="2" Background="#261A1A" BorderBrush="#5C2626" BorderThickness="1"
                    CornerRadius="8" Padding="10,6" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " FontSize="12" Foreground="#F87171" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtError" Text="Passwords do not match." FontSize="12" Foreground="#F87171" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 4. Action Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Remove Password (if set) -->
                <Button x:Name="BtnRemovePassword" Grid.Column="0" Click="BtnRemovePassword_Click"
                        Height="38" Padding="14,0" Background="#21262D" Foreground="#F87171"
                        FontSize="12.5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️ " FontSize="12"/>
                        <TextBlock Text="Remove Password"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="BtnCancel_Click"
                            Height="38" Padding="16,0" Background="Transparent" Foreground="#8B949E"
                            FontSize="12.5" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <TextBlock Text="Cancel"/>
                    </Button>

                    <Button Click="BtnSave_Click" IsDefault="True"
                            Height="38" Padding="20,0" Background="#1D9BF0" Foreground="#FFFFFF"
                            FontSize="13" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="Save Password"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
