<Window x:Class="LocalSocialArchive.Views.StoryDocumentReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalSocialArchive.ViewModels"
        xmlns:models="clr-namespace:LocalSocialArchive.Models"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        mc:Ignorable="d"
        Title="{Binding DocumentTitle, StringFormat='{}Document Reader — {0}'}"
        Width="980" Height="860" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        Foreground="#E7E9EA"
        FontFamily="Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
        <KeyBinding Key="Right" Command="{Binding NextPartCommand}"/>
        <KeyBinding Key="Left" Command="{Binding PreviousPartCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInFontCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutFontCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="10" Background="#0D1117" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Reading Canvas -->
                <RowDefinition Height="28"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. HEADER TOOLBAR ================= -->
            <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Button & Reader Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="Close_Click" ToolTip="Close (Esc)" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="10,5" Cursor="Hand" Margin="0,0,14,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" FontSize="13" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Back" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="28" Height="28" CornerRadius="7" Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="📖" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Story Document Reader" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center: Part Badge -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1A2D42" BorderBrush="#243C54" BorderThickness="1" CornerRadius="6" Padding="12,4">
                        <TextBlock Text="{Binding PartBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>

                    <!-- Right: Font Zoom & Caption Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Font Size Steppers -->
                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding ZoomOutFontCommand}" ToolTip="Decrease Font Size" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="A-" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding ZoomInFontCommand}" ToolTip="Increase Font Size" Background="Transparent" BorderThickness="0" Foreground="#C9D1D9" Width="26" Height="26" Cursor="Hand">
                                    <TextBlock Text="A+" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Click="Minimize_Click" ToolTip="Minimize" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Maximize_Click" ToolTip="Maximize / Restore" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="🗖" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="Close_Click" ToolTip="Close" Background="Transparent" BorderThickness="0" Foreground="#8B949E" Width="30" Height="28" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2. WORD-STYLE READING CANVAS ================= -->
            <ScrollViewer Grid.Row="1" x:Name="ReaderScrollViewer" Background="#191919" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,28">
                <StackPanel Width="820" HorizontalAlignment="Center">

                    <!-- Reading Document Page Sheet (Word Dark Mode #2B2B2B) -->
                    <Border Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="52,44" Margin="0,0,0,32">
                        <StackPanel>
                            <!-- Story Hero Header -->
                            <TextBlock Text="{Binding DocumentTitle}" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" LineHeight="36" Margin="0,0,0,16"/>

                            <!-- Author Profile & Part Badge Meta -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Author Avatar -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1D2E42" BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding AvatarInitial}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AuthorName}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="✓" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding AuthorHandle}" FontSize="12.5" Foreground="#8B949E" Margin="0,0,8,0"/>
                                        <TextBlock Text="•" FontSize="12" Foreground="#8B949E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PostDateText}" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#1A2D42" CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PartBadgeText}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </Grid>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="#262D38" Margin="0,0,0,28"/>

                            <!-- INLINE STORY STREAM (Text paragraphs and Inline Images in order) -->
                            <ItemsControl ItemsSource="{Binding CurrentPart.Blocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CanvasBlock}">
                                        <Grid Margin="0,0,0,20">
                                            <!-- Paragraph Text with Rich Emojis -->
                                            <emoji:TextBlock Visibility="{Binding IsParagraph, Converter={StaticResource BoolToVis}}"
                                                             Text="{Binding Text}"
                                                             FontSize="{Binding DataContext.ReaderFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Foreground="#E7E9EA"
                                                             TextWrapping="Wrap"
                                                             LineHeight="28"/>

                                            <!-- Inline Image (Remains exactly where it was inserted!) -->
                                            <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                    CornerRadius="10" ClipToBounds="True" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                                    MaxHeight="540" Margin="0,8,0,8">
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ThumbImageConverter}, ConverterParameter=1080}" Stretch="Uniform" MaxHeight="540"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ================= END OF PART PROGRESSION ACTION BAR ================= -->
                            <!-- (Requested Feature: at the end of the doc provide button to the next part) -->
                            <Border Margin="0,28,0,0" Padding="24,20" Background="#11161F" BorderBrush="#252A34" BorderThickness="1" CornerRadius="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Prompt if more parts exist -->
                                    <StackPanel Visibility="{Binding HasNextPart, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                                        <TextBlock Text="✦  END OF THIS PART  ✦" FontSize="12" FontWeight="Bold" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <Button Command="{Binding NextPartCommand}"
                                                Background="#1A2D42" BorderBrush="#38BDF8" BorderThickness="1.5" Foreground="#38BDF8"
                                                Padding="24,12" Cursor="Hand" Margin="0,0,0,8">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                                            </Button.Resources>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NextPartButtonText}" FontSize="14" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="Click to proceed seamlessly to the next part of this story." FontSize="11" Foreground="#6E7681" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- If this is the last part -->
                                    <StackPanel Visibility="{Binding HasNextPart, Converter={StaticResource InverseBoolToVis}}" HorizontalAlignment="Center">
                                        <TextBlock Text="✦  END OF STORY DOCUMENT  ✦" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                        <TextBlock Text="You have reached the end of all parts in this story." FontSize="12" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding JumpToFirstPartCommand}" Visibility="{Binding HasPreviousPart, Converter={StaticResource BoolToVis}}"
                                                    Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="14,8" Cursor="Hand" Margin="0,0,10,0">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                </Button.Resources>
                                                <TextBlock Text="⏮ Back to Part 1" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>

                                            <Button Click="Close_Click" Background="#21262D" BorderBrush="#30363D" BorderThickness="1" Foreground="#C9D1D9" Padding="14,8" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                                </Button.Resources>
                                                <TextBlock Text="Close Reader" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 3. STATUS BAR ================= -->
            <Border Grid.Row="2" Background="#0A0D12" BorderBrush="#1F242C" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PartBadgeText, StringFormat='Reading: {0}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Shortcuts: Esc to exit • ◀ / ▶ to change parts • Ctrl++ / Ctrl+- to zoom" FontSize="11" Foreground="#6E7681" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
